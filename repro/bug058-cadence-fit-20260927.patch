diff --git a/scripts/build_cadence_imports.py b/scripts/build_cadence_imports.py
new file mode 100644
index 0000000..4c35aab
--- /dev/null
+++ b/scripts/build_cadence_imports.py
@@ -0,0 +1,22 @@
+"""Resolve isolated page-$34 cadence helper imports and verify fixed entries."""
+from pathlib import Path
+import re,sys
+
+def symbols(path):
+ return {name:int(value,16) for name,value in re.findall(r"^Symbol: (\S+) .* = ([0-9A-Fa-f]+)$",Path(path).read_text(),re.M)}
+if len(sys.argv)>1 and sys.argv[1]=='--verify':
+ main,enemy,helper,code=map(Path,sys.argv[2:6]);ms=symbols(main);es=symbols(enemy);hs=symbols(helper)
+ for name,expected in [('cadence_publish',0xBC50),('cadence_reset',0xBCA4),('cadence_plan',0xBCB7)]:
+  assert hs[name]==es[name]==expected,(name,hs.get(name),es.get(name))
+ assert ms['cadence_slot_selected']==es['cadence_slot_selected']==0xFDE0
+ assert len(code.read_bytes())==hs['cadence_end']-hs['cadence_publish']<=942
+ assert hs['cadence_end']<=0xBFFE
+ print('cadence fit: helper %d/942; entries and resident slot exact'%len(code.read_bytes()))
+else:
+ main,enemy,out=map(Path,sys.argv[1:4]);merged=symbols(main);merged.update(symbols(enemy))
+ source=(main.parent.parent/'src/cadence_runtime.s').read_text()
+ code='\n'.join(line.split(';',1)[0] for line in source.splitlines())
+ needed=set(re.findall(r'\b[A-Za-z_][A-Za-z_0-9]*\b',code))
+ merged={k:v for k,v in merged.items() if k in needed and not k.startswith('cadence_') and not k.startswith('CAD_')}
+ out.write_text(''.join(f'{k} equ ${v:04X}\n' for k,v in sorted(merged.items())))
+ print('cadence imports:',len(merged),'referenced symbols')
