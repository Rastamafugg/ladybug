+class ConditionalExternalTests(unittest.TestCase):
+    symbol = 'PRES_MAIN_JOY_AXIS'
+
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        for name in ('src', 'scripts', 'assets', 'tiled', 'build'):
+            (self.root / name).mkdir()
+
+    def reference(self, *, active=False, imported=False, authored_call=True,
+                  external=(), conditional=None, ownership_audit=True,
+                  listing_mode='present'):
+        conditional = [self.symbol] if conditional is None else list(conditional)
+        lines = []
+        if imported:
+            lines.append('        include "keybinding-imports.inc"')
+        lines.append('        ifne INPUT_JOYSTICK')
+        call_line = len(lines) + 1
+        if authored_call:
+            lines.append('        jsr ' + self.symbol)
+        lines.extend(('        endc', 'key_scan', '        rts'))
+        source = self.root / 'src/keybinding_runtime.s'
+        source.write_text('\n'.join(lines) + '\n', encoding='utf-8')
+        build = self.root / 'build'
+        if imported:
+            (build / 'keybinding-imports.inc').write_text(
+                self.symbol + ' equ $C100\n', encoding='utf-8'
+            )
+
+        listing = build / 'keybinding-runtime.lst'
+        return_line = len(lines)
+        emitted = []
+        address = 0xBA00
+        if active:
+            emitted.append(
+                f'BA00 BDC100 (src/keybinding_runtime.s):{call_line:05d} '
+                f'        jsr {self.symbol}'
+            )
+            address += 3
+        if listing_mode != 'missing':
+            if listing_mode == 'empty':
+                listing.write_text('', encoding='utf-8')
+            else:
+                emitted.append(
+                    f'{address:04X} 39 (src/keybinding_runtime.s):{return_line:05d} '
+                    '        rts'
+                )
+                listing.write_text('\n'.join(emitted) + '\n', encoding='utf-8')
+
+        map_file = build / 'keybinding-runtime.map'
+        map_file.write_text(
+            f'Symbol: key_scan (keybinding-runtime.bin) = {address:04X}\n', encoding='utf-8'
+        )
+        binary = build / 'keybinding-runtime.bin'
+        binary.write_bytes(b'\xBD\xC1\x00\x39' if active else b'\x39')
+        artifacts = {
+            'keybinding-runtime.bin': digest(binary),
+            'keybinding-runtime.map': digest(map_file),
+        }
+        invocation = {
+            'source': 'src/keybinding_runtime.s',
+            'output': 'keybinding-runtime.bin',
+            'listing': 'keybinding-runtime.lst',
+            'map': 'keybinding-runtime.map',
+        }
+        generated_inputs = {}
+        if listing_mode != 'missing':
+            artifacts['keybinding-runtime.lst'] = digest(listing)
+        if imported:
+            alias = build / 'keybinding-imports.inc'
+            generated_inputs['build/keybinding-imports.inc'] = digest(alias)
+            artifacts['keybinding-imports.inc'] = digest(alias)
+        receipt = {
+            'schema': 1,
+            'state': 'complete',
+            'profile': 'complete',
+            'revision': 'conditional-external-fixture',
+            'inputs': inputs(self.root),
+            'artifacts': artifacts,
+            'generated_inputs': generated_inputs,
+            'invocations': [invocation],
+        }
+        (build / 'source-build-receipt.json').write_text(
+            json.dumps(receipt), encoding='utf-8'
+        )
+
+        module = {
+            'id': 'keybinding-runtime',
+            'title': 'Keybinding fixture',
+            'source': 'src/keybinding_runtime.s',
+            'listing': 'keybinding-runtime.lst',
+            'map': 'keybinding-runtime.map',
+            'binary': 'keybinding-runtime.bin',
+            'external_symbols': list(external),
+            'conditional_external_symbols': conditional,
+        }
+        config = {
+            'title': 'Conditional external fixture',
+            'revision': 'fixture',
+            'modules': [module],
+        }
+        if ownership_audit:
+            config['ownership_audit'] = {'required': []}
+        return build_project_reference(config, self.root, build)
+
+    def test_keyboard_inactive_conditional_call_needs_no_import(self):
+        project = self.reference(active=False, imported=False)
+        self.assertFalse(any(call.target == self.symbol for call in project.modules[0].calls))
+
+    def test_joystick_active_conditional_call_requires_and_accepts_import(self):
+        project = self.reference(active=True, imported=True)
+        self.assertTrue(any(call.target == self.symbol for call in project.modules[0].calls))
+
+    def test_active_call_without_import_fails_unknown_target(self):
+        with self.assertRaisesRegex(
+            ValueError, 'external call targets lack project-authored/imported labels'
+        ):
+            self.reference(active=True, imported=False)
+
+    def test_old_unconditional_declaration_rejects_inactive_call(self):
+        with self.assertRaisesRegex(
+            ValueError, 'external call targets lack project-authored/imported labels'
+        ):
+            self.reference(active=False, imported=False, external=[self.symbol], conditional=[])
+
+    def test_unknown_unconditional_external_still_fails(self):
+        with self.assertRaisesRegex(
+            ValueError, 'external call targets lack project-authored/imported labels'
+        ):
+            self.reference(active=False, imported=False, external=['UNKNOWN_TARGET'], conditional=[])
+
+    def test_conditional_external_must_name_an_authored_call(self):
+        with self.assertRaisesRegex(ValueError, 'lack authored call targets'):
+            self.reference(active=False, imported=False, authored_call=False)
+
+    def test_conditional_declarations_reject_duplicates_and_overlap(self):
+        with self.assertRaisesRegex(ValueError, 'duplicate external symbol declaration'):
+            self.reference(conditional=[self.symbol, self.symbol])
+        with self.assertRaisesRegex(ValueError, 'both unconditional and conditional'):
+            self.reference(external=[self.symbol])
+
+    def test_conditional_external_rejects_unvalidated_receipt(self):
+        with self.assertRaisesRegex(ValueError, 'validated ownership-audit receipt'):
+            self.reference(ownership_audit=False)
+
+    def test_conditional_external_rejects_missing_and_empty_listing(self):
+        with self.assertRaises(ValueError):
+            self.reference(listing_mode='missing')
+        with self.assertRaises(ValueError):
+            self.reference(listing_mode='empty')
