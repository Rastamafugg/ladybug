+INSTRUCTION_LAYOUT_MASK = [(x, 7) for x in range(1, 7)] + [(34, 13)]
+INSTRUCTION_LAYOUT_MASK_SHA256 = (
+    "806331bf3d6f8b129bc6adfb919d3d0f20410e7c08f2d553ff4e273de508e62e"
