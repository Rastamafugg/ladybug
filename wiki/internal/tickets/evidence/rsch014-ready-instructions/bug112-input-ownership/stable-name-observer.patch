+def stable_name_scan(index, bit):
+ key_map=symbols(B/'ladybug-keybinding-runtime.map')
+ address=key_map['ks_done']
+ module=(B/'ladybug-keybinding-runtime.bin').read_bytes()
+ expected_bindings=(58,26,8,32)
+ binding_check='' if index is None else f' && *(unsigned char*)0x{0x287+index:x}=={expected_bindings[index]}'
+ condition=(
+  '*(unsigned char*)0xffa5==0x3d && '
+  '*(unsigned char*)0xa5==8 && *(unsigned char*)0xa6==5 && '
+  '*(unsigned char*)0x298==0'+binding_check+
+  f' && *(unsigned char*)0x0296=={bit}'
+ )
+ output=gdb([f'break *0x{address:x}',f'condition 1 {condition}','continue','delete breakpoints',
+  f'dump binary memory {O}/name-live-key-module.bin 0xba00 0xbe90',
+  f'dump binary memory {O}/name-stable-dp.bin 0x0000 0x029b',
+  'printf "BUG112_STABLE_KS_DONE pc=%04x\\n", $pc'])
+ live=(O/'name-live-key-module.bin').read_bytes()
+ check('live page-$3D input module matches full current artifact before state decode',live==module)
+ marker=re.search(r'BUG112_STABLE_KS_DONE pc=([0-9a-fA-F]{4})',output)
+ check('stable ks_done program counter matches emitted marker',marker is not None and int(marker.group(1),16)==address)
+ dp=(O/'name-stable-dp.bin').read_bytes()
+ state={'mode':dp[0xa5],'screen':dp[0xa6],'bindings':list(dp[0x287:0x28c]),
+        'mapped_down':dp[0x296],'binding_state':dp[0x298],
+        'player_cell':[dp[9],dp[10]],'player_want':dp[5]}
+ check('stable ks_done is name mode/screen with capture inactive',state['mode']==8 and state['screen']==5 and state['binding_state']==0)
+ if index is not None:
+  check('name binding '+str(index)+' contains assigned physical key',state['bindings'][index]==expected_bindings[index])
+ check('stable ks_done observes mapped bit '+str(bit),state['mapped_down']==bit)
+ report['phases'][-1]['stable_ks_done_sample']=state
+ report['phases'][-1]['stable_ks_done_address']=address
+ report['phases'][-1]['live_key_module_sha256']=hashlib.sha256(live).hexdigest()
+
