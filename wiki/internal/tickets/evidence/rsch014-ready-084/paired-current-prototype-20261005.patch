+        lda     INITIAL_ENTRY_STATE
+        cmpa    #ENTRY_WALKOUT
+        blo     pew_store
+        cmpa    #ENTRY_OFFSCREEN
+        bhi     pew_store
+        ldb     #160
+        subb    PLAYER_FB+1
+        bcs     pew_zero
+        cmpb    #8
+        bls     pew_store
+        ldb     #8
+pew_store
+        stb     PLAYER_DX
+        rts
+pew_zero
+        clrb
+        bra     pew_store
+
+        else
@@ -2999,0 +3100,2 @@ pvr_zero
+        endc
