                      (rc/demo_runtime.s):00146         
                      (rc/demo_runtime.s):00147                 ifne    HIGHSCORE_PHASE_HELPER
                      (rc/demo_runtime.s):00148         
                      (rc/demo_runtime.s):00149         ; Page-$24 high-score helper.  It remains mapped only while the low-RAM
                      (rc/demo_runtime.s):00150         ; high-score owner calls it.  All calls that may change PAR5 return through
                      (rc/demo_runtime.s):00151         ; presentation_page24_resume in resident code.
0000                  (rc/demo_runtime.s):00152         SND_DATA equ $FF51
                      (rc/demo_runtime.s):00153         
                      (rc/demo_runtime.s):00154                 org     HIGHSCORE_PHASE_HELPER_ADDRESS
                      (rc/demo_runtime.s):00155         
0000                  (rc/demo_runtime.s):00156         highscore_phase_tick
                      (rc/demo_runtime.s):00157                 lda     PRES_MODE
                      (rc/demo_runtime.s):00158                 cmpa    #MODE_GAMEOVER
                      (rc/demo_runtime.s):00159                 lbeq    highscore_gameover_tick
                      (rc/demo_runtime.s):00160                 tst     PRES_NAME_FLAGS
                      (rc/demo_runtime.s):00161                 lbne    highscore_commit_done
                      (rc/demo_runtime.s):00162                 lda     PRES_TICK_PHASE
                      (rc/demo_runtime.s):00163                 lbmi    highscore_timer_owner
                      (rc/demo_runtime.s):00164                 tsta
                      (rc/demo_runtime.s):00165                 beq     highscore_timer_frame
                      (rc/demo_runtime.s):00166                 dec     PRES_TICK_PHASE
                      (rc/demo_runtime.s):00167                 lda     PRES_TICK_PHASE
                      (rc/demo_runtime.s):00168                 cmpa    #2
                      (rc/demo_runtime.s):00169                 lbeq    highscore_tick_second
                      (rc/demo_runtime.s):00170                 tsta
                      (rc/demo_runtime.s):00171                 bne     highscore_timer_frame
                      (rc/demo_runtime.s):00172                 lda     #$9F
                      (rc/demo_runtime.s):00173                 sta     SND_DATA
0000                  (rc/demo_runtime.s):00174         highscore_timer_frame
                      (rc/demo_runtime.s):00175                 inc     PRES_NAME_TIMER_PHASE
                      (rc/demo_runtime.s):00176                 lda     PRES_NAME_TIMER_PHASE
                      (rc/demo_runtime.s):00177                 cmpa    #PRESENTATION_NAME_ENTRY_TIMER_FRAMES
                      (rc/demo_runtime.s):00178                 lblo    highscore_phase_hold
                      (rc/demo_runtime.s):00179                 clr     PRES_NAME_TIMER_PHASE
                      (rc/demo_runtime.s):00180                 lda     PRES_NAME_TIMER_BOX
                      (rc/demo_runtime.s):00181                 cmpa    #PRESENTATION_NAME_ENTRY_TIMER_COUNT
                      (rc/demo_runtime.s):00182                 lbhs    highscore_commit_done
                      (rc/demo_runtime.s):00183                 lda     #$80
                      (rc/demo_runtime.s):00184                 sta     PRES_TICK_PHASE
0000                  (rc/demo_runtime.s):00185         highscore_timer_prepare
                      (rc/demo_runtime.s):00186                 lda     PRES_NAME_TIMER_BOX
                      (rc/demo_runtime.s):00187                 sta     PRES_TMP_H
                      (rc/demo_runtime.s):00188                 ldd     #highscore_after_prepare
                      (rc/demo_runtime.s):00189                 std     PRES_NAME_PTR
                      (rc/demo_runtime.s):00190                 ldd     #PRES_MAIN_PAGE24_RESUME
                      (rc/demo_runtime.s):00191                 pshs    d
                      (rc/demo_runtime.s):00192                 jmp     PRES_MAIN_FB_PREPARE
                      (rc/demo_runtime.s):00193         
0000                  (rc/demo_runtime.s):00194         highscore_after_prepare
0000                  (rc/demo_runtime.s):00195         highscore_timer_draw
                      (rc/demo_runtime.s):00196                 lda     PRES_TMP_H
                      (rc/demo_runtime.s):00197                 ldb     #PRESENTATION_NAME_ENTRY_TIMER_RECORD_BYTES
                      (rc/demo_runtime.s):00198                 mul
                      (rc/demo_runtime.s):00199                 ldx     #highscore_timer_records
                      (rc/demo_runtime.s):00200                 leax    d,x
                      (rc/demo_runtime.s):00201                 ldd     ,x
                      (rc/demo_runtime.s):00202                 tfr     d,y
                      (rc/demo_runtime.s):00203                 ldb     3,x
                      (rc/demo_runtime.s):00204                 ldd     #highscore_after_tile
                      (rc/demo_runtime.s):00205                 std     PRES_NAME_PTR
                      (rc/demo_runtime.s):00206                 ldd     #PRES_MAIN_PAGE24_RESUME
                      (rc/demo_runtime.s):00207                 pshs    d
                      (rc/demo_runtime.s):00208                 jmp     PRES_MODULE_DRAW_TILE
                      (rc/demo_runtime.s):00209         
                      (rc/demo_runtime.s):00210         ; Raw lwasm output concatenates discontinuous ORG regions instead of emitting
                      (rc/demo_runtime.s):00211         ; their address gap.  Materialize this reserved continuation window so every
                      (rc/demo_runtime.s):00212         ; absolute helper label retains the same file offset after loading at $AC40.
0000                  (rc/demo_runtime.s):00213         highscore_phase_helper_gap
                      (rc/demo_runtime.s):00214                 rmb     HIGHSCORE_PHASE_HELPER_RESUME-*
0000                  (rc/demo_runtime.s):00215         highscore_after_tile
                      (rc/demo_runtime.s):00216                 clra
                      (rc/demo_runtime.s):00217                 rts
                      (rc/demo_runtime.s):00218         
                      (rc/demo_runtime.s):00219         ; A timer tile is persistent state.  Apply it to the current BACK, allow the
                      (rc/demo_runtime.s):00220         ; low-RAM name renderer to close and publish every dynamic layer, wait for the
                      (rc/demo_runtime.s):00221         ; IRQ owner swap, then repeat the same one-tile transaction for the other
                      (rc/demo_runtime.s):00222         ; owner.  $80 is first-owner published; $81 is second-owner published.
0000                  (rc/demo_runtime.s):00223         highscore_timer_owner
                      (rc/demo_runtime.s):00224                 inc     PRES_NAME_TIMER_PHASE
                      (rc/demo_runtime.s):00225                 tst     FB_PENDING
                      (rc/demo_runtime.s):00226                 bne     highscore_phase_busy
                      (rc/demo_runtime.s):00227                 cmpa    #$80
                      (rc/demo_runtime.s):00228                 bne     highscore_timer_complete
                      (rc/demo_runtime.s):00229                 inc     PRES_TICK_PHASE
                      (rc/demo_runtime.s):00230                 lbra    highscore_timer_prepare
0000                  (rc/demo_runtime.s):00231         highscore_timer_complete
                      (rc/demo_runtime.s):00232                 inc     PRES_NAME_TIMER_BOX
                      (rc/demo_runtime.s):00233                 lda     #4
                      (rc/demo_runtime.s):00234                 sta     PRES_TICK_PHASE
                      (rc/demo_runtime.s):00235                 lda     #$86
                      (rc/demo_runtime.s):00236                 sta     SND_DATA
                      (rc/demo_runtime.s):00237                 lda     #$35
                      (rc/demo_runtime.s):00238                 sta     SND_DATA
                      (rc/demo_runtime.s):00239                 lda     #$91
                      (rc/demo_runtime.s):00240                 sta     SND_DATA
                      (rc/demo_runtime.s):00241                 lda     PRES_NAME_TIMER_BOX
                      (rc/demo_runtime.s):00242                 cmpa    #PRESENTATION_NAME_ENTRY_TIMER_COUNT
                      (rc/demo_runtime.s):00243                 bhs     highscore_commit_done
0000                  (rc/demo_runtime.s):00244         highscore_phase_hold
                      (rc/demo_runtime.s):00245                 clra
                      (rc/demo_runtime.s):00246                 rts
0000                  (rc/demo_runtime.s):00247         highscore_phase_busy
                      (rc/demo_runtime.s):00248                 lda     #1
                      (rc/demo_runtime.s):00249                 rts
                      (rc/demo_runtime.s):00250         
0000                  (rc/demo_runtime.s):00251         highscore_tick_second
                      (rc/demo_runtime.s):00252                 lda     #$8A
                      (rc/demo_runtime.s):00253                 sta     SND_DATA
                      (rc/demo_runtime.s):00254                 lda     #$23
                      (rc/demo_runtime.s):00255                 sta     SND_DATA
                      (rc/demo_runtime.s):00256                 lda     #$92
                      (rc/demo_runtime.s):00257                 sta     SND_DATA
                      (rc/demo_runtime.s):00258                 lbra    highscore_timer_frame
                      (rc/demo_runtime.s):00259         
0000                  (rc/demo_runtime.s):00260         highscore_commit_done
                      (rc/demo_runtime.s):00261                 lbsr    highscore_commit_name
                      (rc/demo_runtime.s):00262                 ldd     #highscore_after_highscore_start
                      (rc/demo_runtime.s):00263                 std     PRES_NAME_PTR
                      (rc/demo_runtime.s):00264                 ldd     #PRES_MAIN_PAGE24_RESUME
                      (rc/demo_runtime.s):00265                 pshs    d
                      (rc/demo_runtime.s):00266                 lda     #MAP_HIGH_SCORE
                      (rc/demo_runtime.s):00267                 jmp     PRES_MODULE_START_SCREEN
0000                  (rc/demo_runtime.s):00268         highscore_after_highscore_start
                      (rc/demo_runtime.s):00269                 lda     #1
                      (rc/demo_runtime.s):00270                 rts
                      (rc/demo_runtime.s):00271         
0000                  (rc/demo_runtime.s):00272         highscore_gameover_tick
                      (rc/demo_runtime.s):00273                 ldd     PRES_TIMER
                      (rc/demo_runtime.s):00274                 addd    #1
                      (rc/demo_runtime.s):00275                 std     PRES_TIMER
                      (rc/demo_runtime.s):00276                 cmpd    #180
                      (rc/demo_runtime.s):00277                 blo     highscore_phase_hold
                      (rc/demo_runtime.s):00278                 lbsr    highscore_prepare_name
                      (rc/demo_runtime.s):00279                 ldd     #highscore_after_name_start
                      (rc/demo_runtime.s):00280                 std     PRES_NAME_PTR
                      (rc/demo_runtime.s):00281                 ldd     #PRES_MAIN_PAGE24_RESUME
                      (rc/demo_runtime.s):00282                 pshs    d
                      (rc/demo_runtime.s):00283                 lda     #MAP_ENTER_HIGH_SCORE
                      (rc/demo_runtime.s):00284                 jmp     PRES_MODULE_START_SCREEN
0000                  (rc/demo_runtime.s):00285         highscore_after_name_start
                      (rc/demo_runtime.s):00286                 lda     #1
                      (rc/demo_runtime.s):00287                 rts
                      (rc/demo_runtime.s):00288         
0000                  (rc/demo_runtime.s):00289         highscore_prepare_name
                      (rc/demo_runtime.s):00290                 pshs    cc
                      (rc/demo_runtime.s):00291                 orcc    #$10
                      (rc/demo_runtime.s):00292                 lda     PAR4
                      (rc/demo_runtime.s):00293                 pshs    a
                      (rc/demo_runtime.s):00294                 lda     #$34
