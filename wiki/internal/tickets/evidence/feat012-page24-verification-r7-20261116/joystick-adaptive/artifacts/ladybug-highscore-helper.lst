                      (ed_text_stage.inc):00186         ; The reserved continuation interval ends at $AD00. This logo clock occupies
                      (ed_text_stage.inc):00187         ; its fitted 80-byte range without changing the mapped owner or return path.
                      (ed_text_stage.inc):00188         ; Raw lwasm concatenates ORG regions, so retain zero padding before the fixed
                      (ed_text_stage.inc):00189         ; continuation label after the clock.
                      (ed_text_stage.inc):00190         ; Retain elapsed VBLANK time independently of PRES_TIMER, which also drives
                      (ed_text_stage.inc):00191         ; high-score text. $A8FD-$A8FF is the reserved three-byte logo-clock slot.
