                      (ruction_runtime.s):00004         ; BUG-011 development instruction choreography.  The GMC loader stages this
                      (ruction_runtime.s):00005         ; image behind the attract bundle in physical page $24; presentation startup
                      (ruction_runtime.s):00006         ; copies it into boot-only RAM.
                      (ruction_runtime.s):00007         ; DOC-002 source-contract mirror begins. Canonical definitions:
                      (ruction_runtime.s):00008         ; wiki/internal/implementation/routine-catalog.html
                      (ruction_runtime.s):00009         ; DOC-002 source-contract mirror profile copy Inputs: Source and destination identities, bounded count or stream metadata, and any required mapped page
                      (ruction_runtime.s):00010         ; DOC-002 source-contract mirror profile copy Outputs: Copied, decoded, merged, cached, or addressed data plus caller-visible pointer progress
                      (ruction_runtime.s):00011         ; DOC-002 source-contract mirror profile copy Clobbers: A, B, D, X, Y, U, and condition codes unless a narrower source-local header is present
                      (ruction_runtime.s):00012         ; DOC-002 source-contract mirror profile copy Reads: The declared source stream, table, framebuffer rows, or metadata record
                      (ruction_runtime.s):00013         ; DOC-002 source-contract mirror profile copy Writes: Only the declared bounded destination record, cache, row range, or scratch fields
                      (ruction_runtime.s):00014         ; DOC-002 source-contract mirror profile copy Side effects: May temporarily map a required GIME page while moving or decoding data
                      (ruction_runtime.s):00015         ; DOC-002 source-contract mirror profile copy Invariants: Counts and destination bounds are honored; any temporary GIME mapping is restored before returning unless the routine contract explicitly states otherwise
                      (ruction_runtime.s):00016         ; DOC-002 source-contract mirror profile presentation Inputs: Presentation state, interval timer, input edges, current map, and the selected auxiliary profile
                      (ruction_runtime.s):00017         ; DOC-002 source-contract mirror profile presentation Outputs: Updated presentation state and the dispatcher retain/release status when applicable
                      (ruction_runtime.s):00018         ; DOC-002 source-contract mirror profile presentation Clobbers: A, B, D, X, Y, U, and condition codes unless a narrower source-local header is present
                      (ruction_runtime.s):00019         ; DOC-002 source-contract mirror profile presentation Reads: Presentation direct-page state, cold payloads, authored map streams, and input state
                      (ruction_runtime.s):00020         ; DOC-002 source-contract mirror profile presentation Writes: Presentation state, mapped BACK pixels, and presentation-owned persistent metadata
                      (ruction_runtime.s):00021         ; DOC-002 source-contract mirror profile presentation Side effects: May retain the foreground interval or produce a complete presentation surface
                      (ruction_runtime.s):00022         ; DOC-002 source-contract mirror profile presentation Invariants: Gameplay simulation begins only after release; hidden hydration may prepare initial-stage state and hold it unchanged until release; FRONT publication remains IRQ-owned
                      (ruction_runtime.s):00023         ; DOC-002 source-contract mirror profile render Inputs: Current render intent, selected actor or tile state, and a valid BACK or staging destination
                      (ruction_runtime.s):00024         ; DOC-002 source-contract mirror profile render Outputs: Updated destination pixels and any owner-local history required by later restoration
                      (ruction_runtime.s):00025         ; DOC-002 source-contract mirror profile render Clobbers: A, B, D, X, Y, U, and condition codes unless a narrower source-local header is present
                      (ruction_runtime.s):00026         ; DOC-002 source-contract mirror profile render Reads: Authoritative gameplay state, immutable art streams, and current owner-local background metadata
                      (ruction_runtime.s):00027         ; DOC-002 source-contract mirror profile render Writes: BACK or staging pixels, render scratch, and owner-local save-under or damage metadata
                      (ruction_runtime.s):00028         ; DOC-002 source-contract mirror profile render Side effects: Changes a non-visible composition surface or its metadata
                      (ruction_runtime.s):00029         ; DOC-002 source-contract mirror profile render Invariants: The routine never selects the visible FRONT surface; temporary PAR5 mappings expire or restore before return
                      (ruction_runtime.s):00030         ; DOC-002 source-contract mirror contract apply_persistent_state profile=presentation: Apply persistent state.
                      (ruction_runtime.s):00031         ; DOC-002 source-contract mirror contract clear_target profile=render: Clear target.
                      (ruction_runtime.s):00032         ; DOC-002 source-contract mirror contract clear_target_x profile=render: Clear target x.
                      (ruction_runtime.s):00033         ; DOC-002 source-contract mirror contract draw_coin_reward profile=render: Draw coin reward.
                      (ruction_runtime.s):00034         ; DOC-002 source-contract mirror contract draw_life_reward profile=render: Draw life reward.
                      (ruction_runtime.s):00035         ; DOC-002 source-contract mirror contract draw_multiplier_pair profile=render: Draw multiplier pair.
                      (ruction_runtime.s):00036         ; DOC-002 source-contract mirror contract draw_multipliers profile=render: Draw multipliers.
                      (ruction_runtime.s):00037         ; DOC-002 source-contract mirror contract draw_value profile=render: Draw value.
                      (ruction_runtime.s):00038         ; DOC-002 source-contract mirror contract event_ptr_a profile=copy: Resolve the current development instruction event record into an address.
                      (ruction_runtime.s):00039         ; DOC-002 source-contract mirror contract instruction_runtime_tick profile=presentation: Advance the development instruction choreography and its persistent state.
                      (ruction_runtime.s):00040         ; DOC-002 source-contract mirror contract present_death profile=presentation: Apply the development instruction death-presentation event.
                      (ruction_runtime.s):00041         ; DOC-002 source-contract mirror contract present_player profile=presentation: Apply the development instruction player-presentation event.
                      (ruction_runtime.s):00042         ; DOC-002 source-contract mirror contract recolour_collectibles profile=render: Recolour collectibles.
                      (ruction_runtime.s):00043         ; DOC-002 source-contract mirror contract recolour_target profile=render: Recolour target.
                      (ruction_runtime.s):00044         ; DOC-002 source-contract mirror contract restore_actor profile=render: Restore actor.
                      (ruction_runtime.s):00045         ; DOC-002 source-contract mirror contract store_owner_state profile=presentation: Store owner state.
                      (ruction_runtime.s):00046         ; DOC-002 source-contract mirror contract sync_persistent_state profile=presentation: Synchronize persistent state.
                      (ruction_runtime.s):00047         ; DOC-002 source-contract mirror ends.
