                      (adybug/src/main.s):04677         ; blit_tile — copy an 8x8 tile to a framebuffer byte address.
                      (adybug/src/main.s):04678         ;
                      (adybug/src/main.s):04679         ; Inputs:
                      (adybug/src/main.s):04680         ;   X — destination framebuffer byte address
                      (adybug/src/main.s):04681         ;   Y — source glyph data, 32 packed 4bpp bytes
                      (adybug/src/main.s):04682         ;
                      (adybug/src/main.s):04683         ; Returns:
                      (adybug/src/main.s):04684         ;   A, B, D, X, Y, U, CC — undefined
                      (adybug/src/main.s):04685         ;
                      (adybug/src/main.s):04686         ; Side effects:
                      (adybug/src/main.s):04687         ;   Writes 8 rows x 4 bytes; advances 156 bytes after each written row.
                      (adybug/src/main.s):04688         ;==============================================================================
D5CB                  (adybug/src/main.s):04689         blit_tile
                      (adybug/src/main.s):04690                 ; ldd ,y++ clobbers B, so use a Y-vs-sentinel loop instead of decb.
                      (adybug/src/main.s):04691                 ; See wiki/internal/implementation/lessons-learned.html
                      (adybug/src/main.s):04692                 ; §"LDD ,Y++ clobbers B".
D5CB 3440             (adybug/src/main.s):04693                 pshs    u
D5CD 33A820           (adybug/src/main.s):04694                 leau    32,y            ; sentinel = end of tile data
