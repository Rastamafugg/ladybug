                      (adybug/src/main.s):04712         ;   X — destination framebuffer byte address
                      (adybug/src/main.s):04713         ;   Y — packed 4bpp source data; colour 0 is transparent
                      (adybug/src/main.s):04714         ;
                      (adybug/src/main.s):04715         ; Returns: A, B, X, Y, CC undefined
                      (adybug/src/main.s):04716         ; Side effects: blends the requested rectangle into the framebuffer.
