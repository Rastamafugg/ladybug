                      (adybug/src/main.s):04707         ; blit_transparent — overlay nonzero packed nibbles from a rectangle.
                      (adybug/src/main.s):04708         ;
                      (adybug/src/main.s):04709         ; Inputs:
                      (adybug/src/main.s):04710         ;   A — source row count
