                      (c/enemy_runtime.s):00001         ; GMC bank-3 enemy runtime, copied to low RAM $0800 during boot.
                      (c/enemy_runtime.s):00002         ; Entry table offsets are part of the resident/runtime contract.
                      (c/enemy_runtime.s):00003         ; DOC-002 source-contract mirror begins. Canonical definitions:
                      (c/enemy_runtime.s):00004         ; wiki/internal/implementation/routine-catalog.html
                      (c/enemy_runtime.s):00005         ; DOC-002 source-contract mirror profile copy Inputs: Source and destination identities, bounded count or stream metadata, and any required mapped page
                      (c/enemy_runtime.s):00006         ; DOC-002 source-contract mirror profile copy Outputs: Copied, decoded, merged, cached, or addressed data plus caller-visible pointer progress
                      (c/enemy_runtime.s):00007         ; DOC-002 source-contract mirror profile copy Clobbers: A, B, D, X, Y, U, and condition codes unless a narrower source-local header is present
                      (c/enemy_runtime.s):00008         ; DOC-002 source-contract mirror profile copy Reads: The declared source stream, table, framebuffer rows, or metadata record
                      (c/enemy_runtime.s):00009         ; DOC-002 source-contract mirror profile copy Writes: Only the declared bounded destination record, cache, row range, or scratch fields
                      (c/enemy_runtime.s):00010         ; DOC-002 source-contract mirror profile copy Side effects: May temporarily map PAR5 while moving or decoding data
                      (c/enemy_runtime.s):00011         ; DOC-002 source-contract mirror profile copy Invariants: Counts and destination bounds are honored; temporary mappings are restored before returning
                      (c/enemy_runtime.s):00012         ; DOC-002 source-contract mirror profile framebuffer Inputs: ACTIVE/PENDING state, BACK identity, owner metadata, and the current worklist
                      (c/enemy_runtime.s):00013         ; DOC-002 source-contract mirror profile framebuffer Outputs: A prepared, captured, finished, or published framebuffer transaction as named by the routine
                      (c/enemy_runtime.s):00014         ; DOC-002 source-contract mirror profile framebuffer Clobbers: A, B, D, X, Y, U, and condition codes unless the fixed entry contract narrows them
                      (c/enemy_runtime.s):00015         ; DOC-002 source-contract mirror profile framebuffer Reads: Always-mapped framebuffer protocol bytes and owner-local metadata
                      (c/enemy_runtime.s):00016         ; DOC-002 source-contract mirror profile framebuffer Writes: Framebuffer protocol bytes, BACK pixels, owner-local metadata, and GIME display offset only at IRQ publication
                      (c/enemy_runtime.s):00017         ; DOC-002 source-contract mirror profile framebuffer Side effects: Advances one bounded phase of the persistent A/B transaction
                      (c/enemy_runtime.s):00018         ; DOC-002 source-contract mirror profile framebuffer Invariants: Foreground code may arm PENDING but only Vbord IRQ publishes FRONT; mapping-sensitive pointers do not outlive PAR changes
                      (c/enemy_runtime.s):00019         ; DOC-002 source-contract mirror profile movement Inputs: Current actor coordinates, direction, maze topology, gate state, and collision state
                      (c/enemy_runtime.s):00020         ; DOC-002 source-contract mirror profile movement Outputs: A legality result, selected direction, contact result, or updated actor state
                      (c/enemy_runtime.s):00021         ; DOC-002 source-contract mirror profile movement Clobbers: A, B, D, X, Y, U, and condition codes unless a narrower source-local header is present
                      (c/enemy_runtime.s):00022         ; DOC-002 source-contract mirror profile movement Reads: Authoritative actor records, maze and gate tables, and movement scratch
                      (c/enemy_runtime.s):00023         ; DOC-002 source-contract mirror profile movement Writes: Owned actor state, collision flags, and render intents required by the movement result
                      (c/enemy_runtime.s):00024         ; DOC-002 source-contract mirror profile movement Side effects: May change authoritative gameplay state and queue later composition
                      (c/enemy_runtime.s):00025         ; DOC-002 source-contract mirror profile movement Invariants: Movement remains on legal semantic cells and does not write framebuffer pixels directly
                      (c/enemy_runtime.s):00026         ; DOC-002 source-contract mirror profile render Inputs: Current render intent, selected actor or tile state, and a valid BACK or staging destination
                      (c/enemy_runtime.s):00027         ; DOC-002 source-contract mirror profile render Outputs: Updated destination pixels and any owner-local history required by later restoration
                      (c/enemy_runtime.s):00028         ; DOC-002 source-contract mirror profile render Clobbers: A, B, D, X, Y, U, and condition codes unless a narrower source-local header is present
                      (c/enemy_runtime.s):00029         ; DOC-002 source-contract mirror profile render Reads: Authoritative gameplay state, immutable art streams, and current owner-local background metadata
                      (c/enemy_runtime.s):00030         ; DOC-002 source-contract mirror profile render Writes: BACK or staging pixels, render scratch, and owner-local save-under or damage metadata
                      (c/enemy_runtime.s):00031         ; DOC-002 source-contract mirror profile render Side effects: Changes a non-visible composition surface or its metadata
                      (c/enemy_runtime.s):00032         ; DOC-002 source-contract mirror profile render Invariants: The routine never selects the visible FRONT surface; temporary PAR5 mappings expire or restore before return
                      (c/enemy_runtime.s):00033         ; DOC-002 source-contract mirror profile root Inputs: Entry-specific machine state and the shared direct-page protocol named by the routine purpose
                      (c/enemy_runtime.s):00034         ; DOC-002 source-contract mirror profile root Outputs: Control transfers or status values defined by the routine purpose
                      (c/enemy_runtime.s):00035         ; DOC-002 source-contract mirror profile root Clobbers: A, B, D, X, Y, U, and condition codes unless the caller-facing entry contract states otherwise
                      (c/enemy_runtime.s):00036         ; DOC-002 source-contract mirror profile root Reads: Always-mapped direct-page protocol state plus the module-owned state required by the selected operation
                      (c/enemy_runtime.s):00037         ; DOC-002 source-contract mirror profile root Writes: Module-owned state and mapped hardware registers required to establish or dispatch the operation
                      (c/enemy_runtime.s):00038         ; DOC-002 source-contract mirror profile root Side effects: May change mapping, interrupt, rendering, or lifecycle ownership as stated by the routine purpose
                      (c/enemy_runtime.s):00039         ; DOC-002 source-contract mirror profile root Invariants: The stack remains balanced and every temporary PAR mapping is restored or deliberately handed off before return
                      (c/enemy_runtime.s):00040         ; DOC-002 source-contract mirror profile state Inputs: Current authoritative gameplay or presentation state; register arguments are named by the routine label and immediate caller
                      (c/enemy_runtime.s):00041         ; DOC-002 source-contract mirror profile state Outputs: Updated authoritative state and condition codes used by the immediate caller
                      (c/enemy_runtime.s):00042         ; DOC-002 source-contract mirror profile state Clobbers: A, B, D, X, Y, U, and condition codes unless a narrower source-local header is present
                      (c/enemy_runtime.s):00043         ; DOC-002 source-contract mirror profile state Reads: Owned direct-page and page-$34 state needed for the operation
                      (c/enemy_runtime.s):00044         ; DOC-002 source-contract mirror profile state Writes: Only the owned state fields and render intents required by the operation
                      (c/enemy_runtime.s):00045         ; DOC-002 source-contract mirror profile state Side effects: May enqueue rendering work but does not publish FRONT
                      (c/enemy_runtime.s):00046         ; DOC-002 source-contract mirror profile state Invariants: Authoritative state changes precede their render intents; framebuffer publication remains IRQ-owned
                      (c/enemy_runtime.s):00047         ; DOC-002 source-contract mirror contract actor_closure_draw profile=render: Draw the actors selected by the current damage closure.
                      (c/enemy_runtime.s):00048         ; DOC-002 source-contract mirror contract actor_closure_restore profile=render: Restore background for the actors selected by the current damage closure.
                      (c/enemy_runtime.s):00049         ; DOC-002 source-contract mirror contract blit_stage_sprite profile=render: Blit stage sprite.
                      (c/enemy_runtime.s):00050         ; DOC-002 source-contract mirror contract build_enemy_nest_cache profile=copy: Build enemy nest cache.
                      (c/enemy_runtime.s):00051         ; DOC-002 source-contract mirror contract capture_zone_bg profile=render: Capture the current zone background before an actor overlay changes it.
                      (c/enemy_runtime.s):00052         ; DOC-002 source-contract mirror contract compose_enemy_animation profile=render: Compose enemy animation.
                      (c/enemy_runtime.s):00053         ; DOC-002 source-contract mirror contract compose_enemy_zone profile=render: Compose enemy zone.
                      (c/enemy_runtime.s):00054         ; DOC-002 source-contract mirror contract copy_nest_128 profile=copy: Copy nest 128.
                      (c/enemy_runtime.s):00055         ; DOC-002 source-contract mirror contract copy_two_fb_rows profile=copy: Copy two fb rows.
                      (c/enemy_runtime.s):00056         ; DOC-002 source-contract mirror contract draw_enemy_fb profile=render: Draw enemy fb.
                      (c/enemy_runtime.s):00057         ; DOC-002 source-contract mirror contract draw_enemy_stage profile=render: Draw enemy stage.
                      (c/enemy_runtime.s):00058         ; DOC-002 source-contract mirror contract draw_vegetable_stage profile=render: Draw vegetable stage.
                      (c/enemy_runtime.s):00059         ; DOC-002 source-contract mirror contract enemy_choose_direction profile=movement: Select a legal enemy direction from maze, gate, and target state.
                      (c/enemy_runtime.s):00060         ; DOC-002 source-contract mirror contract enemy_collect_impl profile=state: Resolve the vegetable collection transition and its enemy-state consequences.
                      (c/enemy_runtime.s):00061         ; DOC-002 source-contract mirror contract enemy_direction_legal profile=movement: Test whether a proposed enemy direction is legal at the current semantic cell.
                      (c/enemy_runtime.s):00062         ; DOC-002 source-contract mirror contract enemy_frame_number profile=copy: Resolve the animation frame number for the current enemy state and direction.
                      (c/enemy_runtime.s):00063         ; DOC-002 source-contract mirror contract enemy_init_impl profile=state: Reset enemy lifecycle state and mark enemy composition dirty.
                      (c/enemy_runtime.s):00064         ; DOC-002 source-contract mirror contract enemy_player_contact profile=movement: Test and resolve contact between an active enemy and the player.
                      (c/enemy_runtime.s):00065         ; DOC-002 source-contract mirror contract enemy_release_impl profile=movement: Release an eligible enemy from the nest into authoritative gameplay state.
                      (c/enemy_runtime.s):00066         ; DOC-002 source-contract mirror contract enemy_render_impl profile=render: Compose current enemy actors and their owner-local background history.
                      (c/enemy_runtime.s):00067         ; DOC-002 source-contract mirror contract enemy_skull_test profile=movement: Test whether the current enemy position triggers the skull interaction.
                      (c/enemy_runtime.s):00068         ; DOC-002 source-contract mirror contract enemy_tick_impl profile=movement: Advance enemy lifecycle, movement, contact, and render-intent state for one gameplay tick.
                      (c/enemy_runtime.s):00069         ; DOC-002 source-contract mirror contract frame_render_background profile=render: Reconstruct BACK background work before actor overlays are drawn.
                      (c/enemy_runtime.s):00070         ; DOC-002 source-contract mirror contract frame_render_impl profile=root: Compose the selected BACK surface and arm its completed transaction.
                      (c/enemy_runtime.s):00071         ; DOC-002 source-contract mirror contract framebuffer_back_meta profile=framebuffer: Resolve the owner-local metadata record for the current BACK framebuffer.
                      (c/enemy_runtime.s):00072         ; DOC-002 source-contract mirror contract framebuffer_begin_fallback profile=framebuffer: Begin the bounded full-surface fallback transaction.
                      (c/enemy_runtime.s):00073         ; DOC-002 source-contract mirror contract framebuffer_capture_a profile=framebuffer: Capture owner-A restoration state for persistent A/B initialization.
                      (c/enemy_runtime.s):00074         ; DOC-002 source-contract mirror contract framebuffer_capture_back profile=framebuffer: Capture current BACK owner metadata after composition.
                      (c/enemy_runtime.s):00075         ; DOC-002 source-contract mirror contract framebuffer_finish_back profile=framebuffer: Finish the current BACK transaction and arm PENDING publication.
                      (c/enemy_runtime.s):00076         ; DOC-002 source-contract mirror contract framebuffer_finish_fallback profile=framebuffer: Finish the fallback full-surface transaction.
                      (c/enemy_runtime.s):00077         ; DOC-002 source-contract mirror contract framebuffer_init_impl profile=framebuffer: Clone the initial surface and initialize persistent A/B owner metadata while display output is blanked.
                      (c/enemy_runtime.s):00078         ; DOC-002 source-contract mirror contract framebuffer_irq_impl profile=framebuffer: Publish a completed PENDING framebuffer at Vbord and maintain frame counters.
                      (c/enemy_runtime.s):00079         ; DOC-002 source-contract mirror contract framebuffer_prepare_back profile=framebuffer: Prepare owner-local history and damage state for the selected BACK framebuffer.
                      (c/enemy_runtime.s):00080         ; DOC-002 source-contract mirror contract framebuffer_project_damage profile=framebuffer: Project pending damage intents into the selected BACK worklist.
                      (c/enemy_runtime.s):00081         ; DOC-002 source-contract mirror contract framebuffer_queue_damage profile=framebuffer: Append one bounded damage intent to owner-local metadata.
                      (c/enemy_runtime.s):00082         ; DOC-002 source-contract mirror contract gate_compose_impl profile=render: Compose the selected gate mutation and its intersecting overlays into BACK.
                      (c/enemy_runtime.s):00083         ; DOC-002 source-contract mirror contract gate_compute_region profile=copy: Compute the bounded framebuffer region affected by the current gate.
                      (c/enemy_runtime.s):00084         ; DOC-002 source-contract mirror contract gate_map_live profile=copy: Map the live gate region used for final composition.
                      (c/enemy_runtime.s):00085         ; DOC-002 source-contract mirror contract gate_map_shadow profile=copy: Map the shadow gate region used for restoration.
                      (c/enemy_runtime.s):00086         ; DOC-002 source-contract mirror contract gate_map_shadow_window profile=copy: Map the page window containing the current shadow gate region.
                      (c/enemy_runtime.s):00087         ; DOC-002 source-contract mirror contract gate_region_from_shadow profile=copy: Translate a shadow-region identity into the live region representation.
                      (c/enemy_runtime.s):00088         ; DOC-002 source-contract mirror contract gate_region_to_shadow profile=copy: Translate a live gate region into its shadow representation.
                      (c/enemy_runtime.s):00089         ; DOC-002 source-contract mirror contract gate_set_player_region profile=copy: Add the player's footprint to the current gate damage region when they intersect.
                      (c/enemy_runtime.s):00090         ; DOC-002 source-contract mirror contract merge_stage_pixel profile=render: Merge stage pixel.
                      (c/enemy_runtime.s):00091         ; DOC-002 source-contract mirror contract player_compose_impl profile=render: Compose the player and its owner-local save-under history into BACK.
                      (c/enemy_runtime.s):00092         ; DOC-002 source-contract mirror contract player_draw_impl profile=state: Draw the selected player sparse stream into BACK.
                      (c/enemy_runtime.s):00093         ; DOC-002 source-contract mirror contract refresh_zone_bg_footprint profile=copy: Refresh zone bg footprint.
                      (c/enemy_runtime.s):00094         ; DOC-002 source-contract mirror contract render_exposed_player profile=render: Render exposed player.
                      (c/enemy_runtime.s):00095         ; DOC-002 source-contract mirror contract render_perimeter_reset profile=render: Render perimeter reset.
                      (c/enemy_runtime.s):00096         ; DOC-002 source-contract mirror contract roam_bg_address profile=copy: Resolve the background-ring address for one roaming actor slot.
                      (c/enemy_runtime.s):00097         ; DOC-002 source-contract mirror contract roam_capture_ring_row profile=copy: Capture one framebuffer row into a roaming actor background-ring slot.
                      (c/enemy_runtime.s):00098         ; DOC-002 source-contract mirror contract roam_copy_bg_to_fb profile=copy: Restore a roaming actor background record into framebuffer pixels.
                      (c/enemy_runtime.s):00099         ; DOC-002 source-contract mirror contract roam_copy_fb_to_bg profile=copy: Capture framebuffer pixels into a roaming actor background record.
                      (c/enemy_runtime.s):00100         ; DOC-002 source-contract mirror contract roam_finish_shadow profile=copy: Finalize shadow metadata after roaming actor restoration.
                      (c/enemy_runtime.s):00101         ; DOC-002 source-contract mirror contract roam_mark_underlay profile=copy: Mark the roaming actor underlay that must be captured after background work.
                      (c/enemy_runtime.s):00102         ; DOC-002 source-contract mirror contract roam_old_slot profile=copy: Resolve the prior background-ring slot for one roaming actor.
                      (c/enemy_runtime.s):00103         ; DOC-002 source-contract mirror contract roam_prepare_shadow profile=copy: Prepare shadow state for a roaming actor update.
                      (c/enemy_runtime.s):00104         ; DOC-002 source-contract mirror contract roam_ring_slot profile=copy: Resolve the current background-ring slot for one roaming actor.
                      (c/enemy_runtime.s):00105         ; DOC-002 source-contract mirror contract roam_set_final_union profile=copy: Commit the union of old and new roaming actor damage regions.
                      (c/enemy_runtime.s):00106         ; DOC-002 source-contract mirror contract roam_snapshot_old profile=copy: Snapshot the prior roaming actor position and background ownership.
                      (c/enemy_runtime.s):00107         ; DOC-002 source-contract mirror contract roam_update_background profile=copy: Update roaming actor background history after composition.
                      (c/enemy_runtime.s):00108         ; DOC-002 source-contract mirror contract sparse_blit_fb profile=render: Decode a sparse sprite stream directly into framebuffer pixels.
                      (c/enemy_runtime.s):00109         ; DOC-002 source-contract mirror contract sparse_blit_stage profile=render: Decode a sparse sprite stream into the bounded stage buffer.
                      (c/enemy_runtime.s):00110         ; DOC-002 source-contract mirror contract sparse_enemy_stream profile=render: Resolve the sparse stream for the selected enemy frame.
                      (c/enemy_runtime.s):00111         ; DOC-002 source-contract mirror contract sparse_player_stream profile=render: Resolve the sparse stream for the selected player frame.
                      (c/enemy_runtime.s):00112         ; DOC-002 source-contract mirror ends.
                      (c/enemy_runtime.s):00113         
