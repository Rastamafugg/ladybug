                      (erf003/src/main.s):00001         ;==============================================================================
                      (erf003/src/main.s):00002         ; Ladybug — main.s
                      (erf003/src/main.s):00003         ;==============================================================================
                      (erf003/src/main.s):00004         ; Phase 4: joystick-driven Lady Bug movement over the authored screen.
                      (erf003/src/main.s):00005         ;
                      (erf003/src/main.s):00006         ; Builds on Phase 2.3 (hi-res 320×192×16 + MMU + palette + IRQ tick) by:
                      (erf003/src/main.s):00007         ;   - Compiling tiled/coco-screen.tmx into a one-byte tile map and a
                      (erf003/src/main.s):00008         ;     deduplicated packed 4bpp tile atlas before assembly.
                      (erf003/src/main.s):00009         ;   - Flattening visible Tiled layers and applying horizontal/vertical flips.
                      (erf003/src/main.s):00010         ;   - blit_tile: 8 rows x 4 bytes, stride 160.
                      (erf003/src/main.s):00011         ;   - Polling the right joystick through the PIA DAC/comparator path.
                      (erf003/src/main.s):00012         ;   - Transparent 16x16 player frames with background save/restore.
                      (erf003/src/main.s):00013         ;   - Semantic maze collision and dot removal.
                      (erf003/src/main.s):00014         ;
                      (erf003/src/main.s):00015         ; Visible: the authored screen with a moving, maze-constrained Lady Bug.
                      (erf003/src/main.s):00016         ;==============================================================================
                      (erf003/src/main.s):00017         
                      (erf003/src/main.s):00018                 pragma  nodollarlocal,6809
                      (erf003/src/main.s):00019         
                      (erf003/src/main.s):00020         ;------------------------------------------------------------------------------
                      (erf003/src/main.s):00021         ; DP allocation (page $00)
                      (erf003/src/main.s):00022         ;------------------------------------------------------------------------------
     00               (erf003/src/main.s):00023                 setdp   $00
                      (erf003/src/main.s):00024         
     0000             (erf003/src/main.s):00025         LAST_FRAME    equ $0000         ; last processed Vbord counter low byte
     0001             (erf003/src/main.s):00026         JOY_X         equ $0001         ; right joystick X, 0..63
     0002             (erf003/src/main.s):00027         FRAMES        equ $0002         ; u16 frame counter
     0004             (erf003/src/main.s):00028         JOY_Y         equ $0004         ; right joystick Y, 0..63
