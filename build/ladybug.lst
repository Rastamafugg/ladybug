                      (adybug/src/main.s):02578         ;   X — destination framebuffer byte address
                      (adybug/src/main.s):02579         ;   Y — packed 4bpp source data; colour 0 is transparent
                      (adybug/src/main.s):02580         ;
                      (adybug/src/main.s):02581         ; Returns: A, B, X, Y, CC undefined
                      (adybug/src/main.s):02582         ; Side effects: blends the requested rectangle into the framebuffer.
