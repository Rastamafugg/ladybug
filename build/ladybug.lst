     0048             (adybug/src/main.s):00088         ENTITY_WORK  equ $0048         ; entity placement / loop scratch
     0049             (adybug/src/main.s):00089         ENTITY_TOTAL equ $0049         ; total records allocated this stage
     004A             (adybug/src/main.s):00090         BOX_TIMER    equ $004A         ; frames until next perimeter-box update
     004B             (adybug/src/main.s):00091         BOX_INDEX    equ $004B         ; clockwise perimeter position, 0..91
     004C             (adybug/src/main.s):00092         BOX_PHASE    equ $004C         ; 0=White-to-Green, 1=Green-to-White
     004D             (adybug/src/main.s):00093         DEATH_STATE  equ $004D         ; 0=alive, 1=shrink/wings, 2=angel, 3=blank, 4=game over
     004E             (adybug/src/main.s):00094         DEATH_FRAME  equ $004E         ; selected curated death frame
     004F             (adybug/src/main.s):00095         PLAYER_ANIM  equ $004F         ; walk animation phase 0,1,2,3
     0050             (adybug/src/main.s):00096         PLAYER_ANIM_TIMER equ $0050    ; Vbord countdown to next player frame
     0051             (adybug/src/main.s):00097         PICKUP_TIMER equ $0051         ; score-sprite hold; zero when inactive
     0052             (adybug/src/main.s):00098         PICKUP_FRAME equ $0052         ; 0=100, 1=300, 2=800
     0053             (adybug/src/main.s):00099         PICKUP_MULTIPLIER equ $0053    ; multiplier in force before this pickup
     0054             (adybug/src/main.s):00100         ENEMY_ANIM   equ $0054         ; first den enemy animation phase
     0055             (adybug/src/main.s):00101         ENEMY_TIMER  equ $0055         ; Vbord countdown to next enemy frame
     0056             (adybug/src/main.s):00102         TURN_SNAP    equ $0056         ; diagonal late-turn updates remaining, 0..3
     0057             (adybug/src/main.s):00103         TURN_OLD     equ $0057         ; direction being corrected during late turn
     0058             (adybug/src/main.s):00104         ENEMY_ACTIVE equ $0058         ; active enemy count, reduced by skull deaths
     0059             (adybug/src/main.s):00105         ENEMY_RELEASED equ $0059       ; total timer releases this stage
     005A             (adybug/src/main.s):00106         VEG_STATE    equ $005A         ; 0=dormant enemy, 1=vegetable, 2=collected
     005B             (adybug/src/main.s):00107         FREEZE_TIMER equ $005B         ; u16 enemy freeze countdown
     005D             (adybug/src/main.s):00108         ENEMY_WORK   equ $005D         ; banked enemy loop scratch
     005E             (adybug/src/main.s):00109         ENEMY_PTR    equ $005E         ; u16 banked enemy record pointer
     0062             (adybug/src/main.s):00110         ENEMY_DEATH_LATCH equ $0062    ; 0=alive, 1=reset pending, 2=reset published
     0067             (adybug/src/main.s):00111         PLAYER_OLD_FB equ $0067        ; framebuffer pointer owned by PLAYER_BG
     0069             (adybug/src/main.s):00112         PLAYER_ERASED equ $0069        ; nonzero after old player background is exposed
     006A             (adybug/src/main.s):00113         PLAYER_BG_VALID equ $006A      ; PLAYER_BG contains restorable pixels
