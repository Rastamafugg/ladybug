                      (adybug/src/main.s):00295                 ; PAR1 ($2000) = phys $30   FB page 0
                      (adybug/src/main.s):00296                 ; PAR2 ($4000) = phys $31   FB page 1
                      (adybug/src/main.s):00297                 ; PAR3 ($6000) = phys $32   FB page 2
                      (adybug/src/main.s):00298                 ; PAR4 ($8000) = phys $33   FB page 3
                      (adybug/src/main.s):00299                 ; PAR5 ($A000) = phys $34   game state (Phase 4+)
                      (adybug/src/main.s):00300                 ; PAR6 ($C000) = phys $3E   cartridge code (current 8 K window)
                      (adybug/src/main.s):00301                 ; PAR7 ($E000) = phys $3F   cartridge/ROM window + IO + jump table
