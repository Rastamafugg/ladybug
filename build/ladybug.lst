                      (adybug/src/main.s):03621         ;   X — destination framebuffer byte address
                      (adybug/src/main.s):03622         ;   Y — packed 4bpp source data; colour 0 is transparent
                      (adybug/src/main.s):03623         ;
                      (adybug/src/main.s):03624         ; Returns: A, B, X, Y, CC undefined
