C021 B6FF22           (rf-001/src/main.s):00294                 lda     PIA2_DB
                      (rf-001/src/main.s):00295         
                      (rf-001/src/main.s):00296                 ; --- Init0 — legacy mode, ACVC IRQ on, force $FExx, MMU still off ---
C024 86A8             (rf-001/src/main.s):00297                 lda     #%10101000
C026 B7FF90           (rf-001/src/main.s):00298                 sta     GIME_INIT0
C029 B602F0           (rf-001/src/main.s):00299                 lda     BOOT_FLAG
C02C 81A5             (rf-001/src/main.s):00300                 cmpa    #$A5
C02E 2703             (rf-001/src/main.s):00301                 beq     entry_ram_loaded
C030 B7FFDE           (rf-001/src/main.s):00302                 sta     SAM_ROMRAM       ; plain-cart fallback selects TY=0
C033                  (rf-001/src/main.s):00303         entry_ram_loaded
                      (rf-001/src/main.s):00304         
                      (rf-001/src/main.s):00305                 ; --- Enter runtime from direct ROM or GMC-loaded RAM ---
                      (rf-001/src/main.s):00306                 ; Direct fallback keeps TY=0. XRoar discards writes to the selected cartridge window,
                      (rf-001/src/main.s):00307                 ; so the former same-address self-copy never populated phys $3E-$3F.
                      (rf-001/src/main.s):00308                 ; PAR6=$3E keeps $C000-$DFFF cartridge-backed after MMU enable while
                      (rf-001/src/main.s):00309                 ; the framebuffer and writable state use ordinary RAM pages below $3C.
                      (rf-001/src/main.s):00310         
                      (rf-001/src/main.s):00311                 ; --- Force executive PAR set ($FFA0-$FFA7) to be active ---
C033 7FFF91           (rf-001/src/main.s):00312                 clr     $FF91
                      (rf-001/src/main.s):00313         
                      (rf-001/src/main.s):00314                 ; --- Set up MMU PARs (executive set) ---
                      (rf-001/src/main.s):00315                 ; PAR0 ($0000) = phys $38   low RAM (DP, stack)
                      (rf-001/src/main.s):00316                 ; PAR1 ($2000) = phys $30   FB page 0
                      (rf-001/src/main.s):00317                 ; PAR2 ($4000) = phys $31   FB page 1
                      (rf-001/src/main.s):00318                 ; PAR3 ($6000) = phys $32   FB page 2
                      (rf-001/src/main.s):00319                 ; PAR4 ($8000) = phys $33   FB page 3
                      (rf-001/src/main.s):00320                 ; PAR5 ($A000) = phys $34   game state (Phase 4+)
                      (rf-001/src/main.s):00321                 ; PAR6 ($C000) = phys $3E   cartridge code (current 8 K window)
                      (rf-001/src/main.s):00322                 ; PAR7 ($E000) = phys $3F   cartridge/ROM window + IO + jump table
C036 308D16D6         (rf-001/src/main.s):00323                 leax    par_table,pcr
C03A 108EFFA0         (rf-001/src/main.s):00324                 ldy     #PAR_EXEC
C03E C608             (rf-001/src/main.s):00325                 ldb     #8
C040 A680             (rf-001/src/main.s):00326         parloop lda     ,x+
C042 A7A0             (rf-001/src/main.s):00327                 sta     ,y+
C044 5A               (rf-001/src/main.s):00328                 decb
C045 26F9             (rf-001/src/main.s):00329                 bne     parloop
                      (rf-001/src/main.s):00330         
                      (rf-001/src/main.s):00331                 ; --- Fast clock 1.78 MHz ---
C047 B7FFD9           (rf-001/src/main.s):00332                 sta     SAM_FAST
                      (rf-001/src/main.s):00333         
                      (rf-001/src/main.s):00334                 ; --- Set up display (still blanked via CRES=11) ---
C04A 8680             (rf-001/src/main.s):00335                 lda     #%10000000      ; BP=1 (graphics)
C04C B7FF98           (rf-001/src/main.s):00336                 sta     GIME_VMODE
                      (rf-001/src/main.s):00337         
C04F 861F             (rf-001/src/main.s):00338                 lda     #$1F            ; VRES=00 HRES=111 CRES=11 (BLANKED)
C051 B7FF99           (rf-001/src/main.s):00339                 sta     GIME_VRES
                      (rf-001/src/main.s):00340         
C054 7FFF9A           (rf-001/src/main.s):00341                 clr     GIME_BORDER     ; canonical Black outside the active framebuffer
                      (rf-001/src/main.s):00342         
                      (rf-001/src/main.s):00343                 ; FB at phys $30 → physical address $060000.
                      (rf-001/src/main.s):00344                 ;   Y18=1, Y17=1, Y16..Y3 = 0
                      (rf-001/src/main.s):00345                 ;   V1 ($FF9D) = Y18..Y11 = %11000000 = $C0
                      (rf-001/src/main.s):00346                 ;   V0 ($FF9E) = Y10..Y3  = $00
C057 86C0             (rf-001/src/main.s):00347                 lda     #$C0
C059 B7FF9D           (rf-001/src/main.s):00348                 sta     GIME_VOFF1
C05C 7FFF9E           (rf-001/src/main.s):00349                 clr     GIME_VOFF0
                      (rf-001/src/main.s):00350         
                      (rf-001/src/main.s):00351                 ; --- Init0 — turn on MMU + switch to hi-res. Display still blanked. ---
                      (rf-001/src/main.s):00352                 ; %01101000 = COCO=0 MMU=1 ACVCIRQ=1 ACVCFIRQ=0 force-$FExx=1 SCS=0 ROMmap=00
C05F 8668             (rf-001/src/main.s):00353                 lda     #%01101000
C061 B7FF90           (rf-001/src/main.s):00354                 sta     GIME_INIT0
