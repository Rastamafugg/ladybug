     008E             (adybug/src/main.s):00130         RENDER_GATE2_STYLE equ $008E
     02F0             (adybug/src/main.s):00131         BOOT_FLAG    equ $02F0         ; $A5 when GMC bootstrap relocated runtime to RAM
