                      (adybug/src/main.s):03131         ; blit_tile — copy an 8x8 tile to a framebuffer byte address.
                      (adybug/src/main.s):03132         ;
                      (adybug/src/main.s):03133         ; Inputs:
                      (adybug/src/main.s):03134         ;   X — destination framebuffer byte address
                      (adybug/src/main.s):03135         ;   Y — source glyph data, 32 packed 4bpp bytes
                      (adybug/src/main.s):03136         ;
                      (adybug/src/main.s):03137         ; Returns:
                      (adybug/src/main.s):03138         ;   A, B, D, X, Y, U, CC — undefined
                      (adybug/src/main.s):03139         ;
                      (adybug/src/main.s):03140         ; Side effects:
                      (adybug/src/main.s):03141         ;   Writes 8 rows x 4 bytes; advances 156 bytes after each written row.
                      (adybug/src/main.s):03142         ;==============================================================================
D328                  (adybug/src/main.s):03143         blit_tile
                      (adybug/src/main.s):03144                 ; ldd ,y++ clobbers B, so use a Y-vs-sentinel loop instead of decb.
                      (adybug/src/main.s):03145                 ; See wiki/internal/implementation/lessons-learned.html
                      (adybug/src/main.s):03146                 ; §"LDD ,Y++ clobbers B".
