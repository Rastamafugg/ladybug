                      (adybug/src/main.s):01545         
C8D9 7FFF21           (adybug/src/main.s):01546                 clr     PIA2_CRA        ; select PIA2 PA direction register
C8DC 86FC             (adybug/src/main.s):01547                 lda     #$FC
C8DE B7FF20           (adybug/src/main.s):01548                 sta     PIA2_DA         ; PA7-PA2 are the six-bit DAC
C8E1 8604             (adybug/src/main.s):01549                 lda     #$04            ; data-register access
C8E3 B7FF21           (adybug/src/main.s):01550                 sta     PIA2_CRA
C8E6 7FFF23           (adybug/src/main.s):01551                 clr     PIA2_CRB
C8E9 8634             (adybug/src/main.s):01552                 lda     #$34            ; static CB2 low enables analog multiplexer
C8EB B7FF23           (adybug/src/main.s):01553                 sta     PIA2_CRB
C8EE 8680             (adybug/src/main.s):01554                 lda     #$80            ; centre DAC while idle
C8F0 B7FF20           (adybug/src/main.s):01555                 sta     PIA2_DA
C8F3 39               (adybug/src/main.s):01556                 rts
