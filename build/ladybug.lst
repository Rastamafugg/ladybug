                      (adybug/src/main.s):01630         
C91C 7FFF21           (adybug/src/main.s):01631                 clr     PIA2_CRA        ; select PIA2 PA direction register
C91F 86FC             (adybug/src/main.s):01632                 lda     #$FC
C921 B7FF20           (adybug/src/main.s):01633                 sta     PIA2_DA         ; PA7-PA2 are the six-bit DAC
C924 8604             (adybug/src/main.s):01634                 lda     #$04            ; data-register access
C926 B7FF21           (adybug/src/main.s):01635                 sta     PIA2_CRA
C929 7FFF23           (adybug/src/main.s):01636                 clr     PIA2_CRB
