C02E 2703             (adybug/src/main.s):00306                 beq     entry_ram_loaded
C030 B7FFDE           (adybug/src/main.s):00307                 sta     SAM_ROMRAM       ; plain-cart fallback selects TY=0
C033                  (adybug/src/main.s):00308         entry_ram_loaded
                      (adybug/src/main.s):00309         
                      (adybug/src/main.s):00310                 ; --- Enter runtime from direct ROM or GMC-loaded RAM ---
                      (adybug/src/main.s):00311                 ; Direct fallback keeps TY=0. XRoar discards writes to the selected cartridge window,
                      (adybug/src/main.s):00312                 ; so the former same-address self-copy never populated phys $3E-$3F.
                      (adybug/src/main.s):00313                 ; PAR6=$3E keeps $C000-$DFFF cartridge-backed after MMU enable while
                      (adybug/src/main.s):00314                 ; the framebuffer and writable state use ordinary RAM pages below $3C.
                      (adybug/src/main.s):00315         
                      (adybug/src/main.s):00316                 ; --- Force executive PAR set ($FFA0-$FFA7) to be active ---
C033 7FFF91           (adybug/src/main.s):00317                 clr     $FF91
                      (adybug/src/main.s):00318         
                      (adybug/src/main.s):00319                 ; --- Set up MMU PARs (executive set) ---
                      (adybug/src/main.s):00320                 ; PAR0 ($0000) = phys $38   low RAM (DP, stack)
                      (adybug/src/main.s):00321                 ; PAR1 ($2000) = phys $30   FB page 0
                      (adybug/src/main.s):00322                 ; PAR2 ($4000) = phys $31   FB page 1
                      (adybug/src/main.s):00323                 ; PAR3 ($6000) = phys $32   FB page 2
                      (adybug/src/main.s):00324                 ; PAR4 ($8000) = phys $33   FB page 3
                      (adybug/src/main.s):00325                 ; PAR5 ($A000) = phys $34   game state (Phase 4+)
                      (adybug/src/main.s):00326                 ; PAR6 ($C000) = phys $3E   cartridge code (current 8 K window)
                      (adybug/src/main.s):00327                 ; PAR7 ($E000) = phys $3F   cartridge/ROM window + IO + jump table
C036 308D1734         (adybug/src/main.s):00328                 leax    par_table,pcr
C03A 108EFFA0         (adybug/src/main.s):00329                 ldy     #PAR_EXEC
C03E C608             (adybug/src/main.s):00330                 ldb     #8
C040 A680             (adybug/src/main.s):00331         parloop lda     ,x+
C042 A7A0             (adybug/src/main.s):00332                 sta     ,y+
C044 5A               (adybug/src/main.s):00333                 decb
C045 26F9             (adybug/src/main.s):00334                 bne     parloop
                      (adybug/src/main.s):00335         
                      (adybug/src/main.s):00336                 ; --- Fast clock 1.78 MHz ---
C047 B7FFD9           (adybug/src/main.s):00337                 sta     SAM_FAST
                      (adybug/src/main.s):00338         
                      (adybug/src/main.s):00339                 ; --- Set up display (still blanked via CRES=11) ---
