C95E 86FC             (adybug/src/main.s):01691                 lda     #$FC
C960 B7FF20           (adybug/src/main.s):01692                 sta     PIA2_DA         ; PA7-PA2 are the six-bit DAC
C963 8604             (adybug/src/main.s):01693                 lda     #$04            ; data-register access
C965 B7FF21           (adybug/src/main.s):01694                 sta     PIA2_CRA
C968 7FFF23           (adybug/src/main.s):01695                 clr     PIA2_CRB
