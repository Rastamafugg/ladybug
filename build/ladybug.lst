                      (adybug/src/main.s):01472         
C895 7FFF21           (adybug/src/main.s):01473                 clr     PIA2_CRA        ; select PIA2 PA direction register
C898 86FC             (adybug/src/main.s):01474                 lda     #$FC
C89A B7FF20           (adybug/src/main.s):01475                 sta     PIA2_DA         ; PA7-PA2 are the six-bit DAC
C89D 8604             (adybug/src/main.s):01476                 lda     #$04            ; data-register access
C89F B7FF21           (adybug/src/main.s):01477                 sta     PIA2_CRA
C8A2 7FFF23           (adybug/src/main.s):01478                 clr     PIA2_CRB
