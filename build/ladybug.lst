                      (adybug/src/main.s):01590         ; init_joystick — configure the PIAs for right-joystick DAC conversion.
                      (adybug/src/main.s):01591         ;
                      (adybug/src/main.s):01592         ; Inputs:
                      (adybug/src/main.s):01593         ;   None
                      (adybug/src/main.s):01594         ;
                      (adybug/src/main.s):01595         ; Returns:
                      (adybug/src/main.s):01596         ;   A, CC — undefined
                      (adybug/src/main.s):01597         ;
                      (adybug/src/main.s):01598         ; Side effects:
                      (adybug/src/main.s):01599         ;   Configures PIA1 PA as input, PIA1 PB as output, PIA2 PA7-PA2 as DAC
                      (adybug/src/main.s):01600         ;   output, and selects/enables the right joystick analog multiplexer.
                      (adybug/src/main.s):01601         ;==============================================================================
C8F4                  (adybug/src/main.s):01602         init_joystick
C8F4 7FFF01           (adybug/src/main.s):01603                 clr     PIA1_CRA        ; select PIA1 PA direction register
C8F7 7FFF00           (adybug/src/main.s):01604                 clr     PIA1_DA         ; all PA bits input, including comparator PA7
C8FA 7FFF03           (adybug/src/main.s):01605                 clr     PIA1_CRB        ; select PIA1 PB direction register
C8FD 86FF             (adybug/src/main.s):01606                 lda     #$FF
C8FF B7FF02           (adybug/src/main.s):01607                 sta     PIA1_DB         ; keyboard columns/output side
C902 8634             (adybug/src/main.s):01608                 lda     #$34            ; data register, static CA2/CB2 output low
C904 B7FF01           (adybug/src/main.s):01609                 sta     PIA1_CRA
C907 B7FF03           (adybug/src/main.s):01610                 sta     PIA1_CRB        ; selector 0 = right joystick X
                      (adybug/src/main.s):01611         
C90A 7FFF21           (adybug/src/main.s):01612                 clr     PIA2_CRA        ; select PIA2 PA direction register
C90D 86FC             (adybug/src/main.s):01613                 lda     #$FC
C90F B7FF20           (adybug/src/main.s):01614                 sta     PIA2_DA         ; PA7-PA2 are the six-bit DAC
C912 8604             (adybug/src/main.s):01615                 lda     #$04            ; data-register access
C914 B7FF21           (adybug/src/main.s):01616                 sta     PIA2_CRA
C917 7FFF23           (adybug/src/main.s):01617                 clr     PIA2_CRB
C91A 8634             (adybug/src/main.s):01618                 lda     #$34            ; static CB2 low enables analog multiplexer
C91C B7FF23           (adybug/src/main.s):01619                 sta     PIA2_CRB
C91F 8680             (adybug/src/main.s):01620                 lda     #$80            ; centre DAC while idle
C921 B7FF20           (adybug/src/main.s):01621                 sta     PIA2_DA
C924 39               (adybug/src/main.s):01622                 rts
