                      (adybug/src/main.s):03328         ;   X — destination framebuffer byte address
                      (adybug/src/main.s):03329         ;   Y — packed 4bpp source data; colour 0 is transparent
                      (adybug/src/main.s):03330         ;
                      (adybug/src/main.s):03331         ; Returns: A, B, X, Y, CC undefined
                      (adybug/src/main.s):03332         ; Side effects: blends the requested rectangle into the framebuffer.
                      (adybug/src/main.s):03333         ;==============================================================================
