C95E 86FC             (adybug/src/main.s):01686                 lda     #$FC
C960 B7FF20           (adybug/src/main.s):01687                 sta     PIA2_DA         ; PA7-PA2 are the six-bit DAC
C963 8604             (adybug/src/main.s):01688                 lda     #$04            ; data-register access
C965 B7FF21           (adybug/src/main.s):01689                 sta     PIA2_CRA
C968 7FFF23           (adybug/src/main.s):01690                 clr     PIA2_CRB
