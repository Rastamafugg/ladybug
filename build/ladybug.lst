     0002             (verage/src/main.s):00027         FRAMES        equ $0002         ; u16 frame counter
     0004             (verage/src/main.s):00028         JOY_Y         equ $0004         ; right joystick Y, 0..63
     0005             (verage/src/main.s):00029         JOY_DIR       equ $0005         ; requested direction or $FF
     0006             (verage/src/main.s):00030         PLAYER_DIR    equ $0006         ; active direction or $FF
