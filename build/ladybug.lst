                      (ration/src/main.s):01940         ; init_joystick — configure the PIAs for right-joystick DAC conversion.
                      (ration/src/main.s):01941         ;
                      (ration/src/main.s):01942         ; Inputs:
                      (ration/src/main.s):01943         ;   None
                      (ration/src/main.s):01944         ;
                      (ration/src/main.s):01945         ; Returns:
                      (ration/src/main.s):01946         ;   A, CC — undefined
                      (ration/src/main.s):01947         ;
                      (ration/src/main.s):01948         ; Side effects:
                      (ration/src/main.s):01949         ;   Configures PIA1 PA as input, PIA1 PB as output, PIA2 PA7-PA2 as DAC
                      (ration/src/main.s):01950         ;   output, and selects/enables the right joystick analog multiplexer.
                      (ration/src/main.s):01951         ;==============================================================================
C9BA                  (ration/src/main.s):01952         init_joystick
C9BA 7FFF01           (ration/src/main.s):01953                 clr     PIA1_CRA        ; select PIA1 PA direction register
C9BD 7FFF00           (ration/src/main.s):01954                 clr     PIA1_DA         ; all PA bits input, including comparator PA7
C9C0 7FFF03           (ration/src/main.s):01955                 clr     PIA1_CRB        ; select PIA1 PB direction register
C9C3 CCFF34           (ration/src/main.s):01956                 ldd     #$FF34
C9C6 FDFF02           (ration/src/main.s):01957                 std     PIA1_DB         ; PB output DDR, then data/CB2-low control
C9C9 F7FF01           (ration/src/main.s):01958                 stb     PIA1_CRA        ; data register, static CA2 low: right X
                      (ration/src/main.s):01959         
C9CC 7FFF21           (ration/src/main.s):01960                 clr     PIA2_CRA        ; select PIA2 PA direction register
C9CF 86FC             (ration/src/main.s):01961                 lda     #$FC
C9D1 B7FF20           (ration/src/main.s):01962                 sta     PIA2_DA         ; PA7-PA2 are the six-bit DAC
C9D4 8604             (ration/src/main.s):01963                 lda     #$04            ; data-register access
C9D6 B7FF21           (ration/src/main.s):01964                 sta     PIA2_CRA
C9D9 7FFF23           (ration/src/main.s):01965                 clr     PIA2_CRB
C9DC CC3480           (ration/src/main.s):01966                 ldd     #$3480          ; analog mux enabled, centred DAC value
C9DF B7FF23           (ration/src/main.s):01967                 sta     PIA2_CRB
C9E2 F7FF20           (ration/src/main.s):01968                 stb     PIA2_DA
C9E5 39               (ration/src/main.s):01969                 rts
                      (ration/src/main.s):01970         
