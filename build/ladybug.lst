                      (adybug/src/main.s):00001         ;==============================================================================
                      (adybug/src/main.s):00002         ; Ladybug — main.s
                      (adybug/src/main.s):00003         ;==============================================================================
                      (adybug/src/main.s):00004         ; Phase 2.6: render build-generated arcade text to the framebuffer.
                      (adybug/src/main.s):00005         ;
                      (adybug/src/main.s):00006         ; Builds on Phase 2.3 (hi-res 320×192×16 + MMU + palette + IRQ tick) by:
                      (adybug/src/main.s):00007         ;   - Replacing the 16-stripe diagnostic with a black-cleared FB.
                      (adybug/src/main.s):00008         ;   - Generating the palette and seven 4bpp GIME glyphs for LADYBUG from
                      (adybug/src/main.s):00009         ;     assets/arcade/chars.json before assembly.
                      (adybug/src/main.s):00010         ;   - Rotating the arcade glyphs 90 degrees counter-clockwise so they are
                      (adybug/src/main.s):00011         ;     upright on the unrotated CoCo 3 framebuffer.
                      (adybug/src/main.s):00012         ;   - blit_tile: 8 rows x 4 bytes, stride 160.
                      (adybug/src/main.s):00013         ;   - put_char: row/column character coordinates over blit_tile.
                      (adybug/src/main.s):00014         ;
                      (adybug/src/main.s):00015         ; Visible: yellow LADYBUG title centered near the top of a black screen.
                      (adybug/src/main.s):00016         ;==============================================================================
                      (adybug/src/main.s):00017         
                      (adybug/src/main.s):00018                 pragma  nodollarlocal,6809
                      (adybug/src/main.s):00019         
                      (adybug/src/main.s):00020         ;------------------------------------------------------------------------------
                      (adybug/src/main.s):00021         ; DP allocation (page $02)
                      (adybug/src/main.s):00022         ;------------------------------------------------------------------------------
     02               (adybug/src/main.s):00023                 setdp   $02
                      (adybug/src/main.s):00024         
     0202             (adybug/src/main.s):00025         FRAMES  equ     $0202           ; u16 frame counter
                      (adybug/src/main.s):00026         
                      (adybug/src/main.s):00027         ;------------------------------------------------------------------------------
                      (adybug/src/main.s):00028         ; Hardware
                      (adybug/src/main.s):00029         ;------------------------------------------------------------------------------
     FF00             (adybug/src/main.s):00030         PIA1_DA    equ  $FF00
     FF01             (adybug/src/main.s):00031         PIA1_CRA   equ  $FF01
     FF02             (adybug/src/main.s):00032         PIA1_DB    equ  $FF02
     FF03             (adybug/src/main.s):00033         PIA1_CRB   equ  $FF03
     FF20             (adybug/src/main.s):00034         PIA2_DA    equ  $FF20
     FF21             (adybug/src/main.s):00035         PIA2_CRA   equ  $FF21
     FF22             (adybug/src/main.s):00036         PIA2_DB    equ  $FF22
     FF23             (adybug/src/main.s):00037         PIA2_CRB   equ  $FF23
                      (adybug/src/main.s):00038         
     FF90             (adybug/src/main.s):00039         GIME_INIT0 equ  $FF90
     FF92             (adybug/src/main.s):00040         GIME_IRQEN equ  $FF92
     FF98             (adybug/src/main.s):00041         GIME_VMODE equ  $FF98
     FF99             (adybug/src/main.s):00042         GIME_VRES  equ  $FF99
     FF9A             (adybug/src/main.s):00043         GIME_BORDER equ $FF9A
     FF9D             (adybug/src/main.s):00044         GIME_VOFF1 equ  $FF9D           ; addr bits Y18..Y11
     FF9E             (adybug/src/main.s):00045         GIME_VOFF0 equ  $FF9E           ; addr bits Y10..Y3
     FFA0             (adybug/src/main.s):00046         PAR_EXEC   equ  $FFA0           ; PAR0 of executive set ($FFA0..$FFA7)
     FFB0             (adybug/src/main.s):00047         PAL_BASE   equ  $FFB0
                      (adybug/src/main.s):00048         
     FFD9             (adybug/src/main.s):00049         SAM_FAST   equ  $FFD9
     FFDE             (adybug/src/main.s):00050         SAM_ROMRAM equ  $FFDE
                      (adybug/src/main.s):00051         
     FEF7             (adybug/src/main.s):00052         JT_IRQ     equ  $FEF7
                      (adybug/src/main.s):00053         
                      (adybug/src/main.s):00054         ;------------------------------------------------------------------------------
                      (adybug/src/main.s):00055         ; Memory map (post-Phase-2.3 with MMU on)
                      (adybug/src/main.s):00056         ;------------------------------------------------------------------------------
     2000             (adybug/src/main.s):00057         FB_VIRT    equ  $2000           ; virtual base of framebuffer (PAR1)
     9800             (adybug/src/main.s):00058         FB_END     equ  $9800           ; one past last FB byte (192 rows × 160 B)
     0030             (adybug/src/main.s):00059         FB_PHYS    equ  $30             ; physical page 0 of FB
                      (adybug/src/main.s):00060         
                      (adybug/src/main.s):00061         ;==============================================================================
                      (adybug/src/main.s):00062         ;  Cart ROM
                      (adybug/src/main.s):00063         ;==============================================================================
                      (adybug/src/main.s):00064                 org     $C000
                      (adybug/src/main.s):00065         
C000 444B             (adybug/src/main.s):00066                 fcc     "DK"            ; ROM-pack autostart magic; FIRQ -> $C002
                      (adybug/src/main.s):00067         
                      (adybug/src/main.s):00068         ;==============================================================================
                      (adybug/src/main.s):00069         ; entry
                      (adybug/src/main.s):00070         ;==============================================================================
C002 1A50             (adybug/src/main.s):00071         entry   orcc    #$50            ; mask IRQ + FIRQ
C004 10CE1FFE         (adybug/src/main.s):00072                 lds     #$1FFE          ; stack at top of low RAM page
                      (adybug/src/main.s):00073         
C008 8602             (adybug/src/main.s):00074                 lda     #$02            ; DP = $02
C00A 1F8B             (adybug/src/main.s):00075                 tfr     a,dp
                      (adybug/src/main.s):00076         
                      (adybug/src/main.s):00077                 ; --- Quiet legacy PIA interrupts ---
C00C 4F               (adybug/src/main.s):00078                 clra
C00D B7FF01           (adybug/src/main.s):00079                 sta     PIA1_CRA
C010 B7FF03           (adybug/src/main.s):00080                 sta     PIA1_CRB
C013 B7FF21           (adybug/src/main.s):00081                 sta     PIA2_CRA
C016 B7FF23           (adybug/src/main.s):00082                 sta     PIA2_CRB
C019 B6FF00           (adybug/src/main.s):00083                 lda     PIA1_DA
C01C B6FF02           (adybug/src/main.s):00084                 lda     PIA1_DB
C01F B6FF20           (adybug/src/main.s):00085                 lda     PIA2_DA
C022 B6FF22           (adybug/src/main.s):00086                 lda     PIA2_DB
                      (adybug/src/main.s):00087         
                      (adybug/src/main.s):00088                 ; --- Init0 — legacy mode, ACVC IRQ on, force $FExx, MMU still off ---
C025 86A8             (adybug/src/main.s):00089                 lda     #%10101000
C027 B7FF90           (adybug/src/main.s):00090                 sta     GIME_INIT0
C02A B7FFDE           (adybug/src/main.s):00091                 sta     SAM_ROMRAM       ; cart map is selected before clearing TY
                      (adybug/src/main.s):00092         
                      (adybug/src/main.s):00093                 ; --- Execute directly from cartridge ROM ---
                      (adybug/src/main.s):00094                 ; Keep TY=0. XRoar discards writes to the selected cartridge window,
                      (adybug/src/main.s):00095                 ; so the former same-address self-copy never populated phys $3E-$3F.
                      (adybug/src/main.s):00096                 ; PAR6=$3E keeps $C000-$DFFF cartridge-backed after MMU enable while
                      (adybug/src/main.s):00097                 ; the framebuffer and writable state use ordinary RAM pages below $3C.
                      (adybug/src/main.s):00098         
                      (adybug/src/main.s):00099                 ; --- Force executive PAR set ($FFA0-$FFA7) to be active ---
C02D 7FFF91           (adybug/src/main.s):00100                 clr     $FF91
                      (adybug/src/main.s):00101         
                      (adybug/src/main.s):00102                 ; --- Set up MMU PARs (executive set) ---
                      (adybug/src/main.s):00103                 ; PAR0 ($0000) = phys $38   low RAM (DP, stack)
                      (adybug/src/main.s):00104                 ; PAR1 ($2000) = phys $30   FB page 0
                      (adybug/src/main.s):00105                 ; PAR2 ($4000) = phys $31   FB page 1
                      (adybug/src/main.s):00106                 ; PAR3 ($6000) = phys $32   FB page 2
                      (adybug/src/main.s):00107                 ; PAR4 ($8000) = phys $33   FB page 3
                      (adybug/src/main.s):00108                 ; PAR5 ($A000) = phys $34   game state (Phase 4+)
                      (adybug/src/main.s):00109                 ; PAR6 ($C000) = phys $3E   cartridge code (current 8 K window)
                      (adybug/src/main.s):00110                 ; PAR7 ($E000) = phys $3F   cartridge/ROM window + IO + jump table
C030 308D00D6         (adybug/src/main.s):00111                 leax    par_table,pcr
C034 108EFFA0         (adybug/src/main.s):00112                 ldy     #PAR_EXEC
C038 C608             (adybug/src/main.s):00113                 ldb     #8
C03A A680             (adybug/src/main.s):00114         parloop lda     ,x+
C03C A7A0             (adybug/src/main.s):00115                 sta     ,y+
C03E 5A               (adybug/src/main.s):00116                 decb
C03F 26F9             (adybug/src/main.s):00117                 bne     parloop
                      (adybug/src/main.s):00118         
                      (adybug/src/main.s):00119                 ; --- Fast clock 1.78 MHz ---
C041 B7FFD9           (adybug/src/main.s):00120                 sta     SAM_FAST
                      (adybug/src/main.s):00121         
                      (adybug/src/main.s):00122                 ; --- Set up display (still blanked via CRES=11) ---
C044 8680             (adybug/src/main.s):00123                 lda     #%10000000      ; BP=1 (graphics)
C046 B7FF98           (adybug/src/main.s):00124                 sta     GIME_VMODE
                      (adybug/src/main.s):00125         
C049 861F             (adybug/src/main.s):00126                 lda     #$1F            ; VRES=00 HRES=111 CRES=11 (BLANKED)
C04B B7FF99           (adybug/src/main.s):00127                 sta     GIME_VRES
                      (adybug/src/main.s):00128         
C04E 8628             (adybug/src/main.s):00129                 lda     #$28            ; bright border (empirically "pink") so a black
C050 B7FF9A           (adybug/src/main.s):00130                 sta     GIME_BORDER     ;   stripe 0 is visually distinct from the border
                      (adybug/src/main.s):00131         
                      (adybug/src/main.s):00132                 ; FB at phys $30 → physical address $060000.
                      (adybug/src/main.s):00133                 ;   Y18=1, Y17=1, Y16..Y3 = 0
                      (adybug/src/main.s):00134                 ;   V1 ($FF9D) = Y18..Y11 = %11000000 = $C0
                      (adybug/src/main.s):00135                 ;   V0 ($FF9E) = Y10..Y3  = $00
C053 86C0             (adybug/src/main.s):00136                 lda     #$C0
C055 B7FF9D           (adybug/src/main.s):00137                 sta     GIME_VOFF1
C058 7FFF9E           (adybug/src/main.s):00138                 clr     GIME_VOFF0
                      (adybug/src/main.s):00139         
                      (adybug/src/main.s):00140                 ; --- Init0 — turn on MMU + switch to hi-res. Display still blanked. ---
                      (adybug/src/main.s):00141                 ; %01101000 = COCO=0 MMU=1 ACVCIRQ=1 ACVCFIRQ=0 force-$FExx=1 SCS=0 ROMmap=00
C05B 8668             (adybug/src/main.s):00142                 lda     #%01101000
C05D B7FF90           (adybug/src/main.s):00143                 sta     GIME_INIT0
                      (adybug/src/main.s):00144         
                      (adybug/src/main.s):00145                 ; --- Load palette (16 entries) ---
C060 308D00AE         (adybug/src/main.s):00146                 leax    palette_table,pcr
C064 108EFFB0         (adybug/src/main.s):00147                 ldy     #PAL_BASE
C068 C610             (adybug/src/main.s):00148                 ldb     #16
C06A A680             (adybug/src/main.s):00149         palloop lda     ,x+
C06C A7A0             (adybug/src/main.s):00150                 sta     ,y+
C06E 5A               (adybug/src/main.s):00151                 decb
C06F 26F9             (adybug/src/main.s):00152                 bne     palloop
                      (adybug/src/main.s):00153         
                      (adybug/src/main.s):00154                 ; --- Clear FB to palette idx 0 (black) ---
                      (adybug/src/main.s):00155                 ; 30720 bytes = 15360 STDs.
C071 8E2000           (adybug/src/main.s):00156                 ldx     #FB_VIRT
C074 CC0000           (adybug/src/main.s):00157                 ldd     #$0000
C077 ED81             (adybug/src/main.s):00158         clr_fb  std     ,x++
C079 8C9800           (adybug/src/main.s):00159                 cmpx    #FB_END
C07C 25F9             (adybug/src/main.s):00160                 blo     clr_fb
                      (adybug/src/main.s):00161         
                      (adybug/src/main.s):00162                 ; --- Phase 2 exit text ---
C07E 170033           (adybug/src/main.s):00163                 lbsr    draw_title
                      (adybug/src/main.s):00164         
                      (adybug/src/main.s):00165                 ; --- Un-blank: 320×192×16 (CRES=10 + HRES=111 → 4bpp on this build) ---
C081 861E             (adybug/src/main.s):00166                 lda     #$1E
C083 B7FF99           (adybug/src/main.s):00167                 sta     GIME_VRES
                      (adybug/src/main.s):00168         
                      (adybug/src/main.s):00169                 ; Phase 2.6 isolation: halt here so the visible state is just
                      (adybug/src/main.s):00170                 ; LADYBUG on black. The IRQ install + Vbord enable below is
                      (adybug/src/main.s):00171                 ; carried over from Phase 2.3 but has not been re-verified against
                      (adybug/src/main.s):00172                 ; the new MMU/PAR layout — leaving it disabled until that's done.
                      (adybug/src/main.s):00173         
                      (adybug/src/main.s):00174                 ; --- L4 probe: write sentinel to JT_IRQ, persist readback + marker,
                      (adybug/src/main.s):00175                 ;     fall through to phase26_halt for trap-snap capture.
C086 8655             (adybug/src/main.s):00176                 lda     #$55
C088 B7FEF7           (adybug/src/main.s):00177                 sta     JT_IRQ          ; the suspect store
C08B B6FEF7           (adybug/src/main.s):00178                 lda     JT_IRQ
C08E B70FFE           (adybug/src/main.s):00179                 sta     $0FFE           ; readback of $FEF7
C091 86AA             (adybug/src/main.s):00180                 lda     #$AA
C093 B70FFF           (adybug/src/main.s):00181                 sta     $0FFF           ; liveness marker
C096                  (adybug/src/main.s):00182         phase26_halt
C096 20FE             (adybug/src/main.s):00183                 bra     phase26_halt
                      (adybug/src/main.s):00184         
                      (adybug/src/main.s):00185                 ; --- IRQ handler at $FEF7 jump-table slot ---
C098 867E             (adybug/src/main.s):00186                 lda     #$7E            ; JMP extended
C09A B7FEF7           (adybug/src/main.s):00187                 sta     JT_IRQ
C09D CCC100           (adybug/src/main.s):00188                 ldd     #irq_handler
C0A0 FDFEF8           (adybug/src/main.s):00189                 std     JT_IRQ+1
                      (adybug/src/main.s):00190         
C0A3 0F02             (adybug/src/main.s):00191                 clr     FRAMES
C0A5 0F03             (adybug/src/main.s):00192                 clr     FRAMES+1
                      (adybug/src/main.s):00193         
                      (adybug/src/main.s):00194                 ; --- Enable Vbord ---
C0A7 8608             (adybug/src/main.s):00195                 lda     #%00001000
C0A9 B7FF92           (adybug/src/main.s):00196                 sta     GIME_IRQEN
C0AC B6FF92           (adybug/src/main.s):00197                 lda     GIME_IRQEN
                      (adybug/src/main.s):00198         
C0AF 1CEF             (adybug/src/main.s):00199                 andcc   #%11101111      ; unmask IRQ
                      (adybug/src/main.s):00200         
                      (adybug/src/main.s):00201         ;==============================================================================
                      (adybug/src/main.s):00202         ; mainloop — IRQ keeps ticking FRAMES; CPU just spins.
                      (adybug/src/main.s):00203         ;==============================================================================
C0B1                  (adybug/src/main.s):00204         mainloop
C0B1 13               (adybug/src/main.s):00205                 sync
C0B2 20FD             (adybug/src/main.s):00206                 bra     mainloop
                      (adybug/src/main.s):00207         
                      (adybug/src/main.s):00208         ;==============================================================================
                      (adybug/src/main.s):00209         ; draw_title — render the seven contiguous LADYBUG glyphs.
                      (adybug/src/main.s):00210         ;
                      (adybug/src/main.s):00211         ; Inputs:
                      (adybug/src/main.s):00212         ;   None
                      (adybug/src/main.s):00213         ;
                      (adybug/src/main.s):00214         ; Returns:
                      (adybug/src/main.s):00215         ;   A, B, X, Y, U, D, CC — undefined
                      (adybug/src/main.s):00216         ;
                      (adybug/src/main.s):00217         ; Side effects:
                      (adybug/src/main.s):00218         ;   Writes seven 8x8 glyphs at character row 1, columns 16..22.
                      (adybug/src/main.s):00219         ;==============================================================================
C0B4                  (adybug/src/main.s):00220         draw_title
C0B4 318D006A         (adybug/src/main.s):00221                 leay    glyph_l,pcr     ; generated glyph order is L,A,D,Y,B,U,G
C0B8 8601             (adybug/src/main.s):00222                 lda     #1
C0BA C610             (adybug/src/main.s):00223                 ldb     #16
C0BC CE0007           (adybug/src/main.s):00224                 ldu     #7
C0BF                  (adybug/src/main.s):00225         dt_next
C0BF 3406             (adybug/src/main.s):00226                 pshs    d               ; put_char consumes row and column
C0C1 17000C           (adybug/src/main.s):00227                 lbsr    put_char
C0C4 3506             (adybug/src/main.s):00228                 puls    d
C0C6 5C               (adybug/src/main.s):00229                 incb
C0C7 335F             (adybug/src/main.s):00230                 leau    -1,u            ; LEAU does not update condition codes
C0C9 11830000         (adybug/src/main.s):00231                 cmpu    #0
C0CD 26F0             (adybug/src/main.s):00232                 bne     dt_next
C0CF 39               (adybug/src/main.s):00233                 rts
                      (adybug/src/main.s):00234         
                      (adybug/src/main.s):00235         ;==============================================================================
                      (adybug/src/main.s):00236         ; put_char — render one glyph at an 8x8 character coordinate.
                      (adybug/src/main.s):00237         ;
                      (adybug/src/main.s):00238         ; Inputs:
                      (adybug/src/main.s):00239         ;   A — character row, 0..23
                      (adybug/src/main.s):00240         ;   B — character column, 0..39
                      (adybug/src/main.s):00241         ;   Y — source glyph data, 32 packed 4bpp bytes
                      (adybug/src/main.s):00242         ;   U — caller-owned value
                      (adybug/src/main.s):00243         ;
                      (adybug/src/main.s):00244         ; Returns:
                      (adybug/src/main.s):00245         ;   U — preserved
                      (adybug/src/main.s):00246         ;   A, B, D, X, Y, CC — undefined
                      (adybug/src/main.s):00247         ;
                      (adybug/src/main.s):00248         ; Side effects:
                      (adybug/src/main.s):00249         ;   Writes one 8x8 glyph to the framebuffer.
                      (adybug/src/main.s):00250         ;==============================================================================
C0D0                  (adybug/src/main.s):00251         put_char
C0D0 3440             (adybug/src/main.s):00252                 pshs    u
C0D2 8E2000           (adybug/src/main.s):00253                 ldx     #FB_VIRT
C0D5 4D               (adybug/src/main.s):00254                 tsta
C0D6 2707             (adybug/src/main.s):00255                 beq     pc_column
C0D8                  (adybug/src/main.s):00256         pc_row
C0D8 30890500         (adybug/src/main.s):00257                 leax    1280,x          ; 8 pixel rows x 160 bytes
C0DC 4A               (adybug/src/main.s):00258                 deca
C0DD 26F9             (adybug/src/main.s):00259                 bne     pc_row
C0DF                  (adybug/src/main.s):00260         pc_column
C0DF 58               (adybug/src/main.s):00261                 lslb                    ; 8 pixels x 4bpp = 4 bytes
C0E0 58               (adybug/src/main.s):00262                 lslb
C0E1 3A               (adybug/src/main.s):00263                 abx
C0E2 170002           (adybug/src/main.s):00264                 lbsr    blit_tile
C0E5 35C0             (adybug/src/main.s):00265                 puls    u,pc
                      (adybug/src/main.s):00266         
                      (adybug/src/main.s):00267         ;==============================================================================
                      (adybug/src/main.s):00268         ; blit_tile — copy an 8x8 tile to a framebuffer byte address.
                      (adybug/src/main.s):00269         ;
                      (adybug/src/main.s):00270         ; Inputs:
                      (adybug/src/main.s):00271         ;   X — destination framebuffer byte address
                      (adybug/src/main.s):00272         ;   Y — source glyph data, 32 packed 4bpp bytes
                      (adybug/src/main.s):00273         ;
                      (adybug/src/main.s):00274         ; Returns:
                      (adybug/src/main.s):00275         ;   A, B, D, X, Y, U, CC — undefined
                      (adybug/src/main.s):00276         ;
                      (adybug/src/main.s):00277         ; Side effects:
                      (adybug/src/main.s):00278         ;   Writes 8 rows x 4 bytes; advances 156 bytes after each written row.
                      (adybug/src/main.s):00279         ;==============================================================================
C0E7                  (adybug/src/main.s):00280         blit_tile
                      (adybug/src/main.s):00281                 ; ldd ,y++ clobbers B, so use a Y-vs-sentinel loop instead of decb.
                      (adybug/src/main.s):00282                 ; See wiki/internal/implementation/lessons-learned.html
                      (adybug/src/main.s):00283                 ; §"LDD ,Y++ clobbers B".
C0E7 33A820           (adybug/src/main.s):00284                 leau    32,y            ; sentinel = end of tile data
C0EA 3440             (adybug/src/main.s):00285                 pshs    u
C0EC ECA1             (adybug/src/main.s):00286         btrow   ldd     ,y++
C0EE ED81             (adybug/src/main.s):00287                 std     ,x++
C0F0 ECA1             (adybug/src/main.s):00288                 ldd     ,y++
C0F2 ED81             (adybug/src/main.s):00289                 std     ,x++
C0F4 3089009C         (adybug/src/main.s):00290                 leax    156,x           ; advance to next FB row, same column
C0F8 10ACE4           (adybug/src/main.s):00291                 cmpy    ,s
C0FB 25EF             (adybug/src/main.s):00292                 blo     btrow
C0FD 3262             (adybug/src/main.s):00293                 leas    2,s
C0FF 39               (adybug/src/main.s):00294                 rts
                      (adybug/src/main.s):00295         
                      (adybug/src/main.s):00296         ;==============================================================================
                      (adybug/src/main.s):00297         ; irq_handler — Vbord (60 Hz)
                      (adybug/src/main.s):00298         ;==============================================================================
C100                  (adybug/src/main.s):00299         irq_handler
C100 B6FF92           (adybug/src/main.s):00300                 lda     GIME_IRQEN
C103 0C03             (adybug/src/main.s):00301                 inc     FRAMES+1
C105 2602             (adybug/src/main.s):00302                 bne     irq_done
