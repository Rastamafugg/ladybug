                      (adybug/src/main.s):02573         ; blit_transparent — overlay nonzero packed nibbles from a rectangle.
                      (adybug/src/main.s):02574         ;
                      (adybug/src/main.s):02575         ; Inputs:
                      (adybug/src/main.s):02576         ;   A — source row count
