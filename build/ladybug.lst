                      (adybug/src/main.s):01435         ; init_joystick — configure the PIAs for right-joystick DAC conversion.
                      (adybug/src/main.s):01436         ;
                      (adybug/src/main.s):01437         ; Inputs:
                      (adybug/src/main.s):01438         ;   None
                      (adybug/src/main.s):01439         ;
                      (adybug/src/main.s):01440         ; Returns:
                      (adybug/src/main.s):01441         ;   A, CC — undefined
                      (adybug/src/main.s):01442         ;
                      (adybug/src/main.s):01443         ; Side effects:
                      (adybug/src/main.s):01444         ;   Configures PIA1 PA as input, PIA1 PB as output, PIA2 PA7-PA2 as DAC
                      (adybug/src/main.s):01445         ;   output, and selects/enables the right joystick analog multiplexer.
                      (adybug/src/main.s):01446         ;==============================================================================
C80E                  (adybug/src/main.s):01447         init_joystick
C80E 7FFF01           (adybug/src/main.s):01448                 clr     PIA1_CRA        ; select PIA1 PA direction register
C811 7FFF00           (adybug/src/main.s):01449                 clr     PIA1_DA         ; all PA bits input, including comparator PA7
C814 7FFF03           (adybug/src/main.s):01450                 clr     PIA1_CRB        ; select PIA1 PB direction register
C817 86FF             (adybug/src/main.s):01451                 lda     #$FF
C819 B7FF02           (adybug/src/main.s):01452                 sta     PIA1_DB         ; keyboard columns/output side
C81C 8634             (adybug/src/main.s):01453                 lda     #$34            ; data register, static CA2/CB2 output low
C81E B7FF01           (adybug/src/main.s):01454                 sta     PIA1_CRA
C821 B7FF03           (adybug/src/main.s):01455                 sta     PIA1_CRB        ; selector 0 = right joystick X
                      (adybug/src/main.s):01456         
C824 7FFF21           (adybug/src/main.s):01457                 clr     PIA2_CRA        ; select PIA2 PA direction register
C827 86FC             (adybug/src/main.s):01458                 lda     #$FC
C829 B7FF20           (adybug/src/main.s):01459                 sta     PIA2_DA         ; PA7-PA2 are the six-bit DAC
C82C 8604             (adybug/src/main.s):01460                 lda     #$04            ; data-register access
C82E B7FF21           (adybug/src/main.s):01461                 sta     PIA2_CRA
C831 7FFF23           (adybug/src/main.s):01462                 clr     PIA2_CRB
C834 8634             (adybug/src/main.s):01463                 lda     #$34            ; static CB2 low enables analog multiplexer
C836 B7FF23           (adybug/src/main.s):01464                 sta     PIA2_CRB
C839 8680             (adybug/src/main.s):01465                 lda     #$80            ; centre DAC while idle
C83B B7FF20           (adybug/src/main.s):01466                 sta     PIA2_DA
C83E 39               (adybug/src/main.s):01467                 rts
