                      (adybug/src/main.s):01523         ; init_joystick — configure the PIAs for right-joystick DAC conversion.
                      (adybug/src/main.s):01524         ;
                      (adybug/src/main.s):01525         ; Inputs:
                      (adybug/src/main.s):01526         ;   None
                      (adybug/src/main.s):01527         ;
                      (adybug/src/main.s):01528         ; Returns:
                      (adybug/src/main.s):01529         ;   A, CC — undefined
                      (adybug/src/main.s):01530         ;
                      (adybug/src/main.s):01531         ; Side effects:
                      (adybug/src/main.s):01532         ;   Configures PIA1 PA as input, PIA1 PB as output, PIA2 PA7-PA2 as DAC
