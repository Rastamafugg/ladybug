C8C9 7FFF03           (adybug/src/main.s):01538                 clr     PIA1_CRB        ; select PIA1 PB direction register
C8CC 86FF             (adybug/src/main.s):01539                 lda     #$FF
C8CE B7FF02           (adybug/src/main.s):01540                 sta     PIA1_DB         ; keyboard columns/output side
