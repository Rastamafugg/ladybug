                      (adybug/src/main.s):01338         ; init_joystick — configure the PIAs for right-joystick DAC conversion.
                      (adybug/src/main.s):01339         ;
                      (adybug/src/main.s):01340         ; Inputs:
                      (adybug/src/main.s):01341         ;   None
                      (adybug/src/main.s):01342         ;
                      (adybug/src/main.s):01343         ; Returns:
                      (adybug/src/main.s):01344         ;   A, CC — undefined
                      (adybug/src/main.s):01345         ;
                      (adybug/src/main.s):01346         ; Side effects:
                      (adybug/src/main.s):01347         ;   Configures PIA1 PA as input, PIA1 PB as output, PIA2 PA7-PA2 as DAC
                      (adybug/src/main.s):01348         ;   output, and selects/enables the right joystick analog multiplexer.
                      (adybug/src/main.s):01349         ;==============================================================================
C7AE                  (adybug/src/main.s):01350         init_joystick
C7AE 7FFF01           (adybug/src/main.s):01351                 clr     PIA1_CRA        ; select PIA1 PA direction register
C7B1 7FFF00           (adybug/src/main.s):01352                 clr     PIA1_DA         ; all PA bits input, including comparator PA7
C7B4 7FFF03           (adybug/src/main.s):01353                 clr     PIA1_CRB        ; select PIA1 PB direction register
C7B7 86FF             (adybug/src/main.s):01354                 lda     #$FF
C7B9 B7FF02           (adybug/src/main.s):01355                 sta     PIA1_DB         ; keyboard columns/output side
C7BC 8634             (adybug/src/main.s):01356                 lda     #$34            ; data register, static CA2/CB2 output low
C7BE B7FF01           (adybug/src/main.s):01357                 sta     PIA1_CRA
C7C1 B7FF03           (adybug/src/main.s):01358                 sta     PIA1_CRB        ; selector 0 = right joystick X
                      (adybug/src/main.s):01359         
C7C4 7FFF21           (adybug/src/main.s):01360                 clr     PIA2_CRA        ; select PIA2 PA direction register
C7C7 86FC             (adybug/src/main.s):01361                 lda     #$FC
C7C9 B7FF20           (adybug/src/main.s):01362                 sta     PIA2_DA         ; PA7-PA2 are the six-bit DAC
C7CC 8604             (adybug/src/main.s):01363                 lda     #$04            ; data-register access
C7CE B7FF21           (adybug/src/main.s):01364                 sta     PIA2_CRA
C7D1 7FFF23           (adybug/src/main.s):01365                 clr     PIA2_CRB
C7D4 8634             (adybug/src/main.s):01366                 lda     #$34            ; static CB2 low enables analog multiplexer
C7D6 B7FF23           (adybug/src/main.s):01367                 sta     PIA2_CRB
C7D9 8680             (adybug/src/main.s):01368                 lda     #$80            ; centre DAC while idle
C7DB B7FF20           (adybug/src/main.s):01369                 sta     PIA2_DA
C7DE 39               (adybug/src/main.s):01370                 rts
