                      (ration/src/main.s):00001         ;==============================================================================
                      (ration/src/main.s):00002         ; Ladybug — main.s
                      (ration/src/main.s):00003         ;==============================================================================
                      (ration/src/main.s):00004         ; DOC-002 source-contract mirror begins. Canonical definitions:
                      (ration/src/main.s):00005         ; wiki/internal/implementation/routine-catalog.html
                      (ration/src/main.s):00006         ; DOC-002 source-contract mirror profile copy Inputs: Source and destination identities, bounded count or stream metadata, and any required mapped page
                      (ration/src/main.s):00007         ; DOC-002 source-contract mirror profile copy Outputs: Copied, decoded, merged, cached, or addressed data plus caller-visible pointer progress
                      (ration/src/main.s):00008         ; DOC-002 source-contract mirror profile copy Clobbers: A, B, D, X, Y, U, and condition codes unless a narrower source-local header is present
                      (ration/src/main.s):00009         ; DOC-002 source-contract mirror profile copy Reads: The declared source stream, table, framebuffer rows, or metadata record
                      (ration/src/main.s):00010         ; DOC-002 source-contract mirror profile copy Writes: Only the declared bounded destination record, cache, row range, or scratch fields
                      (ration/src/main.s):00011         ; DOC-002 source-contract mirror profile copy Side effects: May temporarily map PAR5 while moving or decoding data
                      (ration/src/main.s):00012         ; DOC-002 source-contract mirror profile copy Invariants: Counts and destination bounds are honored; temporary mappings are restored before returning
                      (ration/src/main.s):00013         ; DOC-002 source-contract mirror profile framebuffer Inputs: ACTIVE/PENDING state, BACK identity, owner metadata, and the current worklist
                      (ration/src/main.s):00014         ; DOC-002 source-contract mirror profile framebuffer Outputs: A prepared, captured, finished, or published framebuffer transaction as named by the routine
                      (ration/src/main.s):00015         ; DOC-002 source-contract mirror profile framebuffer Clobbers: A, B, D, X, Y, U, and condition codes unless the fixed entry contract narrows them
                      (ration/src/main.s):00016         ; DOC-002 source-contract mirror profile framebuffer Reads: Always-mapped framebuffer protocol bytes and owner-local metadata
                      (ration/src/main.s):00017         ; DOC-002 source-contract mirror profile framebuffer Writes: Framebuffer protocol bytes, BACK pixels, owner-local metadata, and GIME display offset only at IRQ publication
                      (ration/src/main.s):00018         ; DOC-002 source-contract mirror profile framebuffer Side effects: Advances one bounded phase of the persistent A/B transaction
                      (ration/src/main.s):00019         ; DOC-002 source-contract mirror profile framebuffer Invariants: Foreground code may arm PENDING but only Vbord IRQ publishes FRONT; mapping-sensitive pointers do not outlive PAR changes
                      (ration/src/main.s):00020         ; DOC-002 source-contract mirror profile input Inputs: PIA input state, prior sampled state, and axis or key selection
                      (ration/src/main.s):00021         ; DOC-002 source-contract mirror profile input Outputs: Normalized input state, edge bits, or axis sample
                      (ration/src/main.s):00022         ; DOC-002 source-contract mirror profile input Clobbers: A, B, D, X, Y, U, and condition codes unless a narrower source-local header is present
                      (ration/src/main.s):00023         ; DOC-002 source-contract mirror profile input Reads: PIA registers and prior input samples
                      (ration/src/main.s):00024         ; DOC-002 source-contract mirror profile input Writes: Owned input state and temporary PIA scan selection
                      (ration/src/main.s):00025         ; DOC-002 source-contract mirror profile input Side effects: Temporarily drives keyboard or joystick scan hardware
                      (ration/src/main.s):00026         ; DOC-002 source-contract mirror profile input Invariants: PIA control and drive state are restored to the runtime convention before return
                      (ration/src/main.s):00027         ; DOC-002 source-contract mirror profile movement Inputs: Current actor coordinates, direction, maze topology, gate state, and collision state
                      (ration/src/main.s):00028         ; DOC-002 source-contract mirror profile movement Outputs: A legality result, selected direction, contact result, or updated actor state
                      (ration/src/main.s):00029         ; DOC-002 source-contract mirror profile movement Clobbers: A, B, D, X, Y, U, and condition codes unless a narrower source-local header is present
                      (ration/src/main.s):00030         ; DOC-002 source-contract mirror profile movement Reads: Authoritative actor records, maze and gate tables, and movement scratch
                      (ration/src/main.s):00031         ; DOC-002 source-contract mirror profile movement Writes: Owned actor state, collision flags, and render intents required by the movement result
                      (ration/src/main.s):00032         ; DOC-002 source-contract mirror profile movement Side effects: May change authoritative gameplay state and queue later composition
                      (ration/src/main.s):00033         ; DOC-002 source-contract mirror profile movement Invariants: Movement remains on legal semantic cells and does not write framebuffer pixels directly
                      (ration/src/main.s):00034         ; DOC-002 source-contract mirror profile render Inputs: Current render intent, selected actor or tile state, and a valid BACK or staging destination
                      (ration/src/main.s):00035         ; DOC-002 source-contract mirror profile render Outputs: Updated destination pixels and any owner-local history required by later restoration
                      (ration/src/main.s):00036         ; DOC-002 source-contract mirror profile render Clobbers: A, B, D, X, Y, U, and condition codes unless a narrower source-local header is present
                      (ration/src/main.s):00037         ; DOC-002 source-contract mirror profile render Reads: Authoritative gameplay state, immutable art streams, and current owner-local background metadata
                      (ration/src/main.s):00038         ; DOC-002 source-contract mirror profile render Writes: BACK or staging pixels, render scratch, and owner-local save-under or damage metadata
                      (ration/src/main.s):00039         ; DOC-002 source-contract mirror profile render Side effects: Changes a non-visible composition surface or its metadata
                      (ration/src/main.s):00040         ; DOC-002 source-contract mirror profile render Invariants: The routine never selects the visible FRONT surface; temporary PAR5 mappings expire or restore before return
                      (ration/src/main.s):00041         ; DOC-002 source-contract mirror profile root Inputs: Entry-specific machine state and the shared direct-page protocol named by the routine purpose
                      (ration/src/main.s):00042         ; DOC-002 source-contract mirror profile root Outputs: Control transfers or status values defined by the routine purpose
                      (ration/src/main.s):00043         ; DOC-002 source-contract mirror profile root Clobbers: A, B, D, X, Y, U, and condition codes unless the caller-facing entry contract states otherwise
                      (ration/src/main.s):00044         ; DOC-002 source-contract mirror profile root Reads: Always-mapped direct-page protocol state plus the module-owned state required by the selected operation
                      (ration/src/main.s):00045         ; DOC-002 source-contract mirror profile root Writes: Module-owned state and mapped hardware registers required to establish or dispatch the operation
                      (ration/src/main.s):00046         ; DOC-002 source-contract mirror profile root Side effects: May change mapping, interrupt, rendering, or lifecycle ownership as stated by the routine purpose
                      (ration/src/main.s):00047         ; DOC-002 source-contract mirror profile root Invariants: The stack remains balanced and every temporary PAR mapping is restored or deliberately handed off before return
                      (ration/src/main.s):00048         ; DOC-002 source-contract mirror profile state Inputs: Current authoritative gameplay or presentation state; register arguments are named by the routine label and immediate caller
                      (ration/src/main.s):00049         ; DOC-002 source-contract mirror profile state Outputs: Updated authoritative state and condition codes used by the immediate caller
                      (ration/src/main.s):00050         ; DOC-002 source-contract mirror profile state Clobbers: A, B, D, X, Y, U, and condition codes unless a narrower source-local header is present
                      (ration/src/main.s):00051         ; DOC-002 source-contract mirror profile state Reads: Owned direct-page and page-$34 state needed for the operation
                      (ration/src/main.s):00052         ; DOC-002 source-contract mirror profile state Writes: Only the owned state fields and render intents required by the operation
                      (ration/src/main.s):00053         ; DOC-002 source-contract mirror profile state Side effects: May enqueue rendering work but does not publish FRONT
                      (ration/src/main.s):00054         ; DOC-002 source-contract mirror profile state Invariants: Authoritative state changes precede their render intents; framebuffer publication remains IRQ-owned
