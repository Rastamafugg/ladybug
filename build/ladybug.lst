C817 7FFF00           (adybug/src/main.s):01454                 clr     PIA1_DA         ; all PA bits input, including comparator PA7
C81A 7FFF03           (adybug/src/main.s):01455                 clr     PIA1_CRB        ; select PIA1 PB direction register
C81D 86FF             (adybug/src/main.s):01456                 lda     #$FF
