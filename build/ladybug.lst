                      (adybug/src/main.s):00282         ; entry
                      (adybug/src/main.s):00283         ;==============================================================================
C002 1A50             (adybug/src/main.s):00284         entry   orcc    #$50            ; mask IRQ + FIRQ
C004 10CE1FFE         (adybug/src/main.s):00285                 lds     #$1FFE          ; stack at top of low RAM page
                      (adybug/src/main.s):00286         
C008 4F               (adybug/src/main.s):00287                 clra                    ; DP = $00, shared with bank-3 runtime
C009 1F8B             (adybug/src/main.s):00288                 tfr     a,dp
                      (adybug/src/main.s):00289         
                      (adybug/src/main.s):00290                 ; --- Quiet legacy PIA interrupts ---
C00B 4F               (adybug/src/main.s):00291                 clra
C00C B7FF01           (adybug/src/main.s):00292                 sta     PIA1_CRA
C00F B7FF03           (adybug/src/main.s):00293                 sta     PIA1_CRB
C012 B7FF21           (adybug/src/main.s):00294                 sta     PIA2_CRA
C015 B7FF23           (adybug/src/main.s):00295                 sta     PIA2_CRB
C018 B6FF00           (adybug/src/main.s):00296                 lda     PIA1_DA
C01B B6FF02           (adybug/src/main.s):00297                 lda     PIA1_DB
