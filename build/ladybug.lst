C96D B7FF23           (adybug/src/main.s):01692                 sta     PIA2_CRB
C970 8680             (adybug/src/main.s):01693                 lda     #$80            ; centre DAC while idle
C972 B7FF20           (adybug/src/main.s):01694                 sta     PIA2_DA
C975 39               (adybug/src/main.s):01695                 rts
