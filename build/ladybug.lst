                      (andoff/src/main.s):01851         ;
                      (andoff/src/main.s):01852         ; Returns:
                      (andoff/src/main.s):01853         ;   A, CC — undefined
                      (andoff/src/main.s):01854         ;
                      (andoff/src/main.s):01855         ; Side effects:
                      (andoff/src/main.s):01856         ;   Configures PIA1 PA as input, PIA1 PB as output, PIA2 PA7-PA2 as DAC
                      (andoff/src/main.s):01857         ;   output, and selects/enables the right joystick analog multiplexer.
                      (andoff/src/main.s):01858         ;==============================================================================
