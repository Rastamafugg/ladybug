     0087             (adybug/src/main.s):00124         ENEMY_RENDER_FLAGS equ $0087   ; bank-3 renderer intents
     0088             (adybug/src/main.s):00125         RENDER_GATE_ID equ $0088       ; first queued gate ID+1
     0089             (adybug/src/main.s):00126         RENDER_GATE_MODE equ $0089     ; first queued gate mode
     008A             (adybug/src/main.s):00127         RENDER_GATE2_ID equ $008A      ; optional second gate ID+1
