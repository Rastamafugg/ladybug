                      (adybug/src/main.s):01524         ; init_joystick — configure the PIAs for right-joystick DAC conversion.
                      (adybug/src/main.s):01525         ;
                      (adybug/src/main.s):01526         ; Inputs:
                      (adybug/src/main.s):01527         ;   None
                      (adybug/src/main.s):01528         ;
                      (adybug/src/main.s):01529         ; Returns:
                      (adybug/src/main.s):01530         ;   A, CC — undefined
                      (adybug/src/main.s):01531         ;
                      (adybug/src/main.s):01532         ; Side effects:
                      (adybug/src/main.s):01533         ;   Configures PIA1 PA as input, PIA1 PB as output, PIA2 PA7-PA2 as DAC
                      (adybug/src/main.s):01534         ;   output, and selects/enables the right joystick analog multiplexer.
                      (adybug/src/main.s):01535         ;==============================================================================
