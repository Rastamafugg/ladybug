                      (adybug/src/main.s):00001         ;==============================================================================
                      (adybug/src/main.s):00002         ; Ladybug — main.s
                      (adybug/src/main.s):00003         ;==============================================================================
                      (adybug/src/main.s):00004         ; Phase 4: joystick-driven Lady Bug movement over the authored screen.
                      (adybug/src/main.s):00005         ;
                      (adybug/src/main.s):00006         ; Builds on Phase 2.3 (hi-res 320×192×16 + MMU + palette + IRQ tick) by:
                      (adybug/src/main.s):00007         ;   - Compiling tiled/coco-screen.tmx into a one-byte tile map and a
                      (adybug/src/main.s):00008         ;     deduplicated packed 4bpp tile atlas before assembly.
                      (adybug/src/main.s):00009         ;   - Flattening visible Tiled layers and applying horizontal/vertical flips.
                      (adybug/src/main.s):00010         ;   - blit_tile: 8 rows x 4 bytes, stride 160.
                      (adybug/src/main.s):00011         ;   - Polling the right joystick through the PIA DAC/comparator path.
                      (adybug/src/main.s):00012         ;   - Transparent 16x16 player frames with background save/restore.
                      (adybug/src/main.s):00013         ;   - Semantic maze collision and dot removal.
                      (adybug/src/main.s):00014         ;
                      (adybug/src/main.s):00015         ; Visible: the authored screen with a moving, maze-constrained Lady Bug.
                      (adybug/src/main.s):00016         ;==============================================================================
                      (adybug/src/main.s):00017         
                      (adybug/src/main.s):00018                 pragma  nodollarlocal,6809
                      (adybug/src/main.s):00019         
                      (adybug/src/main.s):00020         ;------------------------------------------------------------------------------
                      (adybug/src/main.s):00021         ; DP allocation (page $02)
                      (adybug/src/main.s):00022         ;------------------------------------------------------------------------------
     02               (adybug/src/main.s):00023                 setdp   $02
                      (adybug/src/main.s):00024         
     0200             (adybug/src/main.s):00025         LAST_FRAME    equ $0200         ; last processed Vbord counter low byte
     0201             (adybug/src/main.s):00026         JOY_X         equ $0201         ; right joystick X, 0..63
     0202             (adybug/src/main.s):00027         FRAMES        equ $0202         ; u16 frame counter
     0204             (adybug/src/main.s):00028         JOY_Y         equ $0204         ; right joystick Y, 0..63
     0205             (adybug/src/main.s):00029         JOY_DIR       equ $0205         ; requested direction or $FF
     0206             (adybug/src/main.s):00030         PLAYER_DIR    equ $0206         ; active direction or $FF
     0207             (adybug/src/main.s):00031         PLAYER_FACE   equ $0207         ; last active direction, 0..3
     0208             (adybug/src/main.s):00032         PLAYER_STEP   equ $0208         ; 2-pixel steps since last cell centre, 0..3
     0209             (adybug/src/main.s):00033         PLAYER_CELL_X equ $0209         ; semantic maze column
     020A             (adybug/src/main.s):00034         PLAYER_CELL_Y equ $020A         ; semantic maze row
     020B             (adybug/src/main.s):00035         PLAYER_FB     equ $020B         ; u16 framebuffer pointer at sprite top-left
     020D             (adybug/src/main.s):00036         JOY_DX        equ $020D         ; absolute X displacement from centre
     020E             (adybug/src/main.s):00037         JOY_DY        equ $020E         ; absolute Y displacement from centre
     020F             (adybug/src/main.s):00038         PLAYER_WANT   equ $020F         ; last non-neutral requested direction
     0210             (adybug/src/main.s):00039         TEST_X        equ $0210         ; candidate/draw maze column
     0211             (adybug/src/main.s):00040         TEST_Y        equ $0211         ; candidate/draw maze row
     0212             (adybug/src/main.s):00041         TEST_DIR      equ $0212         ; direction under collision test
     0213             (adybug/src/main.s):00042         GATE_ID       equ $0213         ; active gate index
     0214             (adybug/src/main.s):00043         GATE_X        equ $0214         ; active gate pivot column
     0215             (adybug/src/main.s):00044         GATE_Y        equ $0215         ; active gate pivot row
     0216             (adybug/src/main.s):00045         DRAW_COUNT    equ $0216         ; gate redraw loop counter
     0217             (adybug/src/main.s):00046         DRAW_TILE     equ $0217         ; tile ID for draw_cell_tile
     0218             (adybug/src/main.s):00047         PLAYER_MANUAL equ $0218         ; nonzero after first directional input
     0219             (adybug/src/main.s):00048         GATE_ANIM_ID  equ $0219         ; rotating gate ID+1; zero when idle
     021A             (adybug/src/main.s):00049         GATE_ANIM_STYLE equ $021A       ; 0=slash, 1=backslash
     021B             (adybug/src/main.s):00050         BLIT_ROWS     equ $021B         ; transparent-blit row counter
     021C             (adybug/src/main.s):00051         BLIT_WIDTH    equ $021C         ; transparent-blit bytes per row
     021D             (adybug/src/main.s):00052         SCORE_BCD     equ $021D         ; packed BCD score, six digits
     0220             (adybug/src/main.s):00053         HIGH_BCD      equ $0220         ; packed BCD session high score
     0223             (adybug/src/main.s):00054         LIVES         equ $0223         ; lives remaining
     0224             (adybug/src/main.s):00055         STAGE         equ $0224         ; current stage, 1..255
     0225             (adybug/src/main.s):00056         DOTS_LEFT     equ $0225         ; remaining flowers in this stage
     0226             (adybug/src/main.s):00057         STAGE_PENDING equ $0226         ; nonzero requests a stage transition
     0227             (adybug/src/main.s):00058         HUD_X         equ $0227         ; HUD tile column scratch
     0228             (adybug/src/main.s):00059         HUD_Y         equ $0228         ; HUD tile row scratch
     0229             (adybug/src/main.s):00060         HUD_COLOR     equ $0229         ; palette index for digit rendering
     022A             (adybug/src/main.s):00061         HUD_BYTE      equ $022A         ; packed BCD / mask scratch
     022B             (adybug/src/main.s):00062         HUD_COUNT     equ $022B         ; byte/row loop scratch
     022C             (adybug/src/main.s):00063         HUD_WIDTH     equ $022C         ; packed-byte loop scratch
     022D             (adybug/src/main.s):00064         HUD_BCD_BYTE  equ $022D         ; preserved BCD byte during digit blits
     022E             (adybug/src/main.s):00065         HUD_BCD_COUNT equ $022E         ; packed BCD byte loop
     022F             (adybug/src/main.s):00066         BONUS_COLOR   equ $022F         ; global bonus colour, palette index
     0230             (adybug/src/main.s):00067         BONUS_TIMER   equ $0230         ; u16 frames remaining in current colour
     0232             (adybug/src/main.s):00068         ENTITY_COUNT  equ $0232         ; active entity-table record count
     0233             (adybug/src/main.s):00069         BONUS_LEFT    equ $0233         ; uncollected hearts and letters
     0234             (adybug/src/main.s):00070         RNG_STATE     equ $0234         ; u16 placement LFSR
     0236             (adybug/src/main.s):00071         ENTITY_X      equ $0236         ; entity/draw scratch
     0237             (adybug/src/main.s):00072         ENTITY_Y      equ $0237
     0238             (adybug/src/main.s):00073         ENTITY_TYPE   equ $0238
     0239             (adybug/src/main.s):00074         ENTITY_VARIANT equ $0239
     023A             (adybug/src/main.s):00075         DEATH_TIMER   equ $023A         ; nonzero while rotating death animation runs
     023B             (adybug/src/main.s):00076         MULTIPLIER    equ $023B         ; score multiplier: 1,2,3,5
     023C             (adybug/src/main.s):00077         SPECIAL_BITS equ $023C         ; collected SPECIAL letters, bit per HUD position
     023D             (adybug/src/main.s):00078         EXTRA_BITS   equ $023D         ; collected EXTRA letters, bit per HUD position
     023E             (adybug/src/main.s):00079         ENTITY_PTR   equ $023E         ; u16 current entity record pointer
     0240             (adybug/src/main.s):00080         OBJ_SOURCE   equ $0240         ; u16 object-mask source pointer
     0242             (adybug/src/main.s):00081         OBJ_ROWS     equ $0242
     0243             (adybug/src/main.s):00082         OBJ_BYTES    equ $0243
     0244             (adybug/src/main.s):00083         OBJ_VALUE    equ $0244
     0245             (adybug/src/main.s):00084         OBJ_INDEX    equ $0245
     0246             (adybug/src/main.s):00085         OBJ_PRIMARY  equ $0246
     0247             (adybug/src/main.s):00086         OBJ_ACCENT   equ $0247
     0248             (adybug/src/main.s):00087         ENTITY_WORK  equ $0248         ; entity placement / loop scratch
     0249             (adybug/src/main.s):00088         ENTITY_TOTAL equ $0249         ; total records allocated this stage
     024A             (adybug/src/main.s):00089         BOX_TIMER    equ $024A         ; frames until next perimeter-box update
     024B             (adybug/src/main.s):00090         BOX_INDEX    equ $024B         ; clockwise perimeter position, 0..91
     024C             (adybug/src/main.s):00091         BOX_PHASE    equ $024C         ; 0=White-to-Green, 1=Green-to-White
     024D             (adybug/src/main.s):00092         DEATH_STATE  equ $024D         ; 0=alive, 1=shrink, 2=wings, 3=walk-off
     024E             (adybug/src/main.s):00093         DEATH_FRAME  equ $024E         ; selected curated death frame
     024F             (adybug/src/main.s):00094         PLAYER_ANIM  equ $024F         ; walk animation phase 0,1,2,3
     0250             (adybug/src/main.s):00095         PLAYER_ANIM_TIMER equ $0250    ; Vbord countdown to next player frame
     0251             (adybug/src/main.s):00096         PICKUP_TIMER equ $0251         ; score-sprite hold; zero when inactive
     0252             (adybug/src/main.s):00097         PICKUP_FRAME equ $0252         ; 0=100, 1=300, 2=800
     0253             (adybug/src/main.s):00098         ANGEL_SWING  equ $0253         ; 20-frame eased angel-swoop phase
     0254             (adybug/src/main.s):00099         ENEMY_ANIM   equ $0254         ; first den enemy animation phase
     0255             (adybug/src/main.s):00100         ENEMY_TIMER  equ $0255         ; Vbord countdown to next enemy frame
     0256             (adybug/src/main.s):00101         TURN_SNAP    equ $0256         ; diagonal late-turn updates remaining, 0..3
     0257             (adybug/src/main.s):00102         TURN_OLD     equ $0257         ; direction being corrected during late turn
     02F0             (adybug/src/main.s):00103         BOOT_FLAG    equ $02F0         ; $A5 when GMC bootstrap relocated runtime to RAM
                      (adybug/src/main.s):00104         
     0000             (adybug/src/main.s):00105         DIR_NORTH     equ 0
     0001             (adybug/src/main.s):00106         DIR_EAST      equ 1
     0002             (adybug/src/main.s):00107         DIR_SOUTH     equ 2
     0003             (adybug/src/main.s):00108         DIR_WEST      equ 3
     00FF             (adybug/src/main.s):00109         DIR_NONE      equ $FF
     001E             (adybug/src/main.s):00110         PICKUP_HOLD_FRAMES equ 30      ; measured MAME frames 705-734 inclusive
                      (adybug/src/main.s):00111         
     0001             (adybug/src/main.s):00112         COLOR_RED         equ 1
     0002             (adybug/src/main.s):00113         COLOR_YELLOW      equ 2
     0008             (adybug/src/main.s):00114         COLOR_LIGHT_GREEN equ 8
     0003             (adybug/src/main.s):00115         COLOR_BLUE        equ 3
     0004             (adybug/src/main.s):00116         COLOR_PINK        equ 4
     0005             (adybug/src/main.s):00117         COLOR_GREEN       equ 5
     0006             (adybug/src/main.s):00118         COLOR_WHITE       equ 6
                      (adybug/src/main.s):00119         
     0000             (adybug/src/main.s):00120         ENTITY_NONE       equ 0
     0001             (adybug/src/main.s):00121         ENTITY_SKULL      equ 1
     0002             (adybug/src/main.s):00122         ENTITY_HEART      equ 2
     0003             (adybug/src/main.s):00123         ENTITY_LETTER     equ 3
                      (adybug/src/main.s):00124         
     0000             (adybug/src/main.s):00125         OBJECT_SKULL      equ 0
     0001             (adybug/src/main.s):00126         OBJECT_HEART      equ 1
     0002             (adybug/src/main.s):00127         OBJECT_A          equ 2
     0003             (adybug/src/main.s):00128         OBJECT_C          equ 3
     0004             (adybug/src/main.s):00129         OBJECT_E          equ 4
     0005             (adybug/src/main.s):00130         OBJECT_I          equ 5
     0006             (adybug/src/main.s):00131         OBJECT_L          equ 6
     0007             (adybug/src/main.s):00132         OBJECT_P          equ 7
     0008             (adybug/src/main.s):00133         OBJECT_R          equ 8
     0009             (adybug/src/main.s):00134         OBJECT_S          equ 9
     000A             (adybug/src/main.s):00135         OBJECT_T          equ 10
     000B             (adybug/src/main.s):00136         OBJECT_X          equ 11
                      (adybug/src/main.s):00137         
                      (adybug/src/main.s):00138         ;------------------------------------------------------------------------------
                      (adybug/src/main.s):00139         ; Hardware
                      (adybug/src/main.s):00140         ;------------------------------------------------------------------------------
     FF00             (adybug/src/main.s):00141         PIA1_DA    equ  $FF00
     FF01             (adybug/src/main.s):00142         PIA1_CRA   equ  $FF01
     FF02             (adybug/src/main.s):00143         PIA1_DB    equ  $FF02
     FF03             (adybug/src/main.s):00144         PIA1_CRB   equ  $FF03
     FF20             (adybug/src/main.s):00145         PIA2_DA    equ  $FF20
     FF21             (adybug/src/main.s):00146         PIA2_CRA   equ  $FF21
     FF22             (adybug/src/main.s):00147         PIA2_DB    equ  $FF22
     FF23             (adybug/src/main.s):00148         PIA2_CRB   equ  $FF23
                      (adybug/src/main.s):00149         
     FF90             (adybug/src/main.s):00150         GIME_INIT0 equ  $FF90
     FF92             (adybug/src/main.s):00151         GIME_IRQEN equ  $FF92
     FF98             (adybug/src/main.s):00152         GIME_VMODE equ  $FF98
     FF99             (adybug/src/main.s):00153         GIME_VRES  equ  $FF99
     FF9A             (adybug/src/main.s):00154         GIME_BORDER equ $FF9A
     FF9D             (adybug/src/main.s):00155         GIME_VOFF1 equ  $FF9D           ; addr bits Y18..Y11
     FF9E             (adybug/src/main.s):00156         GIME_VOFF0 equ  $FF9E           ; addr bits Y10..Y3
     FFA0             (adybug/src/main.s):00157         PAR_EXEC   equ  $FFA0           ; PAR0 of executive set ($FFA0..$FFA7)
     FFB0             (adybug/src/main.s):00158         PAL_BASE   equ  $FFB0
                      (adybug/src/main.s):00159         
     FFD9             (adybug/src/main.s):00160         SAM_FAST   equ  $FFD9
     FFDE             (adybug/src/main.s):00161         SAM_ROMRAM equ  $FFDE
                      (adybug/src/main.s):00162         
     FEF7             (adybug/src/main.s):00163         JT_IRQ     equ  $FEF7
                      (adybug/src/main.s):00164         
                      (adybug/src/main.s):00165         ;------------------------------------------------------------------------------
                      (adybug/src/main.s):00166         ; Memory map (post-Phase-2.3 with MMU on)
                      (adybug/src/main.s):00167         ;------------------------------------------------------------------------------
     2000             (adybug/src/main.s):00168         FB_VIRT    equ  $2000           ; virtual base of framebuffer (PAR1)
     9800             (adybug/src/main.s):00169         FB_END     equ  $9800           ; one past last FB byte (192 rows × 160 B)
     0030             (adybug/src/main.s):00170         FB_PHYS    equ  $30             ; physical page 0 of FB
     A000             (adybug/src/main.s):00171         MAZE_STATE equ  $A000           ; writable 576-byte maze-cell copy (PAR5)
     A240             (adybug/src/main.s):00172         GATE_STATE equ  $A240           ; rotation state N/W/S/E; parity selects H/V bar
     A300             (adybug/src/main.s):00173         PLAYER_BG  equ  $A300           ; 128-byte saved background under player
     A380             (adybug/src/main.s):00174         ENTITY_TABLE equ $A380          ; twelve x/y/type/variant records
     A3B0             (adybug/src/main.s):00175         PICKUP_BG   equ $A3B0          ; 64-byte background below score popup
     A3F0             (adybug/src/main.s):00176         ENEMY_BG    equ $A3F0          ; 128-byte background under first den enemy
     57EC             (adybug/src/main.s):00177         ENEMY_FB    equ $57EC          ; top-left at lower nest cell (12,12)
                      (adybug/src/main.s):00178         
                      (adybug/src/main.s):00179         ;==============================================================================
                      (adybug/src/main.s):00180         ;  Cart ROM
                      (adybug/src/main.s):00181         ;==============================================================================
                      (adybug/src/main.s):00182                 org     $C000
                      (adybug/src/main.s):00183         
C000 444B             (adybug/src/main.s):00184                 fcc     "DK"            ; ROM-pack autostart magic; FIRQ -> $C002
                      (adybug/src/main.s):00185         
                      (adybug/src/main.s):00186         ;==============================================================================
                      (adybug/src/main.s):00187         ; entry
                      (adybug/src/main.s):00188         ;==============================================================================
C002 1A50             (adybug/src/main.s):00189         entry   orcc    #$50            ; mask IRQ + FIRQ
C004 10CE1FFE         (adybug/src/main.s):00190                 lds     #$1FFE          ; stack at top of low RAM page
                      (adybug/src/main.s):00191         
C008 8602             (adybug/src/main.s):00192                 lda     #$02            ; DP = $02
C00A 1F8B             (adybug/src/main.s):00193                 tfr     a,dp
                      (adybug/src/main.s):00194         
                      (adybug/src/main.s):00195                 ; --- Quiet legacy PIA interrupts ---
C00C 4F               (adybug/src/main.s):00196                 clra
C00D B7FF01           (adybug/src/main.s):00197                 sta     PIA1_CRA
C010 B7FF03           (adybug/src/main.s):00198                 sta     PIA1_CRB
C013 B7FF21           (adybug/src/main.s):00199                 sta     PIA2_CRA
C016 B7FF23           (adybug/src/main.s):00200                 sta     PIA2_CRB
C019 B6FF00           (adybug/src/main.s):00201                 lda     PIA1_DA
C01C B6FF02           (adybug/src/main.s):00202                 lda     PIA1_DB
C01F B6FF20           (adybug/src/main.s):00203                 lda     PIA2_DA
C022 B6FF22           (adybug/src/main.s):00204                 lda     PIA2_DB
                      (adybug/src/main.s):00205         
                      (adybug/src/main.s):00206                 ; --- Init0 — legacy mode, ACVC IRQ on, force $FExx, MMU still off ---
C025 86A8             (adybug/src/main.s):00207                 lda     #%10101000
C027 B7FF90           (adybug/src/main.s):00208                 sta     GIME_INIT0
C02A 96F0             (adybug/src/main.s):00209                 lda     BOOT_FLAG
C02C 81A5             (adybug/src/main.s):00210                 cmpa    #$A5
C02E 2703             (adybug/src/main.s):00211                 beq     entry_ram_loaded
C030 B7FFDE           (adybug/src/main.s):00212                 sta     SAM_ROMRAM       ; plain-cart fallback selects TY=0
C033                  (adybug/src/main.s):00213         entry_ram_loaded
                      (adybug/src/main.s):00214         
                      (adybug/src/main.s):00215                 ; --- Enter runtime from direct ROM or GMC-loaded RAM ---
                      (adybug/src/main.s):00216                 ; Direct fallback keeps TY=0. XRoar discards writes to the selected cartridge window,
                      (adybug/src/main.s):00217                 ; so the former same-address self-copy never populated phys $3E-$3F.
                      (adybug/src/main.s):00218                 ; PAR6=$3E keeps $C000-$DFFF cartridge-backed after MMU enable while
                      (adybug/src/main.s):00219                 ; the framebuffer and writable state use ordinary RAM pages below $3C.
                      (adybug/src/main.s):00220         
                      (adybug/src/main.s):00221                 ; --- Force executive PAR set ($FFA0-$FFA7) to be active ---
C033 7FFF91           (adybug/src/main.s):00222                 clr     $FF91
                      (adybug/src/main.s):00223         
                      (adybug/src/main.s):00224                 ; --- Set up MMU PARs (executive set) ---
                      (adybug/src/main.s):00225                 ; PAR0 ($0000) = phys $38   low RAM (DP, stack)
                      (adybug/src/main.s):00226                 ; PAR1 ($2000) = phys $30   FB page 0
                      (adybug/src/main.s):00227                 ; PAR2 ($4000) = phys $31   FB page 1
                      (adybug/src/main.s):00228                 ; PAR3 ($6000) = phys $32   FB page 2
                      (adybug/src/main.s):00229                 ; PAR4 ($8000) = phys $33   FB page 3
                      (adybug/src/main.s):00230                 ; PAR5 ($A000) = phys $34   game state (Phase 4+)
                      (adybug/src/main.s):00231                 ; PAR6 ($C000) = phys $3E   cartridge code (current 8 K window)
                      (adybug/src/main.s):00232                 ; PAR7 ($E000) = phys $3F   cartridge/ROM window + IO + jump table
C036 308D134E         (adybug/src/main.s):00233                 leax    par_table,pcr
C03A 108EFFA0         (adybug/src/main.s):00234                 ldy     #PAR_EXEC
C03E C608             (adybug/src/main.s):00235                 ldb     #8
C040 A680             (adybug/src/main.s):00236         parloop lda     ,x+
C042 A7A0             (adybug/src/main.s):00237                 sta     ,y+
C044 5A               (adybug/src/main.s):00238                 decb
C045 26F9             (adybug/src/main.s):00239                 bne     parloop
                      (adybug/src/main.s):00240         
                      (adybug/src/main.s):00241                 ; --- Fast clock 1.78 MHz ---
C047 B7FFD9           (adybug/src/main.s):00242                 sta     SAM_FAST
                      (adybug/src/main.s):00243         
                      (adybug/src/main.s):00244                 ; --- Set up display (still blanked via CRES=11) ---
C04A 8680             (adybug/src/main.s):00245                 lda     #%10000000      ; BP=1 (graphics)
C04C B7FF98           (adybug/src/main.s):00246                 sta     GIME_VMODE
                      (adybug/src/main.s):00247         
C04F 861F             (adybug/src/main.s):00248                 lda     #$1F            ; VRES=00 HRES=111 CRES=11 (BLANKED)
C051 B7FF99           (adybug/src/main.s):00249                 sta     GIME_VRES
                      (adybug/src/main.s):00250         
C054 7FFF9A           (adybug/src/main.s):00251                 clr     GIME_BORDER     ; canonical Black outside the active framebuffer
                      (adybug/src/main.s):00252         
                      (adybug/src/main.s):00253                 ; FB at phys $30 → physical address $060000.
                      (adybug/src/main.s):00254                 ;   Y18=1, Y17=1, Y16..Y3 = 0
                      (adybug/src/main.s):00255                 ;   V1 ($FF9D) = Y18..Y11 = %11000000 = $C0
                      (adybug/src/main.s):00256                 ;   V0 ($FF9E) = Y10..Y3  = $00
C057 86C0             (adybug/src/main.s):00257                 lda     #$C0
C059 B7FF9D           (adybug/src/main.s):00258                 sta     GIME_VOFF1
C05C 7FFF9E           (adybug/src/main.s):00259                 clr     GIME_VOFF0
                      (adybug/src/main.s):00260         
                      (adybug/src/main.s):00261                 ; --- Init0 — turn on MMU + switch to hi-res. Display still blanked. ---
                      (adybug/src/main.s):00262                 ; %01101000 = COCO=0 MMU=1 ACVCIRQ=1 ACVCFIRQ=0 force-$FExx=1 SCS=0 ROMmap=00
C05F 8668             (adybug/src/main.s):00263                 lda     #%01101000
C061 B7FF90           (adybug/src/main.s):00264                 sta     GIME_INIT0
                      (adybug/src/main.s):00265         
                      (adybug/src/main.s):00266                 ; --- Load palette (16 entries) ---
C064 308D1F98         (adybug/src/main.s):00267                 leax    palette_table,pcr
C068 108EFFB0         (adybug/src/main.s):00268                 ldy     #PAL_BASE
C06C C610             (adybug/src/main.s):00269                 ldb     #16
