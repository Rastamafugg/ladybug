                      (adybug/src/main.s):01451         ; init_joystick — configure the PIAs for right-joystick DAC conversion.
                      (adybug/src/main.s):01452         ;
                      (adybug/src/main.s):01453         ; Inputs:
                      (adybug/src/main.s):01454         ;   None
                      (adybug/src/main.s):01455         ;
                      (adybug/src/main.s):01456         ; Returns:
                      (adybug/src/main.s):01457         ;   A, CC — undefined
                      (adybug/src/main.s):01458         ;
                      (adybug/src/main.s):01459         ; Side effects:
                      (adybug/src/main.s):01460         ;   Configures PIA1 PA as input, PIA1 PB as output, PIA2 PA7-PA2 as DAC
                      (adybug/src/main.s):01461         ;   output, and selects/enables the right joystick analog multiplexer.
                      (adybug/src/main.s):01462         ;==============================================================================
C87F                  (adybug/src/main.s):01463         init_joystick
C87F 7FFF01           (adybug/src/main.s):01464                 clr     PIA1_CRA        ; select PIA1 PA direction register
C882 7FFF00           (adybug/src/main.s):01465                 clr     PIA1_DA         ; all PA bits input, including comparator PA7
C885 7FFF03           (adybug/src/main.s):01466                 clr     PIA1_CRB        ; select PIA1 PB direction register
C888 86FF             (adybug/src/main.s):01467                 lda     #$FF
C88A B7FF02           (adybug/src/main.s):01468                 sta     PIA1_DB         ; keyboard columns/output side
C88D 8634             (adybug/src/main.s):01469                 lda     #$34            ; data register, static CA2/CB2 output low
C88F B7FF01           (adybug/src/main.s):01470                 sta     PIA1_CRA
