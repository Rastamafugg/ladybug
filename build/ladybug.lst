                      (adybug/src/main.s):02543         ; blit_tile — copy an 8x8 tile to a framebuffer byte address.
                      (adybug/src/main.s):02544         ;
                      (adybug/src/main.s):02545         ; Inputs:
                      (adybug/src/main.s):02546         ;   X — destination framebuffer byte address
                      (adybug/src/main.s):02547         ;   Y — source glyph data, 32 packed 4bpp bytes
                      (adybug/src/main.s):02548         ;
                      (adybug/src/main.s):02549         ; Returns:
                      (adybug/src/main.s):02550         ;   A, B, D, X, Y, U, CC — undefined
                      (adybug/src/main.s):02551         ;
                      (adybug/src/main.s):02552         ; Side effects:
                      (adybug/src/main.s):02553         ;   Writes 8 rows x 4 bytes; advances 156 bytes after each written row.
                      (adybug/src/main.s):02554         ;==============================================================================
CEBC                  (adybug/src/main.s):02555         blit_tile
                      (adybug/src/main.s):02556                 ; ldd ,y++ clobbers B, so use a Y-vs-sentinel loop instead of decb.
                      (adybug/src/main.s):02557                 ; See wiki/internal/implementation/lessons-learned.html
                      (adybug/src/main.s):02558                 ; §"LDD ,Y++ clobbers B".
CEBC 3440             (adybug/src/main.s):02559                 pshs    u
CEBE 33A820           (adybug/src/main.s):02560                 leau    32,y            ; sentinel = end of tile data
