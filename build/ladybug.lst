                      (adybug/src/main.s):01456         ; init_joystick — configure the PIAs for right-joystick DAC conversion.
                      (adybug/src/main.s):01457         ;
                      (adybug/src/main.s):01458         ; Inputs:
                      (adybug/src/main.s):01459         ;   None
                      (adybug/src/main.s):01460         ;
                      (adybug/src/main.s):01461         ; Returns:
                      (adybug/src/main.s):01462         ;   A, CC — undefined
                      (adybug/src/main.s):01463         ;
                      (adybug/src/main.s):01464         ; Side effects:
                      (adybug/src/main.s):01465         ;   Configures PIA1 PA as input, PIA1 PB as output, PIA2 PA7-PA2 as DAC
                      (adybug/src/main.s):01466         ;   output, and selects/enables the right joystick analog multiplexer.
                      (adybug/src/main.s):01467         ;==============================================================================
C885                  (adybug/src/main.s):01468         init_joystick
C885 7FFF01           (adybug/src/main.s):01469                 clr     PIA1_CRA        ; select PIA1 PA direction register
C888 7FFF00           (adybug/src/main.s):01470                 clr     PIA1_DA         ; all PA bits input, including comparator PA7
C88B 7FFF03           (adybug/src/main.s):01471                 clr     PIA1_CRB        ; select PIA1 PB direction register
C88E 86FF             (adybug/src/main.s):01472                 lda     #$FF
C890 B7FF02           (adybug/src/main.s):01473                 sta     PIA1_DB         ; keyboard columns/output side
C893 8634             (adybug/src/main.s):01474                 lda     #$34            ; data register, static CA2/CB2 output low
C895 B7FF01           (adybug/src/main.s):01475                 sta     PIA1_CRA
