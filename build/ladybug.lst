                      (erf003/src/main.s):01818         ; init_joystick — configure the PIAs for right-joystick DAC conversion.
                      (erf003/src/main.s):01819         ;
                      (erf003/src/main.s):01820         ; Inputs:
                      (erf003/src/main.s):01821         ;   None
                      (erf003/src/main.s):01822         ;
                      (erf003/src/main.s):01823         ; Returns:
                      (erf003/src/main.s):01824         ;   A, CC — undefined
                      (erf003/src/main.s):01825         ;
                      (erf003/src/main.s):01826         ; Side effects:
                      (erf003/src/main.s):01827         ;   Configures PIA1 PA as input, PIA1 PB as output, PIA2 PA7-PA2 as DAC
                      (erf003/src/main.s):01828         ;   output, and selects/enables the right joystick analog multiplexer.
                      (erf003/src/main.s):01829         ;==============================================================================
CA20                  (erf003/src/main.s):01830         init_joystick
CA20 7FFF01           (erf003/src/main.s):01831                 clr     PIA1_CRA        ; select PIA1 PA direction register
CA23 7FFF00           (erf003/src/main.s):01832                 clr     PIA1_DA         ; all PA bits input, including comparator PA7
CA26 7FFF03           (erf003/src/main.s):01833                 clr     PIA1_CRB        ; select PIA1 PB direction register
CA29 86FF             (erf003/src/main.s):01834                 lda     #$FF
CA2B B7FF02           (erf003/src/main.s):01835                 sta     PIA1_DB         ; keyboard columns/output side
CA2E 8634             (erf003/src/main.s):01836                 lda     #$34            ; data register, static CA2/CB2 output low
CA30 B7FF01           (erf003/src/main.s):01837                 sta     PIA1_CRA
CA33 B7FF03           (erf003/src/main.s):01838                 sta     PIA1_CRB        ; selector 0 = right joystick X
                      (erf003/src/main.s):01839         
CA36 7FFF21           (erf003/src/main.s):01840                 clr     PIA2_CRA        ; select PIA2 PA direction register
CA39 86FC             (erf003/src/main.s):01841                 lda     #$FC
CA3B B7FF20           (erf003/src/main.s):01842                 sta     PIA2_DA         ; PA7-PA2 are the six-bit DAC
CA3E 8604             (erf003/src/main.s):01843                 lda     #$04            ; data-register access
CA40 B7FF21           (erf003/src/main.s):01844                 sta     PIA2_CRA
CA43 7FFF23           (erf003/src/main.s):01845                 clr     PIA2_CRB
CA46 8634             (erf003/src/main.s):01846                 lda     #$34            ; static CB2 low enables analog multiplexer
CA48 B7FF23           (erf003/src/main.s):01847                 sta     PIA2_CRB
CA4B 8680             (erf003/src/main.s):01848                 lda     #$80            ; centre DAC while idle
CA4D B7FF20           (erf003/src/main.s):01849                 sta     PIA2_DA
CA50 39               (erf003/src/main.s):01850                 rts
                      (erf003/src/main.s):01851         
