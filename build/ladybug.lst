C9F0 0F07             (ration/src/main.s):01989                 clr     PLAYER_FACE
C9F2 0F08             (ration/src/main.s):01990                 clr     PLAYER_STEP
C9F4 0F56             (ration/src/main.s):01991                 clr     TURN_SNAP
C9F6 86FF             (ration/src/main.s):01992                 lda     #DIR_NONE
