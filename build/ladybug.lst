                      (adybug/src/main.s):00001         ;==============================================================================
                      (adybug/src/main.s):00002         ; Ladybug — main.s
                      (adybug/src/main.s):00003         ;==============================================================================
                      (adybug/src/main.s):00004         ; Phase 4: joystick-driven Lady Bug movement over the authored screen.
                      (adybug/src/main.s):00005         ;
                      (adybug/src/main.s):00006         ; Builds on Phase 2.3 (hi-res 320×192×16 + MMU + palette + IRQ tick) by:
                      (adybug/src/main.s):00007         ;   - Compiling tiled/coco-screen.tmx into a one-byte tile map and a
                      (adybug/src/main.s):00008         ;     deduplicated packed 4bpp tile atlas before assembly.
                      (adybug/src/main.s):00009         ;   - Flattening visible Tiled layers and applying horizontal/vertical flips.
                      (adybug/src/main.s):00010         ;   - blit_tile: 8 rows x 4 bytes, stride 160.
                      (adybug/src/main.s):00011         ;   - Polling the right joystick through the PIA DAC/comparator path.
                      (adybug/src/main.s):00012         ;   - Masked 16x16 player frames with background save/restore.
                      (adybug/src/main.s):00013         ;   - Semantic maze collision and dot removal.
                      (adybug/src/main.s):00014         ;
                      (adybug/src/main.s):00015         ; Visible: the authored screen with a moving, maze-constrained Lady Bug.
                      (adybug/src/main.s):00016         ;==============================================================================
                      (adybug/src/main.s):00017         
                      (adybug/src/main.s):00018                 pragma  nodollarlocal,6809
                      (adybug/src/main.s):00019         
                      (adybug/src/main.s):00020         ;------------------------------------------------------------------------------
                      (adybug/src/main.s):00021         ; DP allocation (page $02)
                      (adybug/src/main.s):00022         ;------------------------------------------------------------------------------
     02               (adybug/src/main.s):00023                 setdp   $02
                      (adybug/src/main.s):00024         
     0200             (adybug/src/main.s):00025         LAST_FRAME    equ $0200         ; last processed Vbord counter low byte
     0201             (adybug/src/main.s):00026         JOY_X         equ $0201         ; right joystick X, 0..63
     0202             (adybug/src/main.s):00027         FRAMES        equ $0202         ; u16 frame counter
     0204             (adybug/src/main.s):00028         JOY_Y         equ $0204         ; right joystick Y, 0..63
     0205             (adybug/src/main.s):00029         JOY_DIR       equ $0205         ; requested direction or $FF
     0206             (adybug/src/main.s):00030         PLAYER_DIR    equ $0206         ; active direction or $FF
     0207             (adybug/src/main.s):00031         PLAYER_FACE   equ $0207         ; last active direction, 0..3
     0208             (adybug/src/main.s):00032         PLAYER_STEP   equ $0208         ; 2-pixel steps since last cell centre, 0..3
     0209             (adybug/src/main.s):00033         PLAYER_CELL_X equ $0209         ; semantic maze column
     020A             (adybug/src/main.s):00034         PLAYER_CELL_Y equ $020A         ; semantic maze row
     020B             (adybug/src/main.s):00035         PLAYER_FB     equ $020B         ; u16 framebuffer pointer at sprite top-left
     020D             (adybug/src/main.s):00036         JOY_DX        equ $020D         ; absolute X displacement from centre
     020E             (adybug/src/main.s):00037         JOY_DY        equ $020E         ; absolute Y displacement from centre
     020F             (adybug/src/main.s):00038         PLAYER_WANT   equ $020F         ; last non-neutral requested direction
     0210             (adybug/src/main.s):00039         TEST_X        equ $0210         ; candidate/draw maze column
     0211             (adybug/src/main.s):00040         TEST_Y        equ $0211         ; candidate/draw maze row
     0212             (adybug/src/main.s):00041         TEST_DIR      equ $0212         ; direction under collision test
     0213             (adybug/src/main.s):00042         GATE_ID       equ $0213         ; active gate index
     0214             (adybug/src/main.s):00043         GATE_X        equ $0214         ; active gate pivot column
     0215             (adybug/src/main.s):00044         GATE_Y        equ $0215         ; active gate pivot row
     0216             (adybug/src/main.s):00045         DRAW_COUNT    equ $0216         ; gate redraw loop counter
     0217             (adybug/src/main.s):00046         DRAW_TILE     equ $0217         ; tile ID for draw_cell_tile
     0218             (adybug/src/main.s):00047         PLAYER_MANUAL equ $0218         ; nonzero after first directional input
     0219             (adybug/src/main.s):00048         GATE_ANIM_ID  equ $0219         ; rotating gate ID+1; zero when idle
     021A             (adybug/src/main.s):00049         GATE_ANIM_STYLE equ $021A       ; 0=slash, 1=backslash
     021B             (adybug/src/main.s):00050         BLIT_ROWS     equ $021B         ; transparent-blit row counter
     021C             (adybug/src/main.s):00051         BLIT_WIDTH    equ $021C         ; transparent-blit bytes per row
                      (adybug/src/main.s):00052         
     0000             (adybug/src/main.s):00053         DIR_NORTH     equ 0
     0001             (adybug/src/main.s):00054         DIR_EAST      equ 1
     0002             (adybug/src/main.s):00055         DIR_SOUTH     equ 2
     0003             (adybug/src/main.s):00056         DIR_WEST      equ 3
     00FF             (adybug/src/main.s):00057         DIR_NONE      equ $FF
                      (adybug/src/main.s):00058         
                      (adybug/src/main.s):00059         ;------------------------------------------------------------------------------
                      (adybug/src/main.s):00060         ; Hardware
                      (adybug/src/main.s):00061         ;------------------------------------------------------------------------------
     FF00             (adybug/src/main.s):00062         PIA1_DA    equ  $FF00
     FF01             (adybug/src/main.s):00063         PIA1_CRA   equ  $FF01
     FF02             (adybug/src/main.s):00064         PIA1_DB    equ  $FF02
     FF03             (adybug/src/main.s):00065         PIA1_CRB   equ  $FF03
     FF20             (adybug/src/main.s):00066         PIA2_DA    equ  $FF20
     FF21             (adybug/src/main.s):00067         PIA2_CRA   equ  $FF21
     FF22             (adybug/src/main.s):00068         PIA2_DB    equ  $FF22
     FF23             (adybug/src/main.s):00069         PIA2_CRB   equ  $FF23
                      (adybug/src/main.s):00070         
     FF90             (adybug/src/main.s):00071         GIME_INIT0 equ  $FF90
     FF92             (adybug/src/main.s):00072         GIME_IRQEN equ  $FF92
     FF98             (adybug/src/main.s):00073         GIME_VMODE equ  $FF98
     FF99             (adybug/src/main.s):00074         GIME_VRES  equ  $FF99
     FF9A             (adybug/src/main.s):00075         GIME_BORDER equ $FF9A
     FF9D             (adybug/src/main.s):00076         GIME_VOFF1 equ  $FF9D           ; addr bits Y18..Y11
     FF9E             (adybug/src/main.s):00077         GIME_VOFF0 equ  $FF9E           ; addr bits Y10..Y3
     FFA0             (adybug/src/main.s):00078         PAR_EXEC   equ  $FFA0           ; PAR0 of executive set ($FFA0..$FFA7)
     FFB0             (adybug/src/main.s):00079         PAL_BASE   equ  $FFB0
                      (adybug/src/main.s):00080         
     FFD9             (adybug/src/main.s):00081         SAM_FAST   equ  $FFD9
     FFDE             (adybug/src/main.s):00082         SAM_ROMRAM equ  $FFDE
                      (adybug/src/main.s):00083         
     FEF7             (adybug/src/main.s):00084         JT_IRQ     equ  $FEF7
                      (adybug/src/main.s):00085         
                      (adybug/src/main.s):00086         ;------------------------------------------------------------------------------
                      (adybug/src/main.s):00087         ; Memory map (post-Phase-2.3 with MMU on)
                      (adybug/src/main.s):00088         ;------------------------------------------------------------------------------
     2000             (adybug/src/main.s):00089         FB_VIRT    equ  $2000           ; virtual base of framebuffer (PAR1)
     9800             (adybug/src/main.s):00090         FB_END     equ  $9800           ; one past last FB byte (192 rows × 160 B)
     0030             (adybug/src/main.s):00091         FB_PHYS    equ  $30             ; physical page 0 of FB
     A000             (adybug/src/main.s):00092         MAZE_STATE equ  $A000           ; writable 576-byte maze-cell copy (PAR5)
     A240             (adybug/src/main.s):00093         GATE_STATE equ  $A240           ; rotation state N/W/S/E; parity selects H/V bar
     A300             (adybug/src/main.s):00094         PLAYER_BG  equ  $A300           ; 128-byte saved background under player
                      (adybug/src/main.s):00095         
                      (adybug/src/main.s):00096         ;==============================================================================
                      (adybug/src/main.s):00097         ;  Cart ROM
                      (adybug/src/main.s):00098         ;==============================================================================
                      (adybug/src/main.s):00099                 org     $C000
                      (adybug/src/main.s):00100         
C000 444B             (adybug/src/main.s):00101                 fcc     "DK"            ; ROM-pack autostart magic; FIRQ -> $C002
                      (adybug/src/main.s):00102         
                      (adybug/src/main.s):00103         ;==============================================================================
                      (adybug/src/main.s):00104         ; entry
                      (adybug/src/main.s):00105         ;==============================================================================
C002 1A50             (adybug/src/main.s):00106         entry   orcc    #$50            ; mask IRQ + FIRQ
C004 10CE1FFE         (adybug/src/main.s):00107                 lds     #$1FFE          ; stack at top of low RAM page
                      (adybug/src/main.s):00108         
C008 8602             (adybug/src/main.s):00109                 lda     #$02            ; DP = $02
C00A 1F8B             (adybug/src/main.s):00110                 tfr     a,dp
                      (adybug/src/main.s):00111         
                      (adybug/src/main.s):00112                 ; --- Quiet legacy PIA interrupts ---
C00C 4F               (adybug/src/main.s):00113                 clra
C00D B7FF01           (adybug/src/main.s):00114                 sta     PIA1_CRA
C010 B7FF03           (adybug/src/main.s):00115                 sta     PIA1_CRB
C013 B7FF21           (adybug/src/main.s):00116                 sta     PIA2_CRA
C016 B7FF23           (adybug/src/main.s):00117                 sta     PIA2_CRB
C019 B6FF00           (adybug/src/main.s):00118                 lda     PIA1_DA
C01C B6FF02           (adybug/src/main.s):00119                 lda     PIA1_DB
C01F B6FF20           (adybug/src/main.s):00120                 lda     PIA2_DA
C022 B6FF22           (adybug/src/main.s):00121                 lda     PIA2_DB
                      (adybug/src/main.s):00122         
                      (adybug/src/main.s):00123                 ; --- Init0 — legacy mode, ACVC IRQ on, force $FExx, MMU still off ---
C025 86A8             (adybug/src/main.s):00124                 lda     #%10101000
C027 B7FF90           (adybug/src/main.s):00125                 sta     GIME_INIT0
C02A B7FFDE           (adybug/src/main.s):00126                 sta     SAM_ROMRAM       ; cart map is selected before clearing TY
                      (adybug/src/main.s):00127         
                      (adybug/src/main.s):00128                 ; --- Execute directly from cartridge ROM ---
                      (adybug/src/main.s):00129                 ; Keep TY=0. XRoar discards writes to the selected cartridge window,
                      (adybug/src/main.s):00130                 ; so the former same-address self-copy never populated phys $3E-$3F.
                      (adybug/src/main.s):00131                 ; PAR6=$3E keeps $C000-$DFFF cartridge-backed after MMU enable while
                      (adybug/src/main.s):00132                 ; the framebuffer and writable state use ordinary RAM pages below $3C.
                      (adybug/src/main.s):00133         
                      (adybug/src/main.s):00134                 ; --- Force executive PAR set ($FFA0-$FFA7) to be active ---
C02D 7FFF91           (adybug/src/main.s):00135                 clr     $FF91
                      (adybug/src/main.s):00136         
                      (adybug/src/main.s):00137                 ; --- Set up MMU PARs (executive set) ---
                      (adybug/src/main.s):00138                 ; PAR0 ($0000) = phys $38   low RAM (DP, stack)
                      (adybug/src/main.s):00139                 ; PAR1 ($2000) = phys $30   FB page 0
                      (adybug/src/main.s):00140                 ; PAR2 ($4000) = phys $31   FB page 1
                      (adybug/src/main.s):00141                 ; PAR3 ($6000) = phys $32   FB page 2
                      (adybug/src/main.s):00142                 ; PAR4 ($8000) = phys $33   FB page 3
                      (adybug/src/main.s):00143                 ; PAR5 ($A000) = phys $34   game state (Phase 4+)
                      (adybug/src/main.s):00144                 ; PAR6 ($C000) = phys $3E   cartridge code (current 8 K window)
                      (adybug/src/main.s):00145                 ; PAR7 ($E000) = phys $3F   cartridge/ROM window + IO + jump table
C030 308D0647         (adybug/src/main.s):00146                 leax    par_table,pcr
C034 108EFFA0         (adybug/src/main.s):00147                 ldy     #PAR_EXEC
C038 C608             (adybug/src/main.s):00148                 ldb     #8
C03A A680             (adybug/src/main.s):00149         parloop lda     ,x+
C03C A7A0             (adybug/src/main.s):00150                 sta     ,y+
C03E 5A               (adybug/src/main.s):00151                 decb
C03F 26F9             (adybug/src/main.s):00152                 bne     parloop
                      (adybug/src/main.s):00153         
                      (adybug/src/main.s):00154                 ; --- Fast clock 1.78 MHz ---
C041 B7FFD9           (adybug/src/main.s):00155                 sta     SAM_FAST
                      (adybug/src/main.s):00156         
                      (adybug/src/main.s):00157                 ; --- Set up display (still blanked via CRES=11) ---
C044 8680             (adybug/src/main.s):00158                 lda     #%10000000      ; BP=1 (graphics)
C046 B7FF98           (adybug/src/main.s):00159                 sta     GIME_VMODE
                      (adybug/src/main.s):00160         
C049 861F             (adybug/src/main.s):00161                 lda     #$1F            ; VRES=00 HRES=111 CRES=11 (BLANKED)
C04B B7FF99           (adybug/src/main.s):00162                 sta     GIME_VRES
                      (adybug/src/main.s):00163         
C04E 7FFF9A           (adybug/src/main.s):00164                 clr     GIME_BORDER     ; canonical Black outside the active framebuffer
                      (adybug/src/main.s):00165         
                      (adybug/src/main.s):00166                 ; FB at phys $30 → physical address $060000.
                      (adybug/src/main.s):00167                 ;   Y18=1, Y17=1, Y16..Y3 = 0
                      (adybug/src/main.s):00168                 ;   V1 ($FF9D) = Y18..Y11 = %11000000 = $C0
                      (adybug/src/main.s):00169                 ;   V0 ($FF9E) = Y10..Y3  = $00
C051 86C0             (adybug/src/main.s):00170                 lda     #$C0
C053 B7FF9D           (adybug/src/main.s):00171                 sta     GIME_VOFF1
C056 7FFF9E           (adybug/src/main.s):00172                 clr     GIME_VOFF0
                      (adybug/src/main.s):00173         
                      (adybug/src/main.s):00174                 ; --- Init0 — turn on MMU + switch to hi-res. Display still blanked. ---
                      (adybug/src/main.s):00175                 ; %01101000 = COCO=0 MMU=1 ACVCIRQ=1 ACVCFIRQ=0 force-$FExx=1 SCS=0 ROMmap=00
C059 8668             (adybug/src/main.s):00176                 lda     #%01101000
C05B B7FF90           (adybug/src/main.s):00177                 sta     GIME_INIT0
                      (adybug/src/main.s):00178         
                      (adybug/src/main.s):00179                 ; --- Load palette (16 entries) ---
C05E 308D0621         (adybug/src/main.s):00180                 leax    palette_table,pcr
C062 108EFFB0         (adybug/src/main.s):00181                 ldy     #PAL_BASE
C066 C610             (adybug/src/main.s):00182                 ldb     #16
C068 A680             (adybug/src/main.s):00183         palloop lda     ,x+
C06A A7A0             (adybug/src/main.s):00184                 sta     ,y+
C06C 5A               (adybug/src/main.s):00185                 decb
C06D 26F9             (adybug/src/main.s):00186                 bne     palloop
                      (adybug/src/main.s):00187         
                      (adybug/src/main.s):00188                 ; --- Clear FB to palette idx 0 (black) ---
                      (adybug/src/main.s):00189                 ; 30720 bytes = 15360 STDs.
C06F 8E2000           (adybug/src/main.s):00190                 ldx     #FB_VIRT
C072 CC0000           (adybug/src/main.s):00191                 ldd     #$0000
C075 ED81             (adybug/src/main.s):00192         clr_fb  std     ,x++
C077 8C9800           (adybug/src/main.s):00193                 cmpx    #FB_END
C07A 25F9             (adybug/src/main.s):00194                 blo     clr_fb
                      (adybug/src/main.s):00195         
                      (adybug/src/main.s):00196                 ; --- Phase 3 authored screen ---
C07C 170566           (adybug/src/main.s):00197                 lbsr    draw_screen
                      (adybug/src/main.s):00198         
                      (adybug/src/main.s):00199                 ; --- Phase 4 state, joystick, and player sprite ---
C07F 170046           (adybug/src/main.s):00200                 lbsr    init_maze_state
C082 170056           (adybug/src/main.s):00201                 lbsr    init_gate_state
C085 170067           (adybug/src/main.s):00202                 lbsr    init_joystick
C088 170095           (adybug/src/main.s):00203                 lbsr    init_player
C08B 1704FB           (adybug/src/main.s):00204                 lbsr    draw_player
                      (adybug/src/main.s):00205         
                      (adybug/src/main.s):00206                 ; --- Un-blank: 320×192×16 (CRES=10 + HRES=111 → 4bpp on this build) ---
C08E 861E             (adybug/src/main.s):00207                 lda     #$1E
C090 B7FF99           (adybug/src/main.s):00208                 sta     GIME_VRES
                      (adybug/src/main.s):00209         
                      (adybug/src/main.s):00210                 ; --- IRQ handler at $FEF7 jump-table slot ---
C093 867E             (adybug/src/main.s):00211                 lda     #$7E            ; JMP extended
C095 B7FEF7           (adybug/src/main.s):00212                 sta     JT_IRQ
C098 CCC671           (adybug/src/main.s):00213                 ldd     #irq_handler
C09B FDFEF8           (adybug/src/main.s):00214                 std     JT_IRQ+1
                      (adybug/src/main.s):00215         
C09E 0F02             (adybug/src/main.s):00216                 clr     FRAMES
C0A0 0F03             (adybug/src/main.s):00217                 clr     FRAMES+1
C0A2 0F00             (adybug/src/main.s):00218                 clr     LAST_FRAME
                      (adybug/src/main.s):00219         
                      (adybug/src/main.s):00220                 ; --- Enable Vbord ---
C0A4 8608             (adybug/src/main.s):00221                 lda     #%00001000
C0A6 B7FF92           (adybug/src/main.s):00222                 sta     GIME_IRQEN
C0A9 B6FF92           (adybug/src/main.s):00223                 lda     GIME_IRQEN
                      (adybug/src/main.s):00224         
C0AC 1CEF             (adybug/src/main.s):00225                 andcc   #%11101111      ; unmask IRQ
                      (adybug/src/main.s):00226         
                      (adybug/src/main.s):00227         ;==============================================================================
                      (adybug/src/main.s):00228         ; mainloop — sample every Vbord; advance two pixels every second Vbord.
                      (adybug/src/main.s):00229         ;==============================================================================
C0AE                  (adybug/src/main.s):00230         mainloop
C0AE 13               (adybug/src/main.s):00231                 sync
C0AF 9603             (adybug/src/main.s):00232                 lda     FRAMES+1
C0B1 9100             (adybug/src/main.s):00233                 cmpa    LAST_FRAME
C0B3 27F9             (adybug/src/main.s):00234                 beq     mainloop
C0B5 9700             (adybug/src/main.s):00235                 sta     LAST_FRAME
C0B7 170084           (adybug/src/main.s):00236                 lbsr    read_joystick
C0BA 1703CD           (adybug/src/main.s):00237                 lbsr    finish_gate_animation
C0BD 9600             (adybug/src/main.s):00238                 lda     LAST_FRAME
C0BF 8401             (adybug/src/main.s):00239                 anda    #$01
C0C1 26EB             (adybug/src/main.s):00240                 bne     mainloop
C0C3                  (adybug/src/main.s):00241         phase4_before_tick
C0C3 1700F8           (adybug/src/main.s):00242                 lbsr    player_tick
C0C6 20E6             (adybug/src/main.s):00243                 bra     mainloop
                      (adybug/src/main.s):00244         
                      (adybug/src/main.s):00245         ;==============================================================================
                      (adybug/src/main.s):00246         ; init_maze_state — copy immutable maze cells to writable game-state RAM.
                      (adybug/src/main.s):00247         ;
                      (adybug/src/main.s):00248         ; Inputs:
                      (adybug/src/main.s):00249         ;   None
                      (adybug/src/main.s):00250         ;
                      (adybug/src/main.s):00251         ; Returns:
                      (adybug/src/main.s):00252         ;   X, Y, U, A, CC — undefined
                      (adybug/src/main.s):00253         ;
                      (adybug/src/main.s):00254         ; Side effects:
                      (adybug/src/main.s):00255         ;   Writes 576 bytes at MAZE_STATE.
                      (adybug/src/main.s):00256         ;==============================================================================
C0C8                  (adybug/src/main.s):00257         init_maze_state
C0C8 308D180D         (adybug/src/main.s):00258                 leax    maze_cells,pcr
C0CC 108EA000         (adybug/src/main.s):00259                 ldy     #MAZE_STATE
C0D0                  (adybug/src/main.s):00260         ims_copy
C0D0 A680             (adybug/src/main.s):00261                 lda     ,x+
C0D2 A7A0             (adybug/src/main.s):00262                 sta     ,y+
C0D4 108CA240         (adybug/src/main.s):00263                 cmpy    #MAZE_STATE+576
C0D8 25F6             (adybug/src/main.s):00264                 blo     ims_copy
C0DA 39               (adybug/src/main.s):00265                 rts
                      (adybug/src/main.s):00266         
                      (adybug/src/main.s):00267         ;==============================================================================
                      (adybug/src/main.s):00268         ; init_gate_state
                      (adybug/src/main.s):00269         ;
                      (adybug/src/main.s):00270         ; Inputs: none
                      (adybug/src/main.s):00271         ; Returns: A, B, X, Y, CC undefined
                      (adybug/src/main.s):00272         ; Side effects: copies 20 captured initial states to GATE_STATE.
                      (adybug/src/main.s):00273         ;==============================================================================
C0DB                  (adybug/src/main.s):00274         init_gate_state
C0DB 308D1EBA         (adybug/src/main.s):00275                 leax    maze_gates,pcr
C0DF 108EA240         (adybug/src/main.s):00276                 ldy     #GATE_STATE
C0E3 C614             (adybug/src/main.s):00277                 ldb     #MAZE_GATE_COUNT
C0E5                  (adybug/src/main.s):00278         igs_loop
C0E5 A602             (adybug/src/main.s):00279                 lda     2,x
C0E7 A7A0             (adybug/src/main.s):00280                 sta     ,y+
C0E9 3003             (adybug/src/main.s):00281                 leax    3,x
C0EB 5A               (adybug/src/main.s):00282                 decb
C0EC 26F7             (adybug/src/main.s):00283                 bne     igs_loop
C0EE 39               (adybug/src/main.s):00284                 rts
                      (adybug/src/main.s):00285         
                      (adybug/src/main.s):00286         ;==============================================================================
                      (adybug/src/main.s):00287         ; init_joystick — configure the PIAs for right-joystick DAC conversion.
                      (adybug/src/main.s):00288         ;
                      (adybug/src/main.s):00289         ; Inputs:
                      (adybug/src/main.s):00290         ;   None
                      (adybug/src/main.s):00291         ;
                      (adybug/src/main.s):00292         ; Returns:
                      (adybug/src/main.s):00293         ;   A, CC — undefined
                      (adybug/src/main.s):00294         ;
                      (adybug/src/main.s):00295         ; Side effects:
