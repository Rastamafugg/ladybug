     2000             (adybug/src/main.s):00196         FB_VIRT    equ  $2000           ; virtual base of framebuffer (PAR1)
     9800             (adybug/src/main.s):00197         FB_END     equ  $9800           ; one past last FB byte (192 rows × 160 B)
     0030             (adybug/src/main.s):00198         FB_PHYS    equ  $30             ; physical page 0 of FB
     A000             (adybug/src/main.s):00199         MAZE_STATE equ  $A000           ; writable 576-byte maze-cell copy (PAR5)
     A240             (adybug/src/main.s):00200         GATE_STATE equ  $A240           ; rotation state N/W/S/E; parity selects H/V bar
     A300             (adybug/src/main.s):00201         PLAYER_BG  equ  $A300           ; 128-byte saved background under player
     A380             (adybug/src/main.s):00202         ENTITY_TABLE equ $A380          ; twelve x/y/type/variant records
     A3F0             (adybug/src/main.s):00203         PLAYER_STAGE equ $A3F0         ; 128-byte off-screen player composition surface
     57EC             (adybug/src/main.s):00204         ENEMY_FB    equ $57EC          ; top-left at lower nest cell (12,12)
     A470             (adybug/src/main.s):00205         ENEMY_TABLE equ $A470          ; four 8-byte active enemy records
     A490             (adybug/src/main.s):00206         ENEMY_ZONE_BG equ $A490        ; 256-byte clean 16-by-32 nest background
                      (adybug/src/main.s):00207         
