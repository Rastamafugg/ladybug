     000B             (andoff/src/main.s):00035         PLAYER_FB     equ $000B         ; u16 framebuffer pointer at sprite top-left
     000D             (andoff/src/main.s):00036         JOY_DX        equ $000D         ; absolute X displacement from centre
     000E             (andoff/src/main.s):00037         JOY_DY        equ $000E         ; absolute Y displacement from centre
     000F             (andoff/src/main.s):00038         PLAYER_WANT   equ $000F         ; last non-neutral requested direction
