                      (adybug/src/main.s):01672         ; init_joystick — configure the PIAs for right-joystick DAC conversion.
                      (adybug/src/main.s):01673         ;
                      (adybug/src/main.s):01674         ; Inputs:
                      (adybug/src/main.s):01675         ;   None
                      (adybug/src/main.s):01676         ;
                      (adybug/src/main.s):01677         ; Returns:
                      (adybug/src/main.s):01678         ;   A, CC — undefined
                      (adybug/src/main.s):01679         ;
                      (adybug/src/main.s):01680         ; Side effects:
                      (adybug/src/main.s):01681         ;   Configures PIA1 PA as input, PIA1 PB as output, PIA2 PA7-PA2 as DAC
                      (adybug/src/main.s):01682         ;   output, and selects/enables the right joystick analog multiplexer.
                      (adybug/src/main.s):01683         ;==============================================================================
C945                  (adybug/src/main.s):01684         init_joystick
C945 7FFF01           (adybug/src/main.s):01685                 clr     PIA1_CRA        ; select PIA1 PA direction register
C948 7FFF00           (adybug/src/main.s):01686                 clr     PIA1_DA         ; all PA bits input, including comparator PA7
C94B 7FFF03           (adybug/src/main.s):01687                 clr     PIA1_CRB        ; select PIA1 PB direction register
C94E 86FF             (adybug/src/main.s):01688                 lda     #$FF
C950 B7FF02           (adybug/src/main.s):01689                 sta     PIA1_DB         ; keyboard columns/output side
C953 8634             (adybug/src/main.s):01690                 lda     #$34            ; data register, static CA2/CB2 output low
C955 B7FF01           (adybug/src/main.s):01691                 sta     PIA1_CRA
C958 B7FF03           (adybug/src/main.s):01692                 sta     PIA1_CRB        ; selector 0 = right joystick X
                      (adybug/src/main.s):01693         
C95B 7FFF21           (adybug/src/main.s):01694                 clr     PIA2_CRA        ; select PIA2 PA direction register
C95E 86FC             (adybug/src/main.s):01695                 lda     #$FC
C960 B7FF20           (adybug/src/main.s):01696                 sta     PIA2_DA         ; PA7-PA2 are the six-bit DAC
C963 8604             (adybug/src/main.s):01697                 lda     #$04            ; data-register access
C965 B7FF21           (adybug/src/main.s):01698                 sta     PIA2_CRA
C968 7FFF23           (adybug/src/main.s):01699                 clr     PIA2_CRB
C96B 8634             (adybug/src/main.s):01700                 lda     #$34            ; static CB2 low enables analog multiplexer
C96D B7FF23           (adybug/src/main.s):01701                 sta     PIA2_CRB
C970 8680             (adybug/src/main.s):01702                 lda     #$80            ; centre DAC while idle
C972 B7FF20           (adybug/src/main.s):01703                 sta     PIA2_DA
C975 39               (adybug/src/main.s):01704                 rts
