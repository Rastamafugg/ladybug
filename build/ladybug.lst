                      (adybug/src/main.s):03574         ; blit_transparent — overlay nonzero packed nibbles from a rectangle.
                      (adybug/src/main.s):03575         ;
                      (adybug/src/main.s):03576         ; Inputs:
                      (adybug/src/main.s):03577         ;   A — source row count
