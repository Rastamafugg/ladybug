                      (adybug/src/main.s):00246         ;  Cart ROM
                      (adybug/src/main.s):00247         ;==============================================================================
                      (adybug/src/main.s):00248                 org     $C000
                      (adybug/src/main.s):00249         
C000 444B             (adybug/src/main.s):00250                 fcc     "DK"            ; ROM-pack autostart magic; FIRQ -> $C002
                      (adybug/src/main.s):00251         
                      (adybug/src/main.s):00252         ;==============================================================================
                      (adybug/src/main.s):00253         ; entry
                      (adybug/src/main.s):00254         ;==============================================================================
C002 1A50             (adybug/src/main.s):00255         entry   orcc    #$50            ; mask IRQ + FIRQ
C004 10CE1FFE         (adybug/src/main.s):00256                 lds     #$1FFE          ; stack at top of low RAM page
                      (adybug/src/main.s):00257         
C008 4F               (adybug/src/main.s):00258                 clra                    ; DP = $00, shared with bank-3 runtime
C009 1F8B             (adybug/src/main.s):00259                 tfr     a,dp
                      (adybug/src/main.s):00260         
                      (adybug/src/main.s):00261                 ; --- Quiet legacy PIA interrupts ---
C00B 4F               (adybug/src/main.s):00262                 clra
C00C B7FF01           (adybug/src/main.s):00263                 sta     PIA1_CRA
