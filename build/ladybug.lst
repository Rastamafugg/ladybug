                      (adybug/src/main.s):01512         ; init_joystick — configure the PIAs for right-joystick DAC conversion.
                      (adybug/src/main.s):01513         ;
                      (adybug/src/main.s):01514         ; Inputs:
                      (adybug/src/main.s):01515         ;   None
                      (adybug/src/main.s):01516         ;
                      (adybug/src/main.s):01517         ; Returns:
                      (adybug/src/main.s):01518         ;   A, CC — undefined
                      (adybug/src/main.s):01519         ;
                      (adybug/src/main.s):01520         ; Side effects:
                      (adybug/src/main.s):01521         ;   Configures PIA1 PA as input, PIA1 PB as output, PIA2 PA7-PA2 as DAC
                      (adybug/src/main.s):01522         ;   output, and selects/enables the right joystick analog multiplexer.
                      (adybug/src/main.s):01523         ;==============================================================================
