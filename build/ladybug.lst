                      (adybug/src/main.s):03136         ; blit_tile — copy an 8x8 tile to a framebuffer byte address.
                      (adybug/src/main.s):03137         ;
                      (adybug/src/main.s):03138         ; Inputs:
                      (adybug/src/main.s):03139         ;   X — destination framebuffer byte address
