C9C6 7FFF01           (rf-001/src/main.s):01767                 clr     PIA1_CRA        ; select PIA1 PA direction register
C9C9 7FFF00           (rf-001/src/main.s):01768                 clr     PIA1_DA         ; all PA bits input, including comparator PA7
C9CC 7FFF03           (rf-001/src/main.s):01769                 clr     PIA1_CRB        ; select PIA1 PB direction register
C9CF 86FF             (rf-001/src/main.s):01770                 lda     #$FF
C9D1 B7FF02           (rf-001/src/main.s):01771                 sta     PIA1_DB         ; keyboard columns/output side
C9D4 8634             (rf-001/src/main.s):01772                 lda     #$34            ; data register, static CA2/CB2 output low
C9D6 B7FF01           (rf-001/src/main.s):01773                 sta     PIA1_CRA
C9D9 B7FF03           (rf-001/src/main.s):01774                 sta     PIA1_CRB        ; selector 0 = right joystick X
                      (rf-001/src/main.s):01775         
C9DC 7FFF21           (rf-001/src/main.s):01776                 clr     PIA2_CRA        ; select PIA2 PA direction register
C9DF 86FC             (rf-001/src/main.s):01777                 lda     #$FC
C9E1 B7FF20           (rf-001/src/main.s):01778                 sta     PIA2_DA         ; PA7-PA2 are the six-bit DAC
C9E4 8604             (rf-001/src/main.s):01779                 lda     #$04            ; data-register access
C9E6 B7FF21           (rf-001/src/main.s):01780                 sta     PIA2_CRA
C9E9 7FFF23           (rf-001/src/main.s):01781                 clr     PIA2_CRB
C9EC 8634             (rf-001/src/main.s):01782                 lda     #$34            ; static CB2 low enables analog multiplexer
C9EE B7FF23           (rf-001/src/main.s):01783                 sta     PIA2_CRB
