C04C B7FF98           (adybug/src/main.s):00341                 sta     GIME_VMODE
                      (adybug/src/main.s):00342         
C04F 861F             (adybug/src/main.s):00343                 lda     #$1F            ; VRES=00 HRES=111 CRES=11 (BLANKED)
C051 B7FF99           (adybug/src/main.s):00344                 sta     GIME_VRES
                      (adybug/src/main.s):00345         
C054 7FFF9A           (adybug/src/main.s):00346                 clr     GIME_BORDER     ; canonical Black outside the active framebuffer
                      (adybug/src/main.s):00347         
                      (adybug/src/main.s):00348                 ; FB at phys $30 → physical address $060000.
                      (adybug/src/main.s):00349                 ;   Y18=1, Y17=1, Y16..Y3 = 0
                      (adybug/src/main.s):00350                 ;   V1 ($FF9D) = Y18..Y11 = %11000000 = $C0
                      (adybug/src/main.s):00351                 ;   V0 ($FF9E) = Y10..Y3  = $00
C057 86C0             (adybug/src/main.s):00352                 lda     #$C0
C059 B7FF9D           (adybug/src/main.s):00353                 sta     GIME_VOFF1
C05C 7FFF9E           (adybug/src/main.s):00354                 clr     GIME_VOFF0
                      (adybug/src/main.s):00355         
                      (adybug/src/main.s):00356                 ; --- Init0 — turn on MMU + switch to hi-res. Display still blanked. ---
                      (adybug/src/main.s):00357                 ; %01101000 = COCO=0 MMU=1 ACVCIRQ=1 ACVCFIRQ=0 force-$FExx=1 SCS=0 ROMmap=00
C05F 8668             (adybug/src/main.s):00358                 lda     #%01101000
C061 B7FF90           (adybug/src/main.s):00359                 sta     GIME_INIT0
