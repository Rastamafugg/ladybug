                      (adybug/src/main.s):01607         ; init_joystick — configure the PIAs for right-joystick DAC conversion.
                      (adybug/src/main.s):01608         ;
                      (adybug/src/main.s):01609         ; Inputs:
                      (adybug/src/main.s):01610         ;   None
                      (adybug/src/main.s):01611         ;
                      (adybug/src/main.s):01612         ; Returns:
                      (adybug/src/main.s):01613         ;   A, CC — undefined
                      (adybug/src/main.s):01614         ;
                      (adybug/src/main.s):01615         ; Side effects:
                      (adybug/src/main.s):01616         ;   Configures PIA1 PA as input, PIA1 PB as output, PIA2 PA7-PA2 as DAC
                      (adybug/src/main.s):01617         ;   output, and selects/enables the right joystick analog multiplexer.
                      (adybug/src/main.s):01618         ;==============================================================================
C901                  (adybug/src/main.s):01619         init_joystick
C901 7FFF01           (adybug/src/main.s):01620                 clr     PIA1_CRA        ; select PIA1 PA direction register
C904 7FFF00           (adybug/src/main.s):01621                 clr     PIA1_DA         ; all PA bits input, including comparator PA7
C907 7FFF03           (adybug/src/main.s):01622                 clr     PIA1_CRB        ; select PIA1 PB direction register
C90A 86FF             (adybug/src/main.s):01623                 lda     #$FF
C90C B7FF02           (adybug/src/main.s):01624                 sta     PIA1_DB         ; keyboard columns/output side
C90F 8634             (adybug/src/main.s):01625                 lda     #$34            ; data register, static CA2/CB2 output low
C911 B7FF01           (adybug/src/main.s):01626                 sta     PIA1_CRA
C914 B7FF03           (adybug/src/main.s):01627                 sta     PIA1_CRB        ; selector 0 = right joystick X
                      (adybug/src/main.s):01628         
C917 7FFF21           (adybug/src/main.s):01629                 clr     PIA2_CRA        ; select PIA2 PA direction register
C91A 86FC             (adybug/src/main.s):01630                 lda     #$FC
C91C B7FF20           (adybug/src/main.s):01631                 sta     PIA2_DA         ; PA7-PA2 are the six-bit DAC
C91F 8604             (adybug/src/main.s):01632                 lda     #$04            ; data-register access
C921 B7FF21           (adybug/src/main.s):01633                 sta     PIA2_CRA
C924 7FFF23           (adybug/src/main.s):01634                 clr     PIA2_CRB
C927 8634             (adybug/src/main.s):01635                 lda     #$34            ; static CB2 low enables analog multiplexer
C929 B7FF23           (adybug/src/main.s):01636                 sta     PIA2_CRB
C92C 8680             (adybug/src/main.s):01637                 lda     #$80            ; centre DAC while idle
C92E B7FF20           (adybug/src/main.s):01638                 sta     PIA2_DA
C931 39               (adybug/src/main.s):01639                 rts
