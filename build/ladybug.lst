                      (adybug/src/main.s):03922         ; blit_transparent — overlay nonzero packed nibbles from a rectangle.
                      (adybug/src/main.s):03923         ;
                      (adybug/src/main.s):03924         ; Inputs:
                      (adybug/src/main.s):03925         ;   A — source row count
                      (adybug/src/main.s):03926         ;   B — packed bytes per row (4 for tiles, 8 for player frames)
                      (adybug/src/main.s):03927         ;   X — destination framebuffer byte address
                      (adybug/src/main.s):03928         ;   Y — packed 4bpp source data; colour 0 is transparent
                      (adybug/src/main.s):03929         ;
                      (adybug/src/main.s):03930         ; Returns: A, B, X, Y, CC undefined
                      (adybug/src/main.s):03931         ; Side effects: blends the requested rectangle into the framebuffer.
                      (adybug/src/main.s):03932         ;==============================================================================
