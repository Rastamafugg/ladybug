                      (adybug/src/main.s):00290                 ; --- Set up MMU PARs (executive set) ---
                      (adybug/src/main.s):00291                 ; PAR0 ($0000) = phys $38   low RAM (DP, stack)
                      (adybug/src/main.s):00292                 ; PAR1 ($2000) = phys $30   FB page 0
                      (adybug/src/main.s):00293                 ; PAR2 ($4000) = phys $31   FB page 1
                      (adybug/src/main.s):00294                 ; PAR3 ($6000) = phys $32   FB page 2
                      (adybug/src/main.s):00295                 ; PAR4 ($8000) = phys $33   FB page 3
                      (adybug/src/main.s):00296                 ; PAR5 ($A000) = phys $34   game state (Phase 4+)
                      (adybug/src/main.s):00297                 ; PAR6 ($C000) = phys $3E   cartridge code (current 8 K window)
                      (adybug/src/main.s):00298                 ; PAR7 ($E000) = phys $3F   cartridge/ROM window + IO + jump table
