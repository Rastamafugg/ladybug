                      (adybug/src/main.s):03586         ; blit_tile — copy an 8x8 tile to a framebuffer byte address.
                      (adybug/src/main.s):03587         ;
                      (adybug/src/main.s):03588         ; Inputs:
                      (adybug/src/main.s):03589         ;   X — destination framebuffer byte address
                      (adybug/src/main.s):03590         ;   Y — source glyph data, 32 packed 4bpp bytes
                      (adybug/src/main.s):03591         ;
                      (adybug/src/main.s):03592         ; Returns:
                      (adybug/src/main.s):03593         ;   A, B, D, X, Y, U, CC — undefined
                      (adybug/src/main.s):03594         ;
                      (adybug/src/main.s):03595         ; Side effects:
                      (adybug/src/main.s):03596         ;   Writes 8 rows x 4 bytes; advances 156 bytes after each written row.
                      (adybug/src/main.s):03597         ;==============================================================================
