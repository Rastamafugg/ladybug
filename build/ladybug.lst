CA43 B7FF21           (andoff/src/main.s):01873                 sta     PIA2_CRA
CA46 7FFF23           (andoff/src/main.s):01874                 clr     PIA2_CRB
CA49 8634             (andoff/src/main.s):01875                 lda     #$34            ; static CB2 low enables analog multiplexer
CA4B B7FF23           (andoff/src/main.s):01876                 sta     PIA2_CRB
CA4E 8680             (andoff/src/main.s):01877                 lda     #$80            ; centre DAC while idle
