                      (adybug/src/main.s):00001         ;==============================================================================
                      (adybug/src/main.s):00002         ; Ladybug — main.s
                      (adybug/src/main.s):00003         ;==============================================================================
                      (adybug/src/main.s):00004         ; Phase 4: joystick-driven Lady Bug movement over the authored screen.
                      (adybug/src/main.s):00005         ;
                      (adybug/src/main.s):00006         ; Builds on Phase 2.3 (hi-res 320×192×16 + MMU + palette + IRQ tick) by:
                      (adybug/src/main.s):00007         ;   - Compiling tiled/coco-screen.tmx into a one-byte tile map and a
                      (adybug/src/main.s):00008         ;     deduplicated packed 4bpp tile atlas before assembly.
                      (adybug/src/main.s):00009         ;   - Flattening visible Tiled layers and applying horizontal/vertical flips.
                      (adybug/src/main.s):00010         ;   - blit_tile: 8 rows x 4 bytes, stride 160.
                      (adybug/src/main.s):00011         ;   - Polling the right joystick through the PIA DAC/comparator path.
                      (adybug/src/main.s):00012         ;   - Transparent 16x16 player frames with background save/restore.
                      (adybug/src/main.s):00013         ;   - Semantic maze collision and dot removal.
                      (adybug/src/main.s):00014         ;
                      (adybug/src/main.s):00015         ; Visible: the authored screen with a moving, maze-constrained Lady Bug.
                      (adybug/src/main.s):00016         ;==============================================================================
                      (adybug/src/main.s):00017         
                      (adybug/src/main.s):00018                 pragma  nodollarlocal,6809
                      (adybug/src/main.s):00019         
                      (adybug/src/main.s):00020         ;------------------------------------------------------------------------------
                      (adybug/src/main.s):00021         ; DP allocation (page $00)
                      (adybug/src/main.s):00022         ;------------------------------------------------------------------------------
     00               (adybug/src/main.s):00023                 setdp   $00
                      (adybug/src/main.s):00024         
     0000             (adybug/src/main.s):00025         LAST_FRAME    equ $0000         ; last processed Vbord counter low byte
     0001             (adybug/src/main.s):00026         JOY_X         equ $0001         ; right joystick X, 0..63
     0002             (adybug/src/main.s):00027         FRAMES        equ $0002         ; u16 frame counter
     0004             (adybug/src/main.s):00028         JOY_Y         equ $0004         ; right joystick Y, 0..63
     0005             (adybug/src/main.s):00029         JOY_DIR       equ $0005         ; requested direction or $FF
     0006             (adybug/src/main.s):00030         PLAYER_DIR    equ $0006         ; active direction or $FF
     0007             (adybug/src/main.s):00031         PLAYER_FACE   equ $0007         ; last active direction, 0..3
     0008             (adybug/src/main.s):00032         PLAYER_STEP   equ $0008         ; 2-pixel steps since last cell centre, 0..3
     0009             (adybug/src/main.s):00033         PLAYER_CELL_X equ $0009         ; semantic maze column
     000A             (adybug/src/main.s):00034         PLAYER_CELL_Y equ $000A         ; semantic maze row
     000B             (adybug/src/main.s):00035         PLAYER_FB     equ $000B         ; u16 framebuffer pointer at sprite top-left
     000D             (adybug/src/main.s):00036         JOY_DX        equ $000D         ; absolute X displacement from centre
     000E             (adybug/src/main.s):00037         JOY_DY        equ $000E         ; absolute Y displacement from centre
     000F             (adybug/src/main.s):00038         PLAYER_WANT   equ $000F         ; last non-neutral requested direction
     0010             (adybug/src/main.s):00039         TEST_X        equ $0010         ; candidate/draw maze column
     0011             (adybug/src/main.s):00040         TEST_Y        equ $0011         ; candidate/draw maze row
     0012             (adybug/src/main.s):00041         TEST_DIR      equ $0012         ; direction under collision test
     0013             (adybug/src/main.s):00042         GATE_ID       equ $0013         ; active gate index
     0014             (adybug/src/main.s):00043         GATE_X        equ $0014         ; active gate pivot column
     0015             (adybug/src/main.s):00044         GATE_Y        equ $0015         ; active gate pivot row
     0016             (adybug/src/main.s):00045         DRAW_COUNT    equ $0016         ; gate redraw loop counter
     0017             (adybug/src/main.s):00046         DRAW_TILE     equ $0017         ; tile ID for draw_cell_tile
     0018             (adybug/src/main.s):00047         PLAYER_MANUAL equ $0018         ; nonzero after first directional input
     0019             (adybug/src/main.s):00048         GATE_ANIM_ID  equ $0019         ; rotating gate ID+1; zero when idle
     001A             (adybug/src/main.s):00049         GATE_ANIM_STYLE equ $001A       ; 0=slash, 1=backslash
     001B             (adybug/src/main.s):00050         BLIT_ROWS     equ $001B         ; transparent-blit row counter
     001C             (adybug/src/main.s):00051         BLIT_WIDTH    equ $001C         ; transparent-blit bytes per row
     001D             (adybug/src/main.s):00052         SCORE_BCD     equ $001D         ; packed BCD score, six digits
     0020             (adybug/src/main.s):00053         HIGH_BCD      equ $0020         ; packed BCD session high score
     0023             (adybug/src/main.s):00054         LIVES         equ $0023         ; lives remaining
     0024             (adybug/src/main.s):00055         STAGE         equ $0024         ; current stage, 1..255
     0025             (adybug/src/main.s):00056         DOTS_LEFT     equ $0025         ; remaining flowers in this stage
     0026             (adybug/src/main.s):00057         STAGE_PENDING equ $0026         ; nonzero requests a stage transition
     0027             (adybug/src/main.s):00058         HUD_X         equ $0027         ; HUD tile column scratch
     0028             (adybug/src/main.s):00059         HUD_Y         equ $0028         ; HUD tile row scratch
     0029             (adybug/src/main.s):00060         HUD_COLOR     equ $0029         ; palette index for digit rendering
     002A             (adybug/src/main.s):00061         HUD_BYTE      equ $002A         ; packed BCD / mask scratch
     002B             (adybug/src/main.s):00062         HUD_COUNT     equ $002B         ; byte/row loop scratch
     002C             (adybug/src/main.s):00063         HUD_WIDTH     equ $002C         ; packed-byte loop scratch
     002D             (adybug/src/main.s):00064         HUD_BCD_BYTE  equ $002D         ; preserved BCD byte during digit blits
     002E             (adybug/src/main.s):00065         HUD_BCD_COUNT equ $002E         ; packed BCD byte loop
     002F             (adybug/src/main.s):00066         BONUS_COLOR   equ $002F         ; global bonus colour, palette index
     0030             (adybug/src/main.s):00067         BONUS_TIMER   equ $0030         ; u16 frames remaining in current colour
     0032             (adybug/src/main.s):00068         ENTITY_COUNT  equ $0032         ; active entity-table record count
     0033             (adybug/src/main.s):00069         BONUS_LEFT    equ $0033         ; uncollected hearts and letters
     0034             (adybug/src/main.s):00070         RNG_STATE     equ $0034         ; u16 placement LFSR
     BFFE             (adybug/src/main.s):00071         RNG_ENTROPY   equ $BFFE         ; untouched game-state RAM sampled at cold start
     0036             (adybug/src/main.s):00072         ENTITY_X      equ $0036         ; entity/draw scratch
     0037             (adybug/src/main.s):00073         ENTITY_Y      equ $0037
     0038             (adybug/src/main.s):00074         ENTITY_TYPE   equ $0038
     0039             (adybug/src/main.s):00075         ENTITY_VARIANT equ $0039
     003A             (adybug/src/main.s):00076         DEATH_TIMER   equ $003A         ; nonzero while rotating death animation runs
     003B             (adybug/src/main.s):00077         MULTIPLIER    equ $003B         ; score multiplier: 1,2,3,5
     003C             (adybug/src/main.s):00078         SPECIAL_BITS equ $003C         ; collected SPECIAL letters, bit per HUD position
     003D             (adybug/src/main.s):00079         EXTRA_BITS   equ $003D         ; collected EXTRA letters, bit per HUD position
     003E             (adybug/src/main.s):00080         ENTITY_PTR   equ $003E         ; u16 current entity record pointer
     0040             (adybug/src/main.s):00081         OBJ_SOURCE   equ $0040         ; u16 object-mask source pointer
     0042             (adybug/src/main.s):00082         OBJ_ROWS     equ $0042
     0043             (adybug/src/main.s):00083         OBJ_BYTES    equ $0043
     0044             (adybug/src/main.s):00084         OBJ_VALUE    equ $0044
     0045             (adybug/src/main.s):00085         OBJ_INDEX    equ $0045
     0046             (adybug/src/main.s):00086         OBJ_PRIMARY  equ $0046
     0047             (adybug/src/main.s):00087         OBJ_ACCENT   equ $0047
     0048             (adybug/src/main.s):00088         ENTITY_WORK  equ $0048         ; entity placement / loop scratch
     0049             (adybug/src/main.s):00089         ENTITY_TOTAL equ $0049         ; total records allocated this stage
     004A             (adybug/src/main.s):00090         BOX_TIMER    equ $004A         ; frames until next perimeter-box update
     004B             (adybug/src/main.s):00091         BOX_INDEX    equ $004B         ; clockwise perimeter position, 0..91
     004C             (adybug/src/main.s):00092         BOX_PHASE    equ $004C         ; 0=White-to-Green, 1=Green-to-White
     004D             (adybug/src/main.s):00093         DEATH_STATE  equ $004D         ; 0=alive, 1=shrink, 2=wings, 3=walk-off
     004E             (adybug/src/main.s):00094         DEATH_FRAME  equ $004E         ; selected curated death frame
     004F             (adybug/src/main.s):00095         PLAYER_ANIM  equ $004F         ; walk animation phase 0,1,2,3
     0050             (adybug/src/main.s):00096         PLAYER_ANIM_TIMER equ $0050    ; Vbord countdown to next player frame
     0051             (adybug/src/main.s):00097         PICKUP_TIMER equ $0051         ; score-sprite hold; zero when inactive
     0052             (adybug/src/main.s):00098         PICKUP_FRAME equ $0052         ; 0=100, 1=300, 2=800
     0053             (adybug/src/main.s):00099         ANGEL_SWING  equ $0053         ; 20-frame eased angel-swoop phase
     0054             (adybug/src/main.s):00100         ENEMY_ANIM   equ $0054         ; first den enemy animation phase
     0055             (adybug/src/main.s):00101         ENEMY_TIMER  equ $0055         ; Vbord countdown to next enemy frame
     0056             (adybug/src/main.s):00102         TURN_SNAP    equ $0056         ; diagonal late-turn updates remaining, 0..3
     0057             (adybug/src/main.s):00103         TURN_OLD     equ $0057         ; direction being corrected during late turn
     0058             (adybug/src/main.s):00104         ENEMY_ACTIVE equ $0058         ; active enemy count, reduced by skull deaths
     0059             (adybug/src/main.s):00105         ENEMY_RELEASED equ $0059       ; total timer releases this stage
     005A             (adybug/src/main.s):00106         VEG_STATE    equ $005A         ; 0=dormant enemy, 1=vegetable, 2=collected
     005B             (adybug/src/main.s):00107         FREEZE_TIMER equ $005B         ; u16 enemy freeze countdown
     005D             (adybug/src/main.s):00108         ENEMY_WORK   equ $005D         ; banked enemy loop scratch
     005E             (adybug/src/main.s):00109         ENEMY_PTR    equ $005E         ; u16 banked enemy record pointer
     0062             (adybug/src/main.s):00110         ENEMY_DEATH_LATCH equ $0062    ; 0=alive, 1=reset pending, 2=reset published
     0067             (adybug/src/main.s):00111         PLAYER_OLD_FB equ $0067        ; framebuffer pointer owned by PLAYER_BG
     0069             (adybug/src/main.s):00112         PLAYER_ERASED equ $0069        ; nonzero after old player background is exposed
     006A             (adybug/src/main.s):00113         PLAYER_BG_VALID equ $006A      ; PLAYER_BG contains restorable pixels
     006B             (adybug/src/main.s):00114         PLAYER_TICK_PENDING equ $006B  ; nonzero when next Vbord must update/render player
     006F             (adybug/src/main.s):00115         GATE_COMPOSE_MODE equ $006F    ; 0=diagonal intermediate, 1=final gate state
     02F0             (adybug/src/main.s):00116         BOOT_FLAG    equ $02F0         ; $A5 when GMC bootstrap relocated runtime to RAM
                      (adybug/src/main.s):00117         
     0000             (adybug/src/main.s):00118         DIR_NORTH     equ 0
     0001             (adybug/src/main.s):00119         DIR_EAST      equ 1
     0002             (adybug/src/main.s):00120         DIR_SOUTH     equ 2
     0003             (adybug/src/main.s):00121         DIR_WEST      equ 3
     00FF             (adybug/src/main.s):00122         DIR_NONE      equ $FF
     001E             (adybug/src/main.s):00123         PICKUP_HOLD_FRAMES equ 30      ; measured MAME frames 705-734 inclusive
                      (adybug/src/main.s):00124         
     0001             (adybug/src/main.s):00125         COLOR_RED         equ 1
     0002             (adybug/src/main.s):00126         COLOR_YELLOW      equ 2
     0008             (adybug/src/main.s):00127         COLOR_LIGHT_GREEN equ 8
     0003             (adybug/src/main.s):00128         COLOR_BLUE        equ 3
     0004             (adybug/src/main.s):00129         COLOR_PINK        equ 4
     0005             (adybug/src/main.s):00130         COLOR_GREEN       equ 5
     0006             (adybug/src/main.s):00131         COLOR_WHITE       equ 6
                      (adybug/src/main.s):00132         
     0000             (adybug/src/main.s):00133         ENTITY_NONE       equ 0
     0001             (adybug/src/main.s):00134         ENTITY_SKULL      equ 1
     0002             (adybug/src/main.s):00135         ENTITY_HEART      equ 2
     0003             (adybug/src/main.s):00136         ENTITY_LETTER     equ 3
                      (adybug/src/main.s):00137         
     0000             (adybug/src/main.s):00138         OBJECT_SKULL      equ 0
     0001             (adybug/src/main.s):00139         OBJECT_HEART      equ 1
     0002             (adybug/src/main.s):00140         OBJECT_A          equ 2
     0003             (adybug/src/main.s):00141         OBJECT_C          equ 3
     0004             (adybug/src/main.s):00142         OBJECT_E          equ 4
     0005             (adybug/src/main.s):00143         OBJECT_I          equ 5
     0006             (adybug/src/main.s):00144         OBJECT_L          equ 6
     0007             (adybug/src/main.s):00145         OBJECT_P          equ 7
     0008             (adybug/src/main.s):00146         OBJECT_R          equ 8
     0009             (adybug/src/main.s):00147         OBJECT_S          equ 9
     000A             (adybug/src/main.s):00148         OBJECT_T          equ 10
     000B             (adybug/src/main.s):00149         OBJECT_X          equ 11
                      (adybug/src/main.s):00150         
                      (adybug/src/main.s):00151         ;------------------------------------------------------------------------------
                      (adybug/src/main.s):00152         ; Hardware
                      (adybug/src/main.s):00153         ;------------------------------------------------------------------------------
     FF00             (adybug/src/main.s):00154         PIA1_DA    equ  $FF00
     FF01             (adybug/src/main.s):00155         PIA1_CRA   equ  $FF01
     FF02             (adybug/src/main.s):00156         PIA1_DB    equ  $FF02
     FF03             (adybug/src/main.s):00157         PIA1_CRB   equ  $FF03
     FF20             (adybug/src/main.s):00158         PIA2_DA    equ  $FF20
     FF21             (adybug/src/main.s):00159         PIA2_CRA   equ  $FF21
     FF22             (adybug/src/main.s):00160         PIA2_DB    equ  $FF22
     FF23             (adybug/src/main.s):00161         PIA2_CRB   equ  $FF23
                      (adybug/src/main.s):00162         
     FF90             (adybug/src/main.s):00163         GIME_INIT0 equ  $FF90
     FF92             (adybug/src/main.s):00164         GIME_IRQEN equ  $FF92
     FF98             (adybug/src/main.s):00165         GIME_VMODE equ  $FF98
     FF99             (adybug/src/main.s):00166         GIME_VRES  equ  $FF99
     FF9A             (adybug/src/main.s):00167         GIME_BORDER equ $FF9A
     FF9D             (adybug/src/main.s):00168         GIME_VOFF1 equ  $FF9D           ; addr bits Y18..Y11
     FF9E             (adybug/src/main.s):00169         GIME_VOFF0 equ  $FF9E           ; addr bits Y10..Y3
     FFA0             (adybug/src/main.s):00170         PAR_EXEC   equ  $FFA0           ; PAR0 of executive set ($FFA0..$FFA7)
     FFB0             (adybug/src/main.s):00171         PAL_BASE   equ  $FFB0
                      (adybug/src/main.s):00172         
     FFD9             (adybug/src/main.s):00173         SAM_FAST   equ  $FFD9
     FFDE             (adybug/src/main.s):00174         SAM_ROMRAM equ  $FFDE
                      (adybug/src/main.s):00175         
     FEF7             (adybug/src/main.s):00176         JT_IRQ     equ  $FEF7
                      (adybug/src/main.s):00177         
                      (adybug/src/main.s):00178         ;------------------------------------------------------------------------------
                      (adybug/src/main.s):00179         ; Memory map (post-Phase-2.3 with MMU on)
                      (adybug/src/main.s):00180         ;------------------------------------------------------------------------------
     2000             (adybug/src/main.s):00181         FB_VIRT    equ  $2000           ; virtual base of framebuffer (PAR1)
     9800             (adybug/src/main.s):00182         FB_END     equ  $9800           ; one past last FB byte (192 rows × 160 B)
     0030             (adybug/src/main.s):00183         FB_PHYS    equ  $30             ; physical page 0 of FB
     A000             (adybug/src/main.s):00184         MAZE_STATE equ  $A000           ; writable 576-byte maze-cell copy (PAR5)
     A240             (adybug/src/main.s):00185         GATE_STATE equ  $A240           ; rotation state N/W/S/E; parity selects H/V bar
     A300             (adybug/src/main.s):00186         PLAYER_BG  equ  $A300           ; 128-byte saved background under player
     A380             (adybug/src/main.s):00187         ENTITY_TABLE equ $A380          ; twelve x/y/type/variant records
     A3B0             (adybug/src/main.s):00188         PICKUP_BG   equ $A3B0          ; 64-byte background below score popup
     A3F0             (adybug/src/main.s):00189         PLAYER_STAGE equ $A3F0         ; 128-byte off-screen player composition surface
     57EC             (adybug/src/main.s):00190         ENEMY_FB    equ $57EC          ; top-left at lower nest cell (12,12)
     A470             (adybug/src/main.s):00191         ENEMY_TABLE equ $A470          ; four 8-byte active enemy records
     A490             (adybug/src/main.s):00192         ENEMY_ZONE_BG equ $A490        ; 256-byte clean 16-by-32 nest background
                      (adybug/src/main.s):00193         
     0800             (adybug/src/main.s):00194         ENEMY_MODULE_INIT    equ $0800
     0803             (adybug/src/main.s):00195         ENEMY_MODULE_TICK    equ $0803
     0806             (adybug/src/main.s):00196         ENEMY_MODULE_RELEASE equ $0806
     0809             (adybug/src/main.s):00197         ENEMY_MODULE_COLLECT equ $0809
     080C             (adybug/src/main.s):00198         PLAYER_MODULE_COMPOSE equ $080C
     080F             (adybug/src/main.s):00199         GATE_MODULE_COMPOSE equ $080F
                      (adybug/src/main.s):00200         
                      (adybug/src/main.s):00201         ;==============================================================================
                      (adybug/src/main.s):00202         ;  Cart ROM
                      (adybug/src/main.s):00203         ;==============================================================================
                      (adybug/src/main.s):00204                 org     $C000
                      (adybug/src/main.s):00205         
C000 444B             (adybug/src/main.s):00206                 fcc     "DK"            ; ROM-pack autostart magic; FIRQ -> $C002
                      (adybug/src/main.s):00207         
                      (adybug/src/main.s):00208         ;==============================================================================
                      (adybug/src/main.s):00209         ; entry
                      (adybug/src/main.s):00210         ;==============================================================================
C002 1A50             (adybug/src/main.s):00211         entry   orcc    #$50            ; mask IRQ + FIRQ
C004 10CE1FFE         (adybug/src/main.s):00212                 lds     #$1FFE          ; stack at top of low RAM page
                      (adybug/src/main.s):00213         
C008 4F               (adybug/src/main.s):00214                 clra                    ; DP = $00, shared with bank-3 runtime
C009 1F8B             (adybug/src/main.s):00215                 tfr     a,dp
                      (adybug/src/main.s):00216         
                      (adybug/src/main.s):00217                 ; --- Quiet legacy PIA interrupts ---
C00B 4F               (adybug/src/main.s):00218                 clra
C00C B7FF01           (adybug/src/main.s):00219                 sta     PIA1_CRA
C00F B7FF03           (adybug/src/main.s):00220                 sta     PIA1_CRB
C012 B7FF21           (adybug/src/main.s):00221                 sta     PIA2_CRA
C015 B7FF23           (adybug/src/main.s):00222                 sta     PIA2_CRB
C018 B6FF00           (adybug/src/main.s):00223                 lda     PIA1_DA
C01B B6FF02           (adybug/src/main.s):00224                 lda     PIA1_DB
C01E B6FF20           (adybug/src/main.s):00225                 lda     PIA2_DA
C021 B6FF22           (adybug/src/main.s):00226                 lda     PIA2_DB
                      (adybug/src/main.s):00227         
                      (adybug/src/main.s):00228                 ; --- Init0 — legacy mode, ACVC IRQ on, force $FExx, MMU still off ---
C024 86A8             (adybug/src/main.s):00229                 lda     #%10101000
C026 B7FF90           (adybug/src/main.s):00230                 sta     GIME_INIT0
C029 B602F0           (adybug/src/main.s):00231                 lda     BOOT_FLAG
C02C 81A5             (adybug/src/main.s):00232                 cmpa    #$A5
C02E 2703             (adybug/src/main.s):00233                 beq     entry_ram_loaded
C030 B7FFDE           (adybug/src/main.s):00234                 sta     SAM_ROMRAM       ; plain-cart fallback selects TY=0
C033                  (adybug/src/main.s):00235         entry_ram_loaded
                      (adybug/src/main.s):00236         
                      (adybug/src/main.s):00237                 ; --- Enter runtime from direct ROM or GMC-loaded RAM ---
                      (adybug/src/main.s):00238                 ; Direct fallback keeps TY=0. XRoar discards writes to the selected cartridge window,
                      (adybug/src/main.s):00239                 ; so the former same-address self-copy never populated phys $3E-$3F.
                      (adybug/src/main.s):00240                 ; PAR6=$3E keeps $C000-$DFFF cartridge-backed after MMU enable while
                      (adybug/src/main.s):00241                 ; the framebuffer and writable state use ordinary RAM pages below $3C.
                      (adybug/src/main.s):00242         
                      (adybug/src/main.s):00243                 ; --- Force executive PAR set ($FFA0-$FFA7) to be active ---
C033 7FFF91           (adybug/src/main.s):00244                 clr     $FF91
                      (adybug/src/main.s):00245         
                      (adybug/src/main.s):00246                 ; --- Set up MMU PARs (executive set) ---
                      (adybug/src/main.s):00247                 ; PAR0 ($0000) = phys $38   low RAM (DP, stack)
                      (adybug/src/main.s):00248                 ; PAR1 ($2000) = phys $30   FB page 0
                      (adybug/src/main.s):00249                 ; PAR2 ($4000) = phys $31   FB page 1
                      (adybug/src/main.s):00250                 ; PAR3 ($6000) = phys $32   FB page 2
                      (adybug/src/main.s):00251                 ; PAR4 ($8000) = phys $33   FB page 3
                      (adybug/src/main.s):00252                 ; PAR5 ($A000) = phys $34   game state (Phase 4+)
                      (adybug/src/main.s):00253                 ; PAR6 ($C000) = phys $3E   cartridge code (current 8 K window)
                      (adybug/src/main.s):00254                 ; PAR7 ($E000) = phys $3F   cartridge/ROM window + IO + jump table
C036 308D13AD         (adybug/src/main.s):00255                 leax    par_table,pcr
C03A 108EFFA0         (adybug/src/main.s):00256                 ldy     #PAR_EXEC
C03E C608             (adybug/src/main.s):00257                 ldb     #8
C040 A680             (adybug/src/main.s):00258         parloop lda     ,x+
C042 A7A0             (adybug/src/main.s):00259                 sta     ,y+
C044 5A               (adybug/src/main.s):00260                 decb
C045 26F9             (adybug/src/main.s):00261                 bne     parloop
                      (adybug/src/main.s):00262         
                      (adybug/src/main.s):00263                 ; --- Fast clock 1.78 MHz ---
C047 B7FFD9           (adybug/src/main.s):00264                 sta     SAM_FAST
                      (adybug/src/main.s):00265         
                      (adybug/src/main.s):00266                 ; --- Set up display (still blanked via CRES=11) ---
C04A 8680             (adybug/src/main.s):00267                 lda     #%10000000      ; BP=1 (graphics)
C04C B7FF98           (adybug/src/main.s):00268                 sta     GIME_VMODE
                      (adybug/src/main.s):00269         
