                      (verage/src/main.s):00001         ;==============================================================================
                      (verage/src/main.s):00002         ; Ladybug — main.s
                      (verage/src/main.s):00003         ;==============================================================================
                      (verage/src/main.s):00004         ; Phase 4: joystick-driven Lady Bug movement over the authored screen.
                      (verage/src/main.s):00005         ;
                      (verage/src/main.s):00006         ; Builds on Phase 2.3 (hi-res 320×192×16 + MMU + palette + IRQ tick) by:
                      (verage/src/main.s):00007         ;   - Compiling tiled/coco-screen.tmx into a one-byte tile map and a
                      (verage/src/main.s):00008         ;     deduplicated packed 4bpp tile atlas before assembly.
                      (verage/src/main.s):00009         ;   - Flattening visible Tiled layers and applying horizontal/vertical flips.
                      (verage/src/main.s):00010         ;   - blit_tile: 8 rows x 4 bytes, stride 160.
                      (verage/src/main.s):00011         ;   - Polling the right joystick through the PIA DAC/comparator path.
                      (verage/src/main.s):00012         ;   - Transparent 16x16 player frames with background save/restore.
                      (verage/src/main.s):00013         ;   - Semantic maze collision and dot removal.
                      (verage/src/main.s):00014         ;
                      (verage/src/main.s):00015         ; Visible: the authored screen with a moving, maze-constrained Lady Bug.
                      (verage/src/main.s):00016         ;==============================================================================
                      (verage/src/main.s):00017         
                      (verage/src/main.s):00018                 pragma  nodollarlocal,6809
                      (verage/src/main.s):00019         
                      (verage/src/main.s):00020         ;------------------------------------------------------------------------------
                      (verage/src/main.s):00021         ; DP allocation (page $00)
                      (verage/src/main.s):00022         ;------------------------------------------------------------------------------
     00               (verage/src/main.s):00023                 setdp   $00
                      (verage/src/main.s):00024         
     0000             (verage/src/main.s):00025         LAST_FRAME    equ $0000         ; last processed Vbord counter low byte
