                      (adybug/src/main.s):03156         ;   X — destination framebuffer byte address
                      (adybug/src/main.s):03157         ;   Y — packed 4bpp source data; colour 0 is transparent
                      (adybug/src/main.s):03158         ;
                      (adybug/src/main.s):03159         ; Returns: A, B, X, Y, CC undefined
