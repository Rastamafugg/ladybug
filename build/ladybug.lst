C8B5 7FFF00           (adybug/src/main.s):01526                 clr     PIA1_DA         ; all PA bits input, including comparator PA7
C8B8 7FFF03           (adybug/src/main.s):01527                 clr     PIA1_CRB        ; select PIA1 PB direction register
C8BB 86FF             (adybug/src/main.s):01528                 lda     #$FF
C8BD B7FF02           (adybug/src/main.s):01529                 sta     PIA1_DB         ; keyboard columns/output side
