C024 86A8             (adybug/src/main.s):00302                 lda     #%10101000
C026 B7FF90           (adybug/src/main.s):00303                 sta     GIME_INIT0
C029 B602F0           (adybug/src/main.s):00304                 lda     BOOT_FLAG
