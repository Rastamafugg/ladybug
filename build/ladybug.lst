                      (adybug/src/main.s):01440         ; init_joystick — configure the PIAs for right-joystick DAC conversion.
                      (adybug/src/main.s):01441         ;
                      (adybug/src/main.s):01442         ; Inputs:
                      (adybug/src/main.s):01443         ;   None
                      (adybug/src/main.s):01444         ;
                      (adybug/src/main.s):01445         ; Returns:
                      (adybug/src/main.s):01446         ;   A, CC — undefined
                      (adybug/src/main.s):01447         ;
                      (adybug/src/main.s):01448         ; Side effects:
                      (adybug/src/main.s):01449         ;   Configures PIA1 PA as input, PIA1 PB as output, PIA2 PA7-PA2 as DAC
                      (adybug/src/main.s):01450         ;   output, and selects/enables the right joystick analog multiplexer.
                      (adybug/src/main.s):01451         ;==============================================================================
