C8C3 7FFF01           (adybug/src/main.s):01537                 clr     PIA1_CRA        ; select PIA1 PA direction register
C8C6 7FFF00           (adybug/src/main.s):01538                 clr     PIA1_DA         ; all PA bits input, including comparator PA7
C8C9 7FFF03           (adybug/src/main.s):01539                 clr     PIA1_CRB        ; select PIA1 PB direction register
C8CC 86FF             (adybug/src/main.s):01540                 lda     #$FF
C8CE B7FF02           (adybug/src/main.s):01541                 sta     PIA1_DB         ; keyboard columns/output side
