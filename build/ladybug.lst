                      (adybug/src/main.s):00001         ;==============================================================================
                      (adybug/src/main.s):00002         ; Ladybug — main.s
                      (adybug/src/main.s):00003         ;==============================================================================
                      (adybug/src/main.s):00004         ; Phase 3: render the authored 40x24 Tiled screen to the framebuffer.
                      (adybug/src/main.s):00005         ;
                      (adybug/src/main.s):00006         ; Builds on Phase 2.3 (hi-res 320×192×16 + MMU + palette + IRQ tick) by:
                      (adybug/src/main.s):00007         ;   - Compiling tiled/coco-screen.tmx into a one-byte tile map and a
                      (adybug/src/main.s):00008         ;     deduplicated packed 4bpp tile atlas before assembly.
                      (adybug/src/main.s):00009         ;   - Flattening visible Tiled layers and applying horizontal/vertical flips.
                      (adybug/src/main.s):00010         ;   - blit_tile: 8 rows x 4 bytes, stride 160.
                      (adybug/src/main.s):00011         ;
                      (adybug/src/main.s):00012         ; Visible: the complete authored 40x24 maze and side-panel layout.
                      (adybug/src/main.s):00013         ;==============================================================================
                      (adybug/src/main.s):00014         
                      (adybug/src/main.s):00015                 pragma  nodollarlocal,6809
                      (adybug/src/main.s):00016         
                      (adybug/src/main.s):00017         ;------------------------------------------------------------------------------
                      (adybug/src/main.s):00018         ; DP allocation (page $02)
                      (adybug/src/main.s):00019         ;------------------------------------------------------------------------------
     02               (adybug/src/main.s):00020                 setdp   $02
                      (adybug/src/main.s):00021         
     0202             (adybug/src/main.s):00022         FRAMES  equ     $0202           ; u16 frame counter
                      (adybug/src/main.s):00023         
                      (adybug/src/main.s):00024         ;------------------------------------------------------------------------------
                      (adybug/src/main.s):00025         ; Hardware
                      (adybug/src/main.s):00026         ;------------------------------------------------------------------------------
     FF00             (adybug/src/main.s):00027         PIA1_DA    equ  $FF00
     FF01             (adybug/src/main.s):00028         PIA1_CRA   equ  $FF01
     FF02             (adybug/src/main.s):00029         PIA1_DB    equ  $FF02
     FF03             (adybug/src/main.s):00030         PIA1_CRB   equ  $FF03
     FF20             (adybug/src/main.s):00031         PIA2_DA    equ  $FF20
     FF21             (adybug/src/main.s):00032         PIA2_CRA   equ  $FF21
     FF22             (adybug/src/main.s):00033         PIA2_DB    equ  $FF22
     FF23             (adybug/src/main.s):00034         PIA2_CRB   equ  $FF23
                      (adybug/src/main.s):00035         
     FF90             (adybug/src/main.s):00036         GIME_INIT0 equ  $FF90
     FF92             (adybug/src/main.s):00037         GIME_IRQEN equ  $FF92
     FF98             (adybug/src/main.s):00038         GIME_VMODE equ  $FF98
     FF99             (adybug/src/main.s):00039         GIME_VRES  equ  $FF99
     FF9A             (adybug/src/main.s):00040         GIME_BORDER equ $FF9A
     FF9D             (adybug/src/main.s):00041         GIME_VOFF1 equ  $FF9D           ; addr bits Y18..Y11
     FF9E             (adybug/src/main.s):00042         GIME_VOFF0 equ  $FF9E           ; addr bits Y10..Y3
     FFA0             (adybug/src/main.s):00043         PAR_EXEC   equ  $FFA0           ; PAR0 of executive set ($FFA0..$FFA7)
     FFB0             (adybug/src/main.s):00044         PAL_BASE   equ  $FFB0
                      (adybug/src/main.s):00045         
     FFD9             (adybug/src/main.s):00046         SAM_FAST   equ  $FFD9
     FFDE             (adybug/src/main.s):00047         SAM_ROMRAM equ  $FFDE
                      (adybug/src/main.s):00048         
     FEF7             (adybug/src/main.s):00049         JT_IRQ     equ  $FEF7
                      (adybug/src/main.s):00050         
                      (adybug/src/main.s):00051         ;------------------------------------------------------------------------------
                      (adybug/src/main.s):00052         ; Memory map (post-Phase-2.3 with MMU on)
                      (adybug/src/main.s):00053         ;------------------------------------------------------------------------------
     2000             (adybug/src/main.s):00054         FB_VIRT    equ  $2000           ; virtual base of framebuffer (PAR1)
     9800             (adybug/src/main.s):00055         FB_END     equ  $9800           ; one past last FB byte (192 rows × 160 B)
     0030             (adybug/src/main.s):00056         FB_PHYS    equ  $30             ; physical page 0 of FB
                      (adybug/src/main.s):00057         
                      (adybug/src/main.s):00058         ;==============================================================================
                      (adybug/src/main.s):00059         ;  Cart ROM
                      (adybug/src/main.s):00060         ;==============================================================================
                      (adybug/src/main.s):00061                 org     $C000
                      (adybug/src/main.s):00062         
C000 444B             (adybug/src/main.s):00063                 fcc     "DK"            ; ROM-pack autostart magic; FIRQ -> $C002
                      (adybug/src/main.s):00064         
                      (adybug/src/main.s):00065         ;==============================================================================
                      (adybug/src/main.s):00066         ; entry
                      (adybug/src/main.s):00067         ;==============================================================================
C002 1A50             (adybug/src/main.s):00068         entry   orcc    #$50            ; mask IRQ + FIRQ
C004 10CE1FFE         (adybug/src/main.s):00069                 lds     #$1FFE          ; stack at top of low RAM page
                      (adybug/src/main.s):00070         
C008 8602             (adybug/src/main.s):00071                 lda     #$02            ; DP = $02
C00A 1F8B             (adybug/src/main.s):00072                 tfr     a,dp
                      (adybug/src/main.s):00073         
                      (adybug/src/main.s):00074                 ; --- Quiet legacy PIA interrupts ---
C00C 4F               (adybug/src/main.s):00075                 clra
C00D B7FF01           (adybug/src/main.s):00076                 sta     PIA1_CRA
C010 B7FF03           (adybug/src/main.s):00077                 sta     PIA1_CRB
C013 B7FF21           (adybug/src/main.s):00078                 sta     PIA2_CRA
C016 B7FF23           (adybug/src/main.s):00079                 sta     PIA2_CRB
C019 B6FF00           (adybug/src/main.s):00080                 lda     PIA1_DA
C01C B6FF02           (adybug/src/main.s):00081                 lda     PIA1_DB
C01F B6FF20           (adybug/src/main.s):00082                 lda     PIA2_DA
C022 B6FF22           (adybug/src/main.s):00083                 lda     PIA2_DB
                      (adybug/src/main.s):00084         
                      (adybug/src/main.s):00085                 ; --- Init0 — legacy mode, ACVC IRQ on, force $FExx, MMU still off ---
C025 86A8             (adybug/src/main.s):00086                 lda     #%10101000
C027 B7FF90           (adybug/src/main.s):00087                 sta     GIME_INIT0
C02A B7FFDE           (adybug/src/main.s):00088                 sta     SAM_ROMRAM       ; cart map is selected before clearing TY
                      (adybug/src/main.s):00089         
                      (adybug/src/main.s):00090                 ; --- Execute directly from cartridge ROM ---
                      (adybug/src/main.s):00091                 ; Keep TY=0. XRoar discards writes to the selected cartridge window,
                      (adybug/src/main.s):00092                 ; so the former same-address self-copy never populated phys $3E-$3F.
                      (adybug/src/main.s):00093                 ; PAR6=$3E keeps $C000-$DFFF cartridge-backed after MMU enable while
                      (adybug/src/main.s):00094                 ; the framebuffer and writable state use ordinary RAM pages below $3C.
                      (adybug/src/main.s):00095         
                      (adybug/src/main.s):00096                 ; --- Force executive PAR set ($FFA0-$FFA7) to be active ---
C02D 7FFF91           (adybug/src/main.s):00097                 clr     $FF91
                      (adybug/src/main.s):00098         
                      (adybug/src/main.s):00099                 ; --- Set up MMU PARs (executive set) ---
                      (adybug/src/main.s):00100                 ; PAR0 ($0000) = phys $38   low RAM (DP, stack)
                      (adybug/src/main.s):00101                 ; PAR1 ($2000) = phys $30   FB page 0
                      (adybug/src/main.s):00102                 ; PAR2 ($4000) = phys $31   FB page 1
                      (adybug/src/main.s):00103                 ; PAR3 ($6000) = phys $32   FB page 2
                      (adybug/src/main.s):00104                 ; PAR4 ($8000) = phys $33   FB page 3
                      (adybug/src/main.s):00105                 ; PAR5 ($A000) = phys $34   game state (Phase 4+)
                      (adybug/src/main.s):00106                 ; PAR6 ($C000) = phys $3E   cartridge code (current 8 K window)
                      (adybug/src/main.s):00107                 ; PAR7 ($E000) = phys $3F   cartridge/ROM window + IO + jump table
C030 308D00DC         (adybug/src/main.s):00108                 leax    par_table,pcr
C034 108EFFA0         (adybug/src/main.s):00109                 ldy     #PAR_EXEC
C038 C608             (adybug/src/main.s):00110                 ldb     #8
C03A A680             (adybug/src/main.s):00111         parloop lda     ,x+
C03C A7A0             (adybug/src/main.s):00112                 sta     ,y+
C03E 5A               (adybug/src/main.s):00113                 decb
C03F 26F9             (adybug/src/main.s):00114                 bne     parloop
                      (adybug/src/main.s):00115         
                      (adybug/src/main.s):00116                 ; --- Fast clock 1.78 MHz ---
C041 B7FFD9           (adybug/src/main.s):00117                 sta     SAM_FAST
                      (adybug/src/main.s):00118         
                      (adybug/src/main.s):00119                 ; --- Set up display (still blanked via CRES=11) ---
C044 8680             (adybug/src/main.s):00120                 lda     #%10000000      ; BP=1 (graphics)
C046 B7FF98           (adybug/src/main.s):00121                 sta     GIME_VMODE
                      (adybug/src/main.s):00122         
C049 861F             (adybug/src/main.s):00123                 lda     #$1F            ; VRES=00 HRES=111 CRES=11 (BLANKED)
C04B B7FF99           (adybug/src/main.s):00124                 sta     GIME_VRES
                      (adybug/src/main.s):00125         
C04E 8628             (adybug/src/main.s):00126                 lda     #$28            ; bright border (empirically "pink") so a black
C050 B7FF9A           (adybug/src/main.s):00127                 sta     GIME_BORDER     ;   stripe 0 is visually distinct from the border
                      (adybug/src/main.s):00128         
                      (adybug/src/main.s):00129                 ; FB at phys $30 → physical address $060000.
                      (adybug/src/main.s):00130                 ;   Y18=1, Y17=1, Y16..Y3 = 0
                      (adybug/src/main.s):00131                 ;   V1 ($FF9D) = Y18..Y11 = %11000000 = $C0
                      (adybug/src/main.s):00132                 ;   V0 ($FF9E) = Y10..Y3  = $00
C053 86C0             (adybug/src/main.s):00133                 lda     #$C0
C055 B7FF9D           (adybug/src/main.s):00134                 sta     GIME_VOFF1
C058 7FFF9E           (adybug/src/main.s):00135                 clr     GIME_VOFF0
                      (adybug/src/main.s):00136         
                      (adybug/src/main.s):00137                 ; --- Init0 — turn on MMU + switch to hi-res. Display still blanked. ---
                      (adybug/src/main.s):00138                 ; %01101000 = COCO=0 MMU=1 ACVCIRQ=1 ACVCFIRQ=0 force-$FExx=1 SCS=0 ROMmap=00
C05B 8668             (adybug/src/main.s):00139                 lda     #%01101000
C05D B7FF90           (adybug/src/main.s):00140                 sta     GIME_INIT0
                      (adybug/src/main.s):00141         
                      (adybug/src/main.s):00142                 ; --- Load palette (16 entries) ---
C060 308D00B4         (adybug/src/main.s):00143                 leax    palette_table,pcr
C064 108EFFB0         (adybug/src/main.s):00144                 ldy     #PAL_BASE
C068 C610             (adybug/src/main.s):00145                 ldb     #16
C06A A680             (adybug/src/main.s):00146         palloop lda     ,x+
C06C A7A0             (adybug/src/main.s):00147                 sta     ,y+
C06E 5A               (adybug/src/main.s):00148                 decb
C06F 26F9             (adybug/src/main.s):00149                 bne     palloop
                      (adybug/src/main.s):00150         
                      (adybug/src/main.s):00151                 ; --- Clear FB to palette idx 0 (black) ---
                      (adybug/src/main.s):00152                 ; 30720 bytes = 15360 STDs.
C071 8E2000           (adybug/src/main.s):00153                 ldx     #FB_VIRT
C074 CC0000           (adybug/src/main.s):00154                 ldd     #$0000
C077 ED81             (adybug/src/main.s):00155         clr_fb  std     ,x++
C079 8C9800           (adybug/src/main.s):00156                 cmpx    #FB_END
C07C 25F9             (adybug/src/main.s):00157                 blo     clr_fb
                      (adybug/src/main.s):00158         
                      (adybug/src/main.s):00159                 ; --- Phase 3 authored screen ---
C07E 170033           (adybug/src/main.s):00160                 lbsr    draw_screen
                      (adybug/src/main.s):00161         
                      (adybug/src/main.s):00162                 ; --- Un-blank: 320×192×16 (CRES=10 + HRES=111 → 4bpp on this build) ---
C081 861E             (adybug/src/main.s):00163                 lda     #$1E
C083 B7FF99           (adybug/src/main.s):00164                 sta     GIME_VRES
                      (adybug/src/main.s):00165         
                      (adybug/src/main.s):00166                 ; Phase 3 isolation: halt here so the visible state is just the
                      (adybug/src/main.s):00167                 ; authored static screen. The IRQ install + Vbord enable below is
                      (adybug/src/main.s):00168                 ; carried over from Phase 2.3 but has not been re-verified against
                      (adybug/src/main.s):00169                 ; the new MMU/PAR layout — leaving it disabled until that's done.
                      (adybug/src/main.s):00170         
                      (adybug/src/main.s):00171                 ; --- L4 probe: write sentinel to JT_IRQ, persist readback + marker,
                      (adybug/src/main.s):00172                 ;     fall through to phase3_halt for trap-snap capture.
C086 8655             (adybug/src/main.s):00173                 lda     #$55
C088 B7FEF7           (adybug/src/main.s):00174                 sta     JT_IRQ          ; the suspect store
C08B B6FEF7           (adybug/src/main.s):00175                 lda     JT_IRQ
C08E B70FFE           (adybug/src/main.s):00176                 sta     $0FFE           ; readback of $FEF7
C091 86AA             (adybug/src/main.s):00177                 lda     #$AA
C093 B70FFF           (adybug/src/main.s):00178                 sta     $0FFF           ; liveness marker
C096                  (adybug/src/main.s):00179         phase3_halt
C096 20FE             (adybug/src/main.s):00180                 bra     phase3_halt
                      (adybug/src/main.s):00181         
                      (adybug/src/main.s):00182                 ; --- IRQ handler at $FEF7 jump-table slot ---
C098 867E             (adybug/src/main.s):00183                 lda     #$7E            ; JMP extended
C09A B7FEF7           (adybug/src/main.s):00184                 sta     JT_IRQ
C09D CCC106           (adybug/src/main.s):00185                 ldd     #irq_handler
C0A0 FDFEF8           (adybug/src/main.s):00186                 std     JT_IRQ+1
                      (adybug/src/main.s):00187         
C0A3 0F02             (adybug/src/main.s):00188                 clr     FRAMES
C0A5 0F03             (adybug/src/main.s):00189                 clr     FRAMES+1
                      (adybug/src/main.s):00190         
                      (adybug/src/main.s):00191                 ; --- Enable Vbord ---
C0A7 8608             (adybug/src/main.s):00192                 lda     #%00001000
C0A9 B7FF92           (adybug/src/main.s):00193                 sta     GIME_IRQEN
C0AC B6FF92           (adybug/src/main.s):00194                 lda     GIME_IRQEN
                      (adybug/src/main.s):00195         
C0AF 1CEF             (adybug/src/main.s):00196                 andcc   #%11101111      ; unmask IRQ
                      (adybug/src/main.s):00197         
                      (adybug/src/main.s):00198         ;==============================================================================
                      (adybug/src/main.s):00199         ; mainloop — IRQ keeps ticking FRAMES; CPU just spins.
                      (adybug/src/main.s):00200         ;==============================================================================
C0B1                  (adybug/src/main.s):00201         mainloop
C0B1 13               (adybug/src/main.s):00202                 sync
C0B2 20FD             (adybug/src/main.s):00203                 bra     mainloop
                      (adybug/src/main.s):00204         
                      (adybug/src/main.s):00205         ;==============================================================================
                      (adybug/src/main.s):00206         ; draw_screen — render the compiled 40x24 tile map.
                      (adybug/src/main.s):00207         ;
                      (adybug/src/main.s):00208         ; Inputs:
                      (adybug/src/main.s):00209         ;   None
                      (adybug/src/main.s):00210         ;
                      (adybug/src/main.s):00211         ; Returns:
                      (adybug/src/main.s):00212         ;   A, B, X, Y, U, D, CC — undefined
                      (adybug/src/main.s):00213         ;
                      (adybug/src/main.s):00214         ; Side effects:
                      (adybug/src/main.s):00215         ;   Writes 960 8x8 tiles in row-major order to the framebuffer.
                      (adybug/src/main.s):00216         ;==============================================================================
C0B4                  (adybug/src/main.s):00217         draw_screen
C0B4 338D0070         (adybug/src/main.s):00218                 leau    screen_map,pcr
C0B8 8E2000           (adybug/src/main.s):00219                 ldx     #FB_VIRT
C0BB 8618             (adybug/src/main.s):00220                 lda     #SCREEN_HEIGHT
C0BD                  (adybug/src/main.s):00221         ds_row
C0BD 3402             (adybug/src/main.s):00222                 pshs    a
C0BF 8628             (adybug/src/main.s):00223                 lda     #SCREEN_WIDTH
C0C1                  (adybug/src/main.s):00224         ds_column
C0C1 3412             (adybug/src/main.s):00225                 pshs    a,x
C0C3 E6C0             (adybug/src/main.s):00226                 ldb     ,u+
C0C5 4F               (adybug/src/main.s):00227                 clra
C0C6 58               (adybug/src/main.s):00228                 lslb
C0C7 49               (adybug/src/main.s):00229                 rola
C0C8 58               (adybug/src/main.s):00230                 lslb
C0C9 49               (adybug/src/main.s):00231                 rola
C0CA 58               (adybug/src/main.s):00232                 lslb
C0CB 49               (adybug/src/main.s):00233                 rola
C0CC 58               (adybug/src/main.s):00234                 lslb
C0CD 49               (adybug/src/main.s):00235                 rola
C0CE 58               (adybug/src/main.s):00236                 lslb
C0CF 49               (adybug/src/main.s):00237                 rola
C0D0 318D0414         (adybug/src/main.s):00238                 leay    screen_tiles,pcr
C0D4 31AB             (adybug/src/main.s):00239                 leay    d,y
C0D6 170011           (adybug/src/main.s):00240                 lbsr    blit_tile
C0D9 3512             (adybug/src/main.s):00241                 puls    a,x
C0DB 3004             (adybug/src/main.s):00242                 leax    4,x
C0DD 4A               (adybug/src/main.s):00243                 deca
C0DE 26E1             (adybug/src/main.s):00244                 bne     ds_column
C0E0 3502             (adybug/src/main.s):00245                 puls    a
C0E2 30890460         (adybug/src/main.s):00246                 leax    1120,x
C0E6 4A               (adybug/src/main.s):00247                 deca
C0E7 26D4             (adybug/src/main.s):00248                 bne     ds_row
C0E9 39               (adybug/src/main.s):00249                 rts
                      (adybug/src/main.s):00250         
                      (adybug/src/main.s):00251         ;==============================================================================
                      (adybug/src/main.s):00252         ; blit_tile — copy an 8x8 tile to a framebuffer byte address.
                      (adybug/src/main.s):00253         ;
                      (adybug/src/main.s):00254         ; Inputs:
                      (adybug/src/main.s):00255         ;   X — destination framebuffer byte address
                      (adybug/src/main.s):00256         ;   Y — source glyph data, 32 packed 4bpp bytes
                      (adybug/src/main.s):00257         ;
                      (adybug/src/main.s):00258         ; Returns:
                      (adybug/src/main.s):00259         ;   A, B, D, X, Y, U, CC — undefined
                      (adybug/src/main.s):00260         ;
                      (adybug/src/main.s):00261         ; Side effects:
                      (adybug/src/main.s):00262         ;   Writes 8 rows x 4 bytes; advances 156 bytes after each written row.
                      (adybug/src/main.s):00263         ;==============================================================================
C0EA                  (adybug/src/main.s):00264         blit_tile
                      (adybug/src/main.s):00265                 ; ldd ,y++ clobbers B, so use a Y-vs-sentinel loop instead of decb.
                      (adybug/src/main.s):00266                 ; See wiki/internal/implementation/lessons-learned.html
                      (adybug/src/main.s):00267                 ; §"LDD ,Y++ clobbers B".
C0EA 3440             (adybug/src/main.s):00268                 pshs    u
C0EC 33A820           (adybug/src/main.s):00269                 leau    32,y            ; sentinel = end of tile data
C0EF 3440             (adybug/src/main.s):00270                 pshs    u
C0F1 ECA1             (adybug/src/main.s):00271         btrow   ldd     ,y++
C0F3 ED81             (adybug/src/main.s):00272                 std     ,x++
C0F5 ECA1             (adybug/src/main.s):00273                 ldd     ,y++
C0F7 ED81             (adybug/src/main.s):00274                 std     ,x++
C0F9 3089009C         (adybug/src/main.s):00275                 leax    156,x           ; advance to next FB row, same column
C0FD 10ACE4           (adybug/src/main.s):00276                 cmpy    ,s
C100 25EF             (adybug/src/main.s):00277                 blo     btrow
C102 3262             (adybug/src/main.s):00278                 leas    2,s
C104 35C0             (adybug/src/main.s):00279                 puls    u,pc
                      (adybug/src/main.s):00280         
                      (adybug/src/main.s):00281         ;==============================================================================
                      (adybug/src/main.s):00282         ; irq_handler — Vbord (60 Hz)
                      (adybug/src/main.s):00283         ;==============================================================================
C106                  (adybug/src/main.s):00284         irq_handler
C106 B6FF92           (adybug/src/main.s):00285                 lda     GIME_IRQEN
C109 0C03             (adybug/src/main.s):00286                 inc     FRAMES+1
C10B 2602             (adybug/src/main.s):00287                 bne     irq_done
C10D 0C02             (adybug/src/main.s):00288                 inc     FRAMES
C10F                  (adybug/src/main.s):00289         irq_done
C10F 3B               (adybug/src/main.s):00290                 rti
                      (adybug/src/main.s):00291         
                      (adybug/src/main.s):00292         ;==============================================================================
                      (adybug/src/main.s):00293         ; Data tables (read directly from cartridge ROM)
                      (adybug/src/main.s):00294         ;==============================================================================
                      (adybug/src/main.s):00295         
                      (adybug/src/main.s):00296         ;-- PAR values for executive set (PAR0..PAR7) ---------------------------------
C110                  (adybug/src/main.s):00297         par_table
C110 3830313233343E3F (adybug/src/main.s):00298                 fcb     $38,$30,$31,$32,$33,$34,$3E,$3F
                      (adybug/src/main.s):00299         
                      (adybug/src/main.s):00300         ;-- Build-generated palette, screen map, and packed tile atlas. --------------
                      (adybug/src/main.s):00301         ;   scripts/build.sh compiles tiled/coco-screen.tmx with arcade character data
                      (adybug/src/main.s):00302         ;   before invoking lwasm.
                      (adybug/src/main.s):00303                 include "ladybug_screen.inc"
