     0011             (erf003/src/main.s):00040         TEST_Y        equ $0011         ; candidate/draw maze row
     0012             (erf003/src/main.s):00041         TEST_DIR      equ $0012         ; direction under collision test
     0013             (erf003/src/main.s):00042         GATE_ID       equ $0013         ; active gate index
