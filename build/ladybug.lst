                      (rf-001/src/main.s):01754         ; init_joystick — configure the PIAs for right-joystick DAC conversion.
                      (rf-001/src/main.s):01755         ;
                      (rf-001/src/main.s):01756         ; Inputs:
                      (rf-001/src/main.s):01757         ;   None
                      (rf-001/src/main.s):01758         ;
                      (rf-001/src/main.s):01759         ; Returns:
                      (rf-001/src/main.s):01760         ;   A, CC — undefined
                      (rf-001/src/main.s):01761         ;
                      (rf-001/src/main.s):01762         ; Side effects:
                      (rf-001/src/main.s):01763         ;   Configures PIA1 PA as input, PIA1 PB as output, PIA2 PA7-PA2 as DAC
                      (rf-001/src/main.s):01764         ;   output, and selects/enables the right joystick analog multiplexer.
                      (rf-001/src/main.s):01765         ;==============================================================================
