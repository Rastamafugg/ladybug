     002E             (adybug/src/main.s):00065         HUD_BCD_COUNT equ $002E         ; packed BCD byte loop
     002F             (adybug/src/main.s):00066         BONUS_COLOR   equ $002F         ; global bonus colour, palette index
     0030             (adybug/src/main.s):00067         BONUS_TIMER   equ $0030         ; u16 frames remaining in current colour
