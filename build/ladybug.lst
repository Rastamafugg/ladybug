                      (adybug/src/main.s):01516         ;   A, CC — undefined
                      (adybug/src/main.s):01517         ;
                      (adybug/src/main.s):01518         ; Side effects:
                      (adybug/src/main.s):01519         ;   Configures PIA1 PA as input, PIA1 PB as output, PIA2 PA7-PA2 as DAC
