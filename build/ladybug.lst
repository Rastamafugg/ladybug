C8D0 8604             (adybug/src/main.s):01535                 lda     #$04            ; data-register access
C8D2 B7FF21           (adybug/src/main.s):01536                 sta     PIA2_CRA
C8D5 7FFF23           (adybug/src/main.s):01537                 clr     PIA2_CRB
C8D8 8634             (adybug/src/main.s):01538                 lda     #$34            ; static CB2 low enables analog multiplexer
C8DA B7FF23           (adybug/src/main.s):01539                 sta     PIA2_CRB
C8DD 8680             (adybug/src/main.s):01540                 lda     #$80            ; centre DAC while idle
C8DF B7FF20           (adybug/src/main.s):01541                 sta     PIA2_DA
