                      (ration/src/main.s):00426         ;==============================================================================
                      (ration/src/main.s):00427         ;  Cart ROM
                      (ration/src/main.s):00428         ;==============================================================================
                      (ration/src/main.s):00429                 org     $C000
                      (ration/src/main.s):00430         
C000 444B             (ration/src/main.s):00431                 fcc     "DK"            ; ROM-pack autostart magic; FIRQ -> $C002
                      (ration/src/main.s):00432         
                      (ration/src/main.s):00433         ;==============================================================================
                      (ration/src/main.s):00434         ; entry
                      (ration/src/main.s):00435         ;==============================================================================
C002 1A50             (ration/src/main.s):00436         entry   orcc    #$50            ; mask IRQ + FIRQ
C004 10CE1FFE         (ration/src/main.s):00437                 lds     #$1FFE          ; stack at top of low RAM page
                      (ration/src/main.s):00438         
C008 4F               (ration/src/main.s):00439                 clra                    ; DP = $00, shared with bank-3 runtime
C009 1F8B             (ration/src/main.s):00440                 tfr     a,dp
                      (ration/src/main.s):00441         
                      (ration/src/main.s):00442                 ; --- Quiet legacy PIA interrupts ---
C00B 4F               (ration/src/main.s):00443                 clra
C00C B7FF01           (ration/src/main.s):00444                 sta     PIA1_CRA
C00F B7FF03           (ration/src/main.s):00445                 sta     PIA1_CRB
C012 B7FF21           (ration/src/main.s):00446                 sta     PIA2_CRA
C015 B7FF23           (ration/src/main.s):00447                 sta     PIA2_CRB
C018 B6FF00           (ration/src/main.s):00448                 lda     PIA1_DA
C01B B6FF02           (ration/src/main.s):00449                 lda     PIA1_DB
C01E B6FF20           (ration/src/main.s):00450                 lda     PIA2_DA
C021 B6FF22           (ration/src/main.s):00451                 lda     PIA2_DB
                      (ration/src/main.s):00452         
                      (ration/src/main.s):00453                 ; --- Init0 — legacy mode, ACVC IRQ on, force $FExx, MMU still off ---
C024 86A8             (ration/src/main.s):00454                 lda     #%10101000
C026 B7FF90           (ration/src/main.s):00455                 sta     GIME_INIT0
C029 B602F0           (ration/src/main.s):00456                 lda     BOOT_FLAG
C02C 81A5             (ration/src/main.s):00457                 cmpa    #$A5
C02E 2703             (ration/src/main.s):00458                 beq     entry_ram_loaded
C030 B7FFDE           (ration/src/main.s):00459                 sta     SAM_ROMRAM       ; plain-cart fallback selects TY=0
C033                  (ration/src/main.s):00460         entry_ram_loaded
                      (ration/src/main.s):00461         
                      (ration/src/main.s):00462                 ; --- Enter runtime from direct ROM or GMC-loaded RAM ---
                      (ration/src/main.s):00463                 ; Direct fallback keeps TY=0. XRoar discards writes to the selected cartridge window,
                      (ration/src/main.s):00464                 ; so the former same-address self-copy never populated phys $3E-$3F.
                      (ration/src/main.s):00465                 ; PAR6=$3E keeps $C000-$DFFF cartridge-backed after MMU enable while
                      (ration/src/main.s):00466                 ; the framebuffer and writable state use ordinary RAM pages below $3C.
                      (ration/src/main.s):00467         
C033                  (ration/src/main.s):00468         startup_par_setup_entry
                      (ration/src/main.s):00469                 ; --- Force executive PAR set ($FFA0-$FFA7) to be active ---
C033 7FFF91           (ration/src/main.s):00470                 clr     $FF91
C036                  (ration/src/main.s):00471         startup_init1_complete
                      (ration/src/main.s):00472         
                      (ration/src/main.s):00473                 ; --- Set up MMU PARs (executive set) ---
                      (ration/src/main.s):00474                 ; PAR0 ($0000) = phys $38   low RAM (DP, stack)
                      (ration/src/main.s):00475                 ; PAR1 ($2000) = phys $30   FB page 0
                      (ration/src/main.s):00476                 ; PAR2 ($4000) = phys $31   FB page 1
                      (ration/src/main.s):00477                 ; PAR3 ($6000) = phys $32   FB page 2
                      (ration/src/main.s):00478                 ; PAR4 ($8000) = phys $33   FB page 3
                      (ration/src/main.s):00479                 ; PAR5 ($A000) = phys $34   game state (Phase 4+)
                      (ration/src/main.s):00480                 ; PAR6 ($C000) = phys $3E   cartridge code (current 8 K window)
                      (ration/src/main.s):00481                 ; PAR7 ($E000) = phys $3F   cartridge/ROM window + IO + jump table
