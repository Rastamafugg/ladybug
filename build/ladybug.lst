                      (ration/src/main.s):00147         ; Phase 4: joystick-driven Lady Bug movement over the authored screen.
                      (ration/src/main.s):00148         ;
                      (ration/src/main.s):00149         ; Builds on Phase 2.3 (hi-res 320×192×16 + MMU + palette + IRQ tick) by:
                      (ration/src/main.s):00150         ;   - Compiling tiled/coco-screen.tmx into a one-byte tile map and a
                      (ration/src/main.s):00151         ;     deduplicated packed 4bpp tile atlas before assembly.
                      (ration/src/main.s):00152         ;   - Flattening visible Tiled layers and applying horizontal/vertical flips.
                      (ration/src/main.s):00153         ;   - blit_tile: 8 rows x 4 bytes, stride 160.
                      (ration/src/main.s):00154         ;   - Polling the right joystick through the PIA DAC/comparator path.
                      (ration/src/main.s):00155         ;   - Transparent 16x16 player frames with background save/restore.
                      (ration/src/main.s):00156         ;   - Semantic maze collision and dot removal.
                      (ration/src/main.s):00157         ;
                      (ration/src/main.s):00158         ; Visible: the authored screen with a moving, maze-constrained Lady Bug.
                      (ration/src/main.s):00159         ;==============================================================================
                      (ration/src/main.s):00160         
                      (ration/src/main.s):00161                 pragma  nodollarlocal,6809
                      (ration/src/main.s):00162         
                      (ration/src/main.s):00163         ;------------------------------------------------------------------------------
                      (ration/src/main.s):00164         ; DP allocation (page $00)
                      (ration/src/main.s):00165         ;------------------------------------------------------------------------------
     00               (ration/src/main.s):00166                 setdp   $00
