                      (adybug/src/main.s):00001         ;==============================================================================
                      (adybug/src/main.s):00002         ; Ladybug — main.s
                      (adybug/src/main.s):00003         ;==============================================================================
                      (adybug/src/main.s):00004         ; Phase 4: joystick-driven Lady Bug movement over the authored screen.
                      (adybug/src/main.s):00005         ;
                      (adybug/src/main.s):00006         ; Builds on Phase 2.3 (hi-res 320×192×16 + MMU + palette + IRQ tick) by:
                      (adybug/src/main.s):00007         ;   - Compiling tiled/coco-screen.tmx into a one-byte tile map and a
                      (adybug/src/main.s):00008         ;     deduplicated packed 4bpp tile atlas before assembly.
                      (adybug/src/main.s):00009         ;   - Flattening visible Tiled layers and applying horizontal/vertical flips.
                      (adybug/src/main.s):00010         ;   - blit_tile: 8 rows x 4 bytes, stride 160.
                      (adybug/src/main.s):00011         ;   - Polling the right joystick through the PIA DAC/comparator path.
                      (adybug/src/main.s):00012         ;   - Transparent 16x16 player frames with background save/restore.
                      (adybug/src/main.s):00013         ;   - Semantic maze collision and dot removal.
                      (adybug/src/main.s):00014         ;
                      (adybug/src/main.s):00015         ; Visible: the authored screen with a moving, maze-constrained Lady Bug.
                      (adybug/src/main.s):00016         ;==============================================================================
                      (adybug/src/main.s):00017         
                      (adybug/src/main.s):00018                 pragma  nodollarlocal,6809
                      (adybug/src/main.s):00019         
                      (adybug/src/main.s):00020         ;------------------------------------------------------------------------------
                      (adybug/src/main.s):00021         ; DP allocation (page $02)
                      (adybug/src/main.s):00022         ;------------------------------------------------------------------------------
     02               (adybug/src/main.s):00023                 setdp   $02
                      (adybug/src/main.s):00024         
     0200             (adybug/src/main.s):00025         LAST_FRAME    equ $0200         ; last processed Vbord counter low byte
     0201             (adybug/src/main.s):00026         JOY_X         equ $0201         ; right joystick X, 0..63
     0202             (adybug/src/main.s):00027         FRAMES        equ $0202         ; u16 frame counter
     0204             (adybug/src/main.s):00028         JOY_Y         equ $0204         ; right joystick Y, 0..63
     0205             (adybug/src/main.s):00029         JOY_DIR       equ $0205         ; requested direction or $FF
     0206             (adybug/src/main.s):00030         PLAYER_DIR    equ $0206         ; active direction or $FF
     0207             (adybug/src/main.s):00031         PLAYER_FACE   equ $0207         ; last active direction, 0..3
     0208             (adybug/src/main.s):00032         PLAYER_STEP   equ $0208         ; 2-pixel steps since last cell centre, 0..3
     0209             (adybug/src/main.s):00033         PLAYER_CELL_X equ $0209         ; semantic maze column
     020A             (adybug/src/main.s):00034         PLAYER_CELL_Y equ $020A         ; semantic maze row
     020B             (adybug/src/main.s):00035         PLAYER_FB     equ $020B         ; u16 framebuffer pointer at sprite top-left
     020D             (adybug/src/main.s):00036         JOY_DX        equ $020D         ; absolute X displacement from centre
     020E             (adybug/src/main.s):00037         JOY_DY        equ $020E         ; absolute Y displacement from centre
     020F             (adybug/src/main.s):00038         PLAYER_WANT   equ $020F         ; last non-neutral requested direction
     0210             (adybug/src/main.s):00039         TEST_X        equ $0210         ; candidate/draw maze column
     0211             (adybug/src/main.s):00040         TEST_Y        equ $0211         ; candidate/draw maze row
     0212             (adybug/src/main.s):00041         TEST_DIR      equ $0212         ; direction under collision test
     0213             (adybug/src/main.s):00042         GATE_ID       equ $0213         ; active gate index
     0214             (adybug/src/main.s):00043         GATE_X        equ $0214         ; active gate pivot column
     0215             (adybug/src/main.s):00044         GATE_Y        equ $0215         ; active gate pivot row
     0216             (adybug/src/main.s):00045         DRAW_COUNT    equ $0216         ; gate redraw loop counter
     0217             (adybug/src/main.s):00046         DRAW_TILE     equ $0217         ; tile ID for draw_cell_tile
     0218             (adybug/src/main.s):00047         PLAYER_MANUAL equ $0218         ; nonzero after first directional input
     0219             (adybug/src/main.s):00048         GATE_ANIM_ID  equ $0219         ; rotating gate ID+1; zero when idle
     021A             (adybug/src/main.s):00049         GATE_ANIM_STYLE equ $021A       ; 0=slash, 1=backslash
     021B             (adybug/src/main.s):00050         BLIT_ROWS     equ $021B         ; transparent-blit row counter
     021C             (adybug/src/main.s):00051         BLIT_WIDTH    equ $021C         ; transparent-blit bytes per row
     021D             (adybug/src/main.s):00052         SCORE_BCD     equ $021D         ; packed BCD score, six digits
     0220             (adybug/src/main.s):00053         HIGH_BCD      equ $0220         ; packed BCD session high score
     0223             (adybug/src/main.s):00054         LIVES         equ $0223         ; lives remaining
     0224             (adybug/src/main.s):00055         STAGE         equ $0224         ; current stage, 1..255
     0225             (adybug/src/main.s):00056         DOTS_LEFT     equ $0225         ; remaining flowers in this stage
     0226             (adybug/src/main.s):00057         STAGE_PENDING equ $0226         ; nonzero requests a stage transition
     0227             (adybug/src/main.s):00058         HUD_X         equ $0227         ; HUD tile column scratch
     0228             (adybug/src/main.s):00059         HUD_Y         equ $0228         ; HUD tile row scratch
     0229             (adybug/src/main.s):00060         HUD_COLOR     equ $0229         ; palette index for digit rendering
     022A             (adybug/src/main.s):00061         HUD_BYTE      equ $022A         ; packed BCD / mask scratch
     022B             (adybug/src/main.s):00062         HUD_COUNT     equ $022B         ; byte/row loop scratch
     022C             (adybug/src/main.s):00063         HUD_WIDTH     equ $022C         ; packed-byte loop scratch
     022D             (adybug/src/main.s):00064         HUD_BCD_BYTE  equ $022D         ; preserved BCD byte during digit blits
     022E             (adybug/src/main.s):00065         HUD_BCD_COUNT equ $022E         ; packed BCD byte loop
     022F             (adybug/src/main.s):00066         BONUS_COLOR   equ $022F         ; global bonus colour, palette index
     0230             (adybug/src/main.s):00067         BONUS_TIMER   equ $0230         ; u16 frames remaining in current colour
     0232             (adybug/src/main.s):00068         ENTITY_COUNT  equ $0232         ; active entity-table record count
     0233             (adybug/src/main.s):00069         BONUS_LEFT    equ $0233         ; uncollected hearts and letters
     0234             (adybug/src/main.s):00070         RNG_STATE     equ $0234         ; u16 placement LFSR
     0236             (adybug/src/main.s):00071         ENTITY_X      equ $0236         ; entity/draw scratch
     0237             (adybug/src/main.s):00072         ENTITY_Y      equ $0237
     0238             (adybug/src/main.s):00073         ENTITY_TYPE   equ $0238
     0239             (adybug/src/main.s):00074         ENTITY_VARIANT equ $0239
     023A             (adybug/src/main.s):00075         DEATH_TIMER   equ $023A         ; nonzero while rotating death animation runs
     023B             (adybug/src/main.s):00076         MULTIPLIER    equ $023B         ; score multiplier: 1,2,3,5
     023C             (adybug/src/main.s):00077         SPECIAL_BITS equ $023C         ; collected SPECIAL letters, bit per HUD position
     023D             (adybug/src/main.s):00078         EXTRA_BITS   equ $023D         ; collected EXTRA letters, bit per HUD position
     023E             (adybug/src/main.s):00079         ENTITY_PTR   equ $023E         ; u16 current entity record pointer
     0240             (adybug/src/main.s):00080         OBJ_SOURCE   equ $0240         ; u16 object-mask source pointer
     0242             (adybug/src/main.s):00081         OBJ_ROWS     equ $0242
     0243             (adybug/src/main.s):00082         OBJ_BYTES    equ $0243
     0244             (adybug/src/main.s):00083         OBJ_VALUE    equ $0244
     0245             (adybug/src/main.s):00084         OBJ_INDEX    equ $0245
     0246             (adybug/src/main.s):00085         OBJ_PRIMARY  equ $0246
     0247             (adybug/src/main.s):00086         OBJ_ACCENT   equ $0247
     0248             (adybug/src/main.s):00087         ENTITY_WORK  equ $0248         ; entity placement / loop scratch
     0249             (adybug/src/main.s):00088         ENTITY_TOTAL equ $0249         ; total records allocated this stage
     024A             (adybug/src/main.s):00089         BOX_TIMER    equ $024A         ; frames until next perimeter-box update
     024B             (adybug/src/main.s):00090         BOX_INDEX    equ $024B         ; clockwise perimeter position, 0..91
     024C             (adybug/src/main.s):00091         BOX_PHASE    equ $024C         ; 0=White-to-Green, 1=Green-to-White
     024D             (adybug/src/main.s):00092         DEATH_STATE  equ $024D         ; 0=alive, 1=shrink, 2=wings, 3=walk-off
     024E             (adybug/src/main.s):00093         DEATH_FRAME  equ $024E         ; selected curated death frame
                      (adybug/src/main.s):00094         
     0000             (adybug/src/main.s):00095         DIR_NORTH     equ 0
     0001             (adybug/src/main.s):00096         DIR_EAST      equ 1
     0002             (adybug/src/main.s):00097         DIR_SOUTH     equ 2
     0003             (adybug/src/main.s):00098         DIR_WEST      equ 3
     00FF             (adybug/src/main.s):00099         DIR_NONE      equ $FF
                      (adybug/src/main.s):00100         
     0001             (adybug/src/main.s):00101         COLOR_RED         equ 1
     0002             (adybug/src/main.s):00102         COLOR_YELLOW      equ 2
     0008             (adybug/src/main.s):00103         COLOR_LIGHT_GREEN equ 8
     0003             (adybug/src/main.s):00104         COLOR_BLUE        equ 3
     0004             (adybug/src/main.s):00105         COLOR_PINK        equ 4
     0006             (adybug/src/main.s):00106         COLOR_WHITE       equ 6
                      (adybug/src/main.s):00107         
     0000             (adybug/src/main.s):00108         ENTITY_NONE       equ 0
     0001             (adybug/src/main.s):00109         ENTITY_SKULL      equ 1
     0002             (adybug/src/main.s):00110         ENTITY_HEART      equ 2
     0003             (adybug/src/main.s):00111         ENTITY_LETTER     equ 3
                      (adybug/src/main.s):00112         
     0000             (adybug/src/main.s):00113         OBJECT_SKULL      equ 0
     0001             (adybug/src/main.s):00114         OBJECT_HEART      equ 1
     0002             (adybug/src/main.s):00115         OBJECT_A          equ 2
     0003             (adybug/src/main.s):00116         OBJECT_C          equ 3
     0004             (adybug/src/main.s):00117         OBJECT_E          equ 4
     0005             (adybug/src/main.s):00118         OBJECT_I          equ 5
     0006             (adybug/src/main.s):00119         OBJECT_L          equ 6
     0007             (adybug/src/main.s):00120         OBJECT_P          equ 7
     0008             (adybug/src/main.s):00121         OBJECT_R          equ 8
     0009             (adybug/src/main.s):00122         OBJECT_S          equ 9
     000A             (adybug/src/main.s):00123         OBJECT_T          equ 10
     000B             (adybug/src/main.s):00124         OBJECT_X          equ 11
                      (adybug/src/main.s):00125         
                      (adybug/src/main.s):00126         ;------------------------------------------------------------------------------
                      (adybug/src/main.s):00127         ; Hardware
                      (adybug/src/main.s):00128         ;------------------------------------------------------------------------------
     FF00             (adybug/src/main.s):00129         PIA1_DA    equ  $FF00
     FF01             (adybug/src/main.s):00130         PIA1_CRA   equ  $FF01
     FF02             (adybug/src/main.s):00131         PIA1_DB    equ  $FF02
     FF03             (adybug/src/main.s):00132         PIA1_CRB   equ  $FF03
     FF20             (adybug/src/main.s):00133         PIA2_DA    equ  $FF20
     FF21             (adybug/src/main.s):00134         PIA2_CRA   equ  $FF21
     FF22             (adybug/src/main.s):00135         PIA2_DB    equ  $FF22
     FF23             (adybug/src/main.s):00136         PIA2_CRB   equ  $FF23
                      (adybug/src/main.s):00137         
     FF90             (adybug/src/main.s):00138         GIME_INIT0 equ  $FF90
     FF92             (adybug/src/main.s):00139         GIME_IRQEN equ  $FF92
     FF98             (adybug/src/main.s):00140         GIME_VMODE equ  $FF98
     FF99             (adybug/src/main.s):00141         GIME_VRES  equ  $FF99
     FF9A             (adybug/src/main.s):00142         GIME_BORDER equ $FF9A
     FF9D             (adybug/src/main.s):00143         GIME_VOFF1 equ  $FF9D           ; addr bits Y18..Y11
     FF9E             (adybug/src/main.s):00144         GIME_VOFF0 equ  $FF9E           ; addr bits Y10..Y3
     FFA0             (adybug/src/main.s):00145         PAR_EXEC   equ  $FFA0           ; PAR0 of executive set ($FFA0..$FFA7)
     FFB0             (adybug/src/main.s):00146         PAL_BASE   equ  $FFB0
                      (adybug/src/main.s):00147         
     FFD9             (adybug/src/main.s):00148         SAM_FAST   equ  $FFD9
     FFDE             (adybug/src/main.s):00149         SAM_ROMRAM equ  $FFDE
                      (adybug/src/main.s):00150         
     FEF7             (adybug/src/main.s):00151         JT_IRQ     equ  $FEF7
                      (adybug/src/main.s):00152         
                      (adybug/src/main.s):00153         ;------------------------------------------------------------------------------
                      (adybug/src/main.s):00154         ; Memory map (post-Phase-2.3 with MMU on)
                      (adybug/src/main.s):00155         ;------------------------------------------------------------------------------
     2000             (adybug/src/main.s):00156         FB_VIRT    equ  $2000           ; virtual base of framebuffer (PAR1)
     9800             (adybug/src/main.s):00157         FB_END     equ  $9800           ; one past last FB byte (192 rows × 160 B)
     0030             (adybug/src/main.s):00158         FB_PHYS    equ  $30             ; physical page 0 of FB
     A000             (adybug/src/main.s):00159         MAZE_STATE equ  $A000           ; writable 576-byte maze-cell copy (PAR5)
     A240             (adybug/src/main.s):00160         GATE_STATE equ  $A240           ; rotation state N/W/S/E; parity selects H/V bar
     A300             (adybug/src/main.s):00161         PLAYER_BG  equ  $A300           ; 128-byte saved background under player
     A380             (adybug/src/main.s):00162         ENTITY_TABLE equ $A380          ; twelve x/y/type/variant records
                      (adybug/src/main.s):00163         
                      (adybug/src/main.s):00164         ;==============================================================================
                      (adybug/src/main.s):00165         ;  Cart ROM
                      (adybug/src/main.s):00166         ;==============================================================================
                      (adybug/src/main.s):00167                 org     $C000
                      (adybug/src/main.s):00168         
C000 444B             (adybug/src/main.s):00169                 fcc     "DK"            ; ROM-pack autostart magic; FIRQ -> $C002
                      (adybug/src/main.s):00170         
                      (adybug/src/main.s):00171         ;==============================================================================
                      (adybug/src/main.s):00172         ; entry
                      (adybug/src/main.s):00173         ;==============================================================================
C002 1A50             (adybug/src/main.s):00174         entry   orcc    #$50            ; mask IRQ + FIRQ
C004 10CE1FFE         (adybug/src/main.s):00175                 lds     #$1FFE          ; stack at top of low RAM page
                      (adybug/src/main.s):00176         
C008 8602             (adybug/src/main.s):00177                 lda     #$02            ; DP = $02
C00A 1F8B             (adybug/src/main.s):00178                 tfr     a,dp
                      (adybug/src/main.s):00179         
                      (adybug/src/main.s):00180                 ; --- Quiet legacy PIA interrupts ---
C00C 4F               (adybug/src/main.s):00181                 clra
C00D B7FF01           (adybug/src/main.s):00182                 sta     PIA1_CRA
C010 B7FF03           (adybug/src/main.s):00183                 sta     PIA1_CRB
C013 B7FF21           (adybug/src/main.s):00184                 sta     PIA2_CRA
C016 B7FF23           (adybug/src/main.s):00185                 sta     PIA2_CRB
C019 B6FF00           (adybug/src/main.s):00186                 lda     PIA1_DA
C01C B6FF02           (adybug/src/main.s):00187                 lda     PIA1_DB
C01F B6FF20           (adybug/src/main.s):00188                 lda     PIA2_DA
C022 B6FF22           (adybug/src/main.s):00189                 lda     PIA2_DB
                      (adybug/src/main.s):00190         
                      (adybug/src/main.s):00191                 ; --- Init0 — legacy mode, ACVC IRQ on, force $FExx, MMU still off ---
C025 86A8             (adybug/src/main.s):00192                 lda     #%10101000
C027 B7FF90           (adybug/src/main.s):00193                 sta     GIME_INIT0
C02A B7FFDE           (adybug/src/main.s):00194                 sta     SAM_ROMRAM       ; cart map is selected before clearing TY
                      (adybug/src/main.s):00195         
                      (adybug/src/main.s):00196                 ; --- Execute directly from cartridge ROM ---
                      (adybug/src/main.s):00197                 ; Keep TY=0. XRoar discards writes to the selected cartridge window,
                      (adybug/src/main.s):00198                 ; so the former same-address self-copy never populated phys $3E-$3F.
                      (adybug/src/main.s):00199                 ; PAR6=$3E keeps $C000-$DFFF cartridge-backed after MMU enable while
                      (adybug/src/main.s):00200                 ; the framebuffer and writable state use ordinary RAM pages below $3C.
                      (adybug/src/main.s):00201         
                      (adybug/src/main.s):00202                 ; --- Force executive PAR set ($FFA0-$FFA7) to be active ---
C02D 7FFF91           (adybug/src/main.s):00203                 clr     $FF91
                      (adybug/src/main.s):00204         
                      (adybug/src/main.s):00205                 ; --- Set up MMU PARs (executive set) ---
                      (adybug/src/main.s):00206                 ; PAR0 ($0000) = phys $38   low RAM (DP, stack)
                      (adybug/src/main.s):00207                 ; PAR1 ($2000) = phys $30   FB page 0
                      (adybug/src/main.s):00208                 ; PAR2 ($4000) = phys $31   FB page 1
                      (adybug/src/main.s):00209                 ; PAR3 ($6000) = phys $32   FB page 2
                      (adybug/src/main.s):00210                 ; PAR4 ($8000) = phys $33   FB page 3
                      (adybug/src/main.s):00211                 ; PAR5 ($A000) = phys $34   game state (Phase 4+)
                      (adybug/src/main.s):00212                 ; PAR6 ($C000) = phys $3E   cartridge code (current 8 K window)
                      (adybug/src/main.s):00213                 ; PAR7 ($E000) = phys $3F   cartridge/ROM window + IO + jump table
C030 308D0EE8         (adybug/src/main.s):00214                 leax    par_table,pcr
C034 108EFFA0         (adybug/src/main.s):00215                 ldy     #PAR_EXEC
C038 C608             (adybug/src/main.s):00216                 ldb     #8
C03A A680             (adybug/src/main.s):00217         parloop lda     ,x+
C03C A7A0             (adybug/src/main.s):00218                 sta     ,y+
C03E 5A               (adybug/src/main.s):00219                 decb
C03F 26F9             (adybug/src/main.s):00220                 bne     parloop
                      (adybug/src/main.s):00221         
                      (adybug/src/main.s):00222                 ; --- Fast clock 1.78 MHz ---
C041 B7FFD9           (adybug/src/main.s):00223                 sta     SAM_FAST
                      (adybug/src/main.s):00224         
                      (adybug/src/main.s):00225                 ; --- Set up display (still blanked via CRES=11) ---
C044 8680             (adybug/src/main.s):00226                 lda     #%10000000      ; BP=1 (graphics)
C046 B7FF98           (adybug/src/main.s):00227                 sta     GIME_VMODE
                      (adybug/src/main.s):00228         
C049 861F             (adybug/src/main.s):00229                 lda     #$1F            ; VRES=00 HRES=111 CRES=11 (BLANKED)
C04B B7FF99           (adybug/src/main.s):00230                 sta     GIME_VRES
                      (adybug/src/main.s):00231         
C04E 7FFF9A           (adybug/src/main.s):00232                 clr     GIME_BORDER     ; canonical Black outside the active framebuffer
                      (adybug/src/main.s):00233         
                      (adybug/src/main.s):00234                 ; FB at phys $30 → physical address $060000.
                      (adybug/src/main.s):00235                 ;   Y18=1, Y17=1, Y16..Y3 = 0
                      (adybug/src/main.s):00236                 ;   V1 ($FF9D) = Y18..Y11 = %11000000 = $C0
                      (adybug/src/main.s):00237                 ;   V0 ($FF9E) = Y10..Y3  = $00
C051 86C0             (adybug/src/main.s):00238                 lda     #$C0
C053 B7FF9D           (adybug/src/main.s):00239                 sta     GIME_VOFF1
C056 7FFF9E           (adybug/src/main.s):00240                 clr     GIME_VOFF0
                      (adybug/src/main.s):00241         
                      (adybug/src/main.s):00242                 ; --- Init0 — turn on MMU + switch to hi-res. Display still blanked. ---
                      (adybug/src/main.s):00243                 ; %01101000 = COCO=0 MMU=1 ACVCIRQ=1 ACVCFIRQ=0 force-$FExx=1 SCS=0 ROMmap=00
C059 8668             (adybug/src/main.s):00244                 lda     #%01101000
C05B B7FF90           (adybug/src/main.s):00245                 sta     GIME_INIT0
                      (adybug/src/main.s):00246         
                      (adybug/src/main.s):00247                 ; --- Load palette (16 entries) ---
C05E 308D1F9E         (adybug/src/main.s):00248                 leax    palette_table,pcr
C062 108EFFB0         (adybug/src/main.s):00249                 ldy     #PAL_BASE
C066 C610             (adybug/src/main.s):00250                 ldb     #16
C068 A680             (adybug/src/main.s):00251         palloop lda     ,x+
C06A A7A0             (adybug/src/main.s):00252                 sta     ,y+
C06C 5A               (adybug/src/main.s):00253                 decb
C06D 26F9             (adybug/src/main.s):00254                 bne     palloop
                      (adybug/src/main.s):00255         
                      (adybug/src/main.s):00256                 ; --- Clear FB to palette idx 0 (black) ---
                      (adybug/src/main.s):00257                 ; 30720 bytes = 15360 STDs.
C06F 8E2000           (adybug/src/main.s):00258                 ldx     #FB_VIRT
C072 CC0000           (adybug/src/main.s):00259                 ldd     #$0000
C075 ED81             (adybug/src/main.s):00260         clr_fb  std     ,x++
C077 8C9800           (adybug/src/main.s):00261                 cmpx    #FB_END
C07A 25F9             (adybug/src/main.s):00262                 blo     clr_fb
                      (adybug/src/main.s):00263         
                      (adybug/src/main.s):00264                 ; --- Phase 3 authored screen ---
C07C 170E07           (adybug/src/main.s):00265                 lbsr    draw_screen
                      (adybug/src/main.s):00266         
                      (adybug/src/main.s):00267                 ; --- Phase 4 state, joystick, and player sprite ---
C07F 170079           (adybug/src/main.s):00268                 lbsr    init_game_state
C082 1703D9           (adybug/src/main.s):00269                 lbsr    init_maze_state
C085 170712           (adybug/src/main.s):00270                 lbsr    init_gate_state
C088 170723           (adybug/src/main.s):00271                 lbsr    init_joystick
C08B 17076F           (adybug/src/main.s):00272                 lbsr    read_joystick
C08E 9635             (adybug/src/main.s):00273                 lda     RNG_STATE+1
C090 9801             (adybug/src/main.s):00274                 eora    JOY_X
C092 9B04             (adybug/src/main.s):00275                 adda    JOY_Y
C094 9735             (adybug/src/main.s):00276                 sta     RNG_STATE+1
