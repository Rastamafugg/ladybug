                      (adybug/src/main.s):00235         ;  Cart ROM
                      (adybug/src/main.s):00236         ;==============================================================================
                      (adybug/src/main.s):00237                 org     $C000
                      (adybug/src/main.s):00238         
C000 444B             (adybug/src/main.s):00239                 fcc     "DK"            ; ROM-pack autostart magic; FIRQ -> $C002
                      (adybug/src/main.s):00240         
                      (adybug/src/main.s):00241         ;==============================================================================
                      (adybug/src/main.s):00242         ; entry
                      (adybug/src/main.s):00243         ;==============================================================================
C002 1A50             (adybug/src/main.s):00244         entry   orcc    #$50            ; mask IRQ + FIRQ
C004 10CE1FFE         (adybug/src/main.s):00245                 lds     #$1FFE          ; stack at top of low RAM page
                      (adybug/src/main.s):00246         
C008 4F               (adybug/src/main.s):00247                 clra                    ; DP = $00, shared with bank-3 runtime
C009 1F8B             (adybug/src/main.s):00248                 tfr     a,dp
                      (adybug/src/main.s):00249         
                      (adybug/src/main.s):00250                 ; --- Quiet legacy PIA interrupts ---
C00B 4F               (adybug/src/main.s):00251                 clra
C00C B7FF01           (adybug/src/main.s):00252                 sta     PIA1_CRA
C00F B7FF03           (adybug/src/main.s):00253                 sta     PIA1_CRB
C012 B7FF21           (adybug/src/main.s):00254                 sta     PIA2_CRA
C015 B7FF23           (adybug/src/main.s):00255                 sta     PIA2_CRB
C018 B6FF00           (adybug/src/main.s):00256                 lda     PIA1_DA
C01B B6FF02           (adybug/src/main.s):00257                 lda     PIA1_DB
C01E B6FF20           (adybug/src/main.s):00258                 lda     PIA2_DA
C021 B6FF22           (adybug/src/main.s):00259                 lda     PIA2_DB
                      (adybug/src/main.s):00260         
                      (adybug/src/main.s):00261                 ; --- Init0 — legacy mode, ACVC IRQ on, force $FExx, MMU still off ---
C024 86A8             (adybug/src/main.s):00262                 lda     #%10101000
C026 B7FF90           (adybug/src/main.s):00263                 sta     GIME_INIT0
C029 B602F0           (adybug/src/main.s):00264                 lda     BOOT_FLAG
C02C 81A5             (adybug/src/main.s):00265                 cmpa    #$A5
C02E 2703             (adybug/src/main.s):00266                 beq     entry_ram_loaded
C030 B7FFDE           (adybug/src/main.s):00267                 sta     SAM_ROMRAM       ; plain-cart fallback selects TY=0
