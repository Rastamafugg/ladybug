                      (adybug/src/main.s):00740         ; blit_tile — copy an 8x8 tile to a framebuffer byte address.
                      (adybug/src/main.s):00741         ;
                      (adybug/src/main.s):00742         ; Inputs:
                      (adybug/src/main.s):00743         ;   X — destination framebuffer byte address
                      (adybug/src/main.s):00744         ;   Y — source glyph data, 32 packed 4bpp bytes
                      (adybug/src/main.s):00745         ;
                      (adybug/src/main.s):00746         ; Returns:
                      (adybug/src/main.s):00747         ;   A, B, D, X, Y, U, CC — undefined
                      (adybug/src/main.s):00748         ;
                      (adybug/src/main.s):00749         ; Side effects:
