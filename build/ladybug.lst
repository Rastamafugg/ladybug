                      (adybug/src/main.s):01259         ;   X — destination framebuffer byte address
                      (adybug/src/main.s):01260         ;   Y — packed 4bpp source data; colour 0 is transparent
                      (adybug/src/main.s):01261         ;
                      (adybug/src/main.s):01262         ; Returns: A, B, X, Y, CC undefined
