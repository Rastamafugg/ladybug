                      (adybug/src/main.s):00310                 ; PAR1 ($2000) = phys $30   FB page 0
                      (adybug/src/main.s):00311                 ; PAR2 ($4000) = phys $31   FB page 1
                      (adybug/src/main.s):00312                 ; PAR3 ($6000) = phys $32   FB page 2
                      (adybug/src/main.s):00313                 ; PAR4 ($8000) = phys $33   FB page 3
                      (adybug/src/main.s):00314                 ; PAR5 ($A000) = phys $34   game state (Phase 4+)
                      (adybug/src/main.s):00315                 ; PAR6 ($C000) = phys $3E   cartridge code (current 8 K window)
