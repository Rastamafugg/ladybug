                      (rf-001/src/main.s):00272                 org     $C000
                      (rf-001/src/main.s):00273         
C000 444B             (rf-001/src/main.s):00274                 fcc     "DK"            ; ROM-pack autostart magic; FIRQ -> $C002
                      (rf-001/src/main.s):00275         
                      (rf-001/src/main.s):00276         ;==============================================================================
                      (rf-001/src/main.s):00277         ; entry
                      (rf-001/src/main.s):00278         ;==============================================================================
C002 1A50             (rf-001/src/main.s):00279         entry   orcc    #$50            ; mask IRQ + FIRQ
C004 10CE1FFE         (rf-001/src/main.s):00280                 lds     #$1FFE          ; stack at top of low RAM page
                      (rf-001/src/main.s):00281         
C008 4F               (rf-001/src/main.s):00282                 clra                    ; DP = $00, shared with bank-3 runtime
C009 1F8B             (rf-001/src/main.s):00283                 tfr     a,dp
                      (rf-001/src/main.s):00284         
                      (rf-001/src/main.s):00285                 ; --- Quiet legacy PIA interrupts ---
C00B 4F               (rf-001/src/main.s):00286                 clra
C00C B7FF01           (rf-001/src/main.s):00287                 sta     PIA1_CRA
C00F B7FF03           (rf-001/src/main.s):00288                 sta     PIA1_CRB
C012 B7FF21           (rf-001/src/main.s):00289                 sta     PIA2_CRA
C015 B7FF23           (rf-001/src/main.s):00290                 sta     PIA2_CRB
C018 B6FF00           (rf-001/src/main.s):00291                 lda     PIA1_DA
C01B B6FF02           (rf-001/src/main.s):00292                 lda     PIA1_DB
