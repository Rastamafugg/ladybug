                      (rf-001/src/main.s):00001         ;==============================================================================
                      (rf-001/src/main.s):00002         ; Ladybug — main.s
                      (rf-001/src/main.s):00003         ;==============================================================================
                      (rf-001/src/main.s):00004         ; Phase 4: joystick-driven Lady Bug movement over the authored screen.
                      (rf-001/src/main.s):00005         ;
                      (rf-001/src/main.s):00006         ; Builds on Phase 2.3 (hi-res 320×192×16 + MMU + palette + IRQ tick) by:
                      (rf-001/src/main.s):00007         ;   - Compiling tiled/coco-screen.tmx into a one-byte tile map and a
                      (rf-001/src/main.s):00008         ;     deduplicated packed 4bpp tile atlas before assembly.
                      (rf-001/src/main.s):00009         ;   - Flattening visible Tiled layers and applying horizontal/vertical flips.
                      (rf-001/src/main.s):00010         ;   - blit_tile: 8 rows x 4 bytes, stride 160.
                      (rf-001/src/main.s):00011         ;   - Polling the right joystick through the PIA DAC/comparator path.
                      (rf-001/src/main.s):00012         ;   - Transparent 16x16 player frames with background save/restore.
                      (rf-001/src/main.s):00013         ;   - Semantic maze collision and dot removal.
                      (rf-001/src/main.s):00014         ;
                      (rf-001/src/main.s):00015         ; Visible: the authored screen with a moving, maze-constrained Lady Bug.
                      (rf-001/src/main.s):00016         ;==============================================================================
                      (rf-001/src/main.s):00017         
                      (rf-001/src/main.s):00018                 pragma  nodollarlocal,6809
                      (rf-001/src/main.s):00019         
                      (rf-001/src/main.s):00020         ;------------------------------------------------------------------------------
                      (rf-001/src/main.s):00021         ; DP allocation (page $00)
                      (rf-001/src/main.s):00022         ;------------------------------------------------------------------------------
     00               (rf-001/src/main.s):00023                 setdp   $00
                      (rf-001/src/main.s):00024         
