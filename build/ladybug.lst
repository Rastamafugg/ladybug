                      (erf003/src/main.s):00275         ;  Cart ROM
                      (erf003/src/main.s):00276         ;==============================================================================
                      (erf003/src/main.s):00277                 org     $C000
                      (erf003/src/main.s):00278         
C000 444B             (erf003/src/main.s):00279                 fcc     "DK"            ; ROM-pack autostart magic; FIRQ -> $C002
                      (erf003/src/main.s):00280         
                      (erf003/src/main.s):00281         ;==============================================================================
                      (erf003/src/main.s):00282         ; entry
                      (erf003/src/main.s):00283         ;==============================================================================
C002 1A50             (erf003/src/main.s):00284         entry   orcc    #$50            ; mask IRQ + FIRQ
C004 10CE1FFE         (erf003/src/main.s):00285                 lds     #$1FFE          ; stack at top of low RAM page
                      (erf003/src/main.s):00286         
C008 4F               (erf003/src/main.s):00287                 clra                    ; DP = $00, shared with bank-3 runtime
C009 1F8B             (erf003/src/main.s):00288                 tfr     a,dp
                      (erf003/src/main.s):00289         
                      (erf003/src/main.s):00290                 ; --- Quiet legacy PIA interrupts ---
C00B 4F               (erf003/src/main.s):00291                 clra
C00C B7FF01           (erf003/src/main.s):00292                 sta     PIA1_CRA
C00F B7FF03           (erf003/src/main.s):00293                 sta     PIA1_CRB
C012 B7FF21           (erf003/src/main.s):00294                 sta     PIA2_CRA
C015 B7FF23           (erf003/src/main.s):00295                 sta     PIA2_CRB
C018 B6FF00           (erf003/src/main.s):00296                 lda     PIA1_DA
C01B B6FF02           (erf003/src/main.s):00297                 lda     PIA1_DB
C01E B6FF20           (erf003/src/main.s):00298                 lda     PIA2_DA
C021 B6FF22           (erf003/src/main.s):00299                 lda     PIA2_DB
                      (erf003/src/main.s):00300         
                      (erf003/src/main.s):00301                 ; --- Init0 — legacy mode, ACVC IRQ on, force $FExx, MMU still off ---
C024 86A8             (erf003/src/main.s):00302                 lda     #%10101000
C026 B7FF90           (erf003/src/main.s):00303                 sta     GIME_INIT0
C029 B602F0           (erf003/src/main.s):00304                 lda     BOOT_FLAG
C02C 81A5             (erf003/src/main.s):00305                 cmpa    #$A5
C02E 2703             (erf003/src/main.s):00306                 beq     entry_ram_loaded
C030 B7FFDE           (erf003/src/main.s):00307                 sta     SAM_ROMRAM       ; plain-cart fallback selects TY=0
C033                  (erf003/src/main.s):00308         entry_ram_loaded
                      (erf003/src/main.s):00309         
                      (erf003/src/main.s):00310                 ; --- Enter runtime from direct ROM or GMC-loaded RAM ---
                      (erf003/src/main.s):00311                 ; Direct fallback keeps TY=0. XRoar discards writes to the selected cartridge window,
                      (erf003/src/main.s):00312                 ; so the former same-address self-copy never populated phys $3E-$3F.
                      (erf003/src/main.s):00313                 ; PAR6=$3E keeps $C000-$DFFF cartridge-backed after MMU enable while
                      (erf003/src/main.s):00314                 ; the framebuffer and writable state use ordinary RAM pages below $3C.
                      (erf003/src/main.s):00315         
                      (erf003/src/main.s):00316                 ; --- Force executive PAR set ($FFA0-$FFA7) to be active ---
C033 7FFF91           (erf003/src/main.s):00317                 clr     $FF91
                      (erf003/src/main.s):00318         
                      (erf003/src/main.s):00319                 ; --- Set up MMU PARs (executive set) ---
                      (erf003/src/main.s):00320                 ; PAR0 ($0000) = phys $38   low RAM (DP, stack)
                      (erf003/src/main.s):00321                 ; PAR1 ($2000) = phys $30   FB page 0
                      (erf003/src/main.s):00322                 ; PAR2 ($4000) = phys $31   FB page 1
                      (erf003/src/main.s):00323                 ; PAR3 ($6000) = phys $32   FB page 2
                      (erf003/src/main.s):00324                 ; PAR4 ($8000) = phys $33   FB page 3
                      (erf003/src/main.s):00325                 ; PAR5 ($A000) = phys $34   game state (Phase 4+)
                      (erf003/src/main.s):00326                 ; PAR6 ($C000) = phys $3E   cartridge code (current 8 K window)
                      (erf003/src/main.s):00327                 ; PAR7 ($E000) = phys $3F   cartridge/ROM window + IO + jump table
C036 308D1732         (erf003/src/main.s):00328                 leax    par_table,pcr
C03A 108EFFA0         (erf003/src/main.s):00329                 ldy     #PAR_EXEC
C03E C608             (erf003/src/main.s):00330                 ldb     #8
C040 A680             (erf003/src/main.s):00331         parloop lda     ,x+
C042 A7A0             (erf003/src/main.s):00332                 sta     ,y+
C044 5A               (erf003/src/main.s):00333                 decb
C045 26F9             (erf003/src/main.s):00334                 bne     parloop
                      (erf003/src/main.s):00335         
                      (erf003/src/main.s):00336                 ; --- Fast clock 1.78 MHz ---
C047 B7FFD9           (erf003/src/main.s):00337                 sta     SAM_FAST
                      (erf003/src/main.s):00338         
                      (erf003/src/main.s):00339                 ; --- Set up display (still blanked via CRES=11) ---
C04A 8680             (erf003/src/main.s):00340                 lda     #%10000000      ; BP=1 (graphics)
C04C B7FF98           (erf003/src/main.s):00341                 sta     GIME_VMODE
                      (erf003/src/main.s):00342         
C04F 861F             (erf003/src/main.s):00343                 lda     #$1F            ; VRES=00 HRES=111 CRES=11 (BLANKED)
C051 B7FF99           (erf003/src/main.s):00344                 sta     GIME_VRES
                      (erf003/src/main.s):00345         
C054 7FFF9A           (erf003/src/main.s):00346                 clr     GIME_BORDER     ; canonical Black outside the active framebuffer
                      (erf003/src/main.s):00347         
                      (erf003/src/main.s):00348                 ; FB at phys $30 → physical address $060000.
                      (erf003/src/main.s):00349                 ;   Y18=1, Y17=1, Y16..Y3 = 0
                      (erf003/src/main.s):00350                 ;   V1 ($FF9D) = Y18..Y11 = %11000000 = $C0
                      (erf003/src/main.s):00351                 ;   V0 ($FF9E) = Y10..Y3  = $00
C057 86C0             (erf003/src/main.s):00352                 lda     #$C0
C059 B7FF9D           (erf003/src/main.s):00353                 sta     GIME_VOFF1
C05C 7FFF9E           (erf003/src/main.s):00354                 clr     GIME_VOFF0
                      (erf003/src/main.s):00355         
                      (erf003/src/main.s):00356                 ; --- Init0 — turn on MMU + switch to hi-res. Display still blanked. ---
                      (erf003/src/main.s):00357                 ; %01101000 = COCO=0 MMU=1 ACVCIRQ=1 ACVCFIRQ=0 force-$FExx=1 SCS=0 ROMmap=00
C05F 8668             (erf003/src/main.s):00358                 lda     #%01101000
C061 B7FF90           (erf003/src/main.s):00359                 sta     GIME_INIT0
                      (erf003/src/main.s):00360         
                      (erf003/src/main.s):00361                 ; --- Load palette (16 entries) ---
C064 308D1F98         (erf003/src/main.s):00362                 leax    palette_table,pcr
C068 108EFFB0         (erf003/src/main.s):00363                 ldy     #PAL_BASE
C06C C610             (erf003/src/main.s):00364                 ldb     #16
C06E A680             (erf003/src/main.s):00365         palloop lda     ,x+
C070 A7A0             (erf003/src/main.s):00366                 sta     ,y+
C072 5A               (erf003/src/main.s):00367                 decb
C073 26F9             (erf003/src/main.s):00368                 bne     palloop
                      (erf003/src/main.s):00369         
                      (erf003/src/main.s):00370                 ; --- Clear FB to palette idx 0 (black) ---
                      (erf003/src/main.s):00371                 ; 30720 bytes = 15360 STDs.
C075 8E2000           (erf003/src/main.s):00372                 ldx     #FB_VIRT
C078 CC0000           (erf003/src/main.s):00373                 ldd     #$0000
C07B ED81             (erf003/src/main.s):00374         clr_fb  std     ,x++
C07D 8C9800           (erf003/src/main.s):00375                 cmpx    #FB_END
C080 25F9             (erf003/src/main.s):00376                 blo     clr_fb
                      (erf003/src/main.s):00377         
