                      (adybug/src/main.s):03892         ; blit_tile — copy an 8x8 tile to a framebuffer byte address.
                      (adybug/src/main.s):03893         ;
                      (adybug/src/main.s):03894         ; Inputs:
                      (adybug/src/main.s):03895         ;   X — destination framebuffer byte address
                      (adybug/src/main.s):03896         ;   Y — source glyph data, 32 packed 4bpp bytes
                      (adybug/src/main.s):03897         ;
                      (adybug/src/main.s):03898         ; Returns:
                      (adybug/src/main.s):03899         ;   A, B, D, X, Y, U, CC — undefined
                      (adybug/src/main.s):03900         ;
                      (adybug/src/main.s):03901         ; Side effects:
                      (adybug/src/main.s):03902         ;   Writes 8 rows x 4 bytes; advances 156 bytes after each written row.
                      (adybug/src/main.s):03903         ;==============================================================================
D6C1                  (adybug/src/main.s):03904         blit_tile
                      (adybug/src/main.s):03905                 ; ldd ,y++ clobbers B, so use a Y-vs-sentinel loop instead of decb.
                      (adybug/src/main.s):03906                 ; See wiki/internal/implementation/lessons-learned.html
                      (adybug/src/main.s):03907                 ; §"LDD ,Y++ clobbers B".
D6C1 3440             (adybug/src/main.s):03908                 pshs    u
D6C3 33A820           (adybug/src/main.s):03909                 leau    32,y            ; sentinel = end of tile data
D6C6 3440             (adybug/src/main.s):03910                 pshs    u
D6C8 ECA1             (adybug/src/main.s):03911         btrow   ldd     ,y++
D6CA ED81             (adybug/src/main.s):03912                 std     ,x++
D6CC ECA1             (adybug/src/main.s):03913                 ldd     ,y++
D6CE ED81             (adybug/src/main.s):03914                 std     ,x++
D6D0 3089009C         (adybug/src/main.s):03915                 leax    156,x           ; advance to next FB row, same column
D6D4 10ACE4           (adybug/src/main.s):03916                 cmpy    ,s
D6D7 25EF             (adybug/src/main.s):03917                 blo     btrow
D6D9 3262             (adybug/src/main.s):03918                 leas    2,s
