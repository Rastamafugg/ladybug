     0008             (verage/src/main.s):00032         PLAYER_STEP   equ $0008         ; 2-pixel steps since last cell centre, 0..3
     0009             (verage/src/main.s):00033         PLAYER_CELL_X equ $0009         ; semantic maze column
     000A             (verage/src/main.s):00034         PLAYER_CELL_Y equ $000A         ; semantic maze row
     000B             (verage/src/main.s):00035         PLAYER_FB     equ $000B         ; u16 framebuffer pointer at sprite top-left
     000D             (verage/src/main.s):00036         JOY_DX        equ $000D         ; absolute X displacement from centre
     000E             (verage/src/main.s):00037         JOY_DY        equ $000E         ; absolute Y displacement from centre
     000F             (verage/src/main.s):00038         PLAYER_WANT   equ $000F         ; last non-neutral requested direction
