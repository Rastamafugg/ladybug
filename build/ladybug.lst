                      (adybug/src/main.s):01663         ; init_joystick — configure the PIAs for right-joystick DAC conversion.
                      (adybug/src/main.s):01664         ;
                      (adybug/src/main.s):01665         ; Inputs:
                      (adybug/src/main.s):01666         ;   None
                      (adybug/src/main.s):01667         ;
                      (adybug/src/main.s):01668         ; Returns:
                      (adybug/src/main.s):01669         ;   A, CC — undefined
                      (adybug/src/main.s):01670         ;
                      (adybug/src/main.s):01671         ; Side effects:
                      (adybug/src/main.s):01672         ;   Configures PIA1 PA as input, PIA1 PB as output, PIA2 PA7-PA2 as DAC
                      (adybug/src/main.s):01673         ;   output, and selects/enables the right joystick analog multiplexer.
                      (adybug/src/main.s):01674         ;==============================================================================
C945                  (adybug/src/main.s):01675         init_joystick
C945 7FFF01           (adybug/src/main.s):01676                 clr     PIA1_CRA        ; select PIA1 PA direction register
C948 7FFF00           (adybug/src/main.s):01677                 clr     PIA1_DA         ; all PA bits input, including comparator PA7
C94B 7FFF03           (adybug/src/main.s):01678                 clr     PIA1_CRB        ; select PIA1 PB direction register
C94E 86FF             (adybug/src/main.s):01679                 lda     #$FF
C950 B7FF02           (adybug/src/main.s):01680                 sta     PIA1_DB         ; keyboard columns/output side
C953 8634             (adybug/src/main.s):01681                 lda     #$34            ; data register, static CA2/CB2 output low
C955 B7FF01           (adybug/src/main.s):01682                 sta     PIA1_CRA
