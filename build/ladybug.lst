     0038             (adybug/src/main.s):00074         ENTITY_TYPE   equ $0038
     0039             (adybug/src/main.s):00075         ENTITY_VARIANT equ $0039
     003A             (adybug/src/main.s):00076         DEATH_TIMER   equ $003A         ; nonzero while rotating death animation runs
     003B             (adybug/src/main.s):00077         MULTIPLIER    equ $003B         ; score multiplier: 1,2,3,5
