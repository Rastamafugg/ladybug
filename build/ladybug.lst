                      (adybug/src/main.s):00001         ;==============================================================================
                      (adybug/src/main.s):00002         ; Ladybug — main.s
                      (adybug/src/main.s):00003         ;==============================================================================
                      (adybug/src/main.s):00004         ; Phase 4: joystick-driven Lady Bug movement over the authored screen.
                      (adybug/src/main.s):00005         ;
                      (adybug/src/main.s):00006         ; Builds on Phase 2.3 (hi-res 320×192×16 + MMU + palette + IRQ tick) by:
                      (adybug/src/main.s):00007         ;   - Compiling tiled/coco-screen.tmx into a one-byte tile map and a
                      (adybug/src/main.s):00008         ;     deduplicated packed 4bpp tile atlas before assembly.
                      (adybug/src/main.s):00009         ;   - Flattening visible Tiled layers and applying horizontal/vertical flips.
                      (adybug/src/main.s):00010         ;   - blit_tile: 8 rows x 4 bytes, stride 160.
                      (adybug/src/main.s):00011         ;   - Polling the right joystick through the PIA DAC/comparator path.
                      (adybug/src/main.s):00012         ;   - Masked 16x16 player frames with background save/restore.
                      (adybug/src/main.s):00013         ;   - Semantic maze collision and dot removal.
                      (adybug/src/main.s):00014         ;
                      (adybug/src/main.s):00015         ; Visible: the authored screen with a moving, maze-constrained Lady Bug.
                      (adybug/src/main.s):00016         ;==============================================================================
                      (adybug/src/main.s):00017         
                      (adybug/src/main.s):00018                 pragma  nodollarlocal,6809
                      (adybug/src/main.s):00019         
                      (adybug/src/main.s):00020         ;------------------------------------------------------------------------------
                      (adybug/src/main.s):00021         ; DP allocation (page $02)
                      (adybug/src/main.s):00022         ;------------------------------------------------------------------------------
     02               (adybug/src/main.s):00023                 setdp   $02
                      (adybug/src/main.s):00024         
     0200             (adybug/src/main.s):00025         LAST_FRAME    equ $0200         ; last processed Vbord counter low byte
     0201             (adybug/src/main.s):00026         JOY_X         equ $0201         ; right joystick X, 0..63
     0202             (adybug/src/main.s):00027         FRAMES        equ $0202         ; u16 frame counter
     0204             (adybug/src/main.s):00028         JOY_Y         equ $0204         ; right joystick Y, 0..63
     0205             (adybug/src/main.s):00029         JOY_DIR       equ $0205         ; requested direction or $FF
     0206             (adybug/src/main.s):00030         PLAYER_DIR    equ $0206         ; active direction or $FF
     0207             (adybug/src/main.s):00031         PLAYER_FACE   equ $0207         ; last active direction, 0..3
     0208             (adybug/src/main.s):00032         PLAYER_STEP   equ $0208         ; 2-pixel steps since last cell centre, 0..3
     0209             (adybug/src/main.s):00033         PLAYER_CELL_X equ $0209         ; semantic maze column
     020A             (adybug/src/main.s):00034         PLAYER_CELL_Y equ $020A         ; semantic maze row
     020B             (adybug/src/main.s):00035         PLAYER_FB     equ $020B         ; u16 framebuffer pointer at sprite top-left
     020D             (adybug/src/main.s):00036         JOY_DX        equ $020D         ; absolute X displacement from centre
     020E             (adybug/src/main.s):00037         JOY_DY        equ $020E         ; absolute Y displacement from centre
                      (adybug/src/main.s):00038         
     0000             (adybug/src/main.s):00039         DIR_NORTH     equ 0
     0001             (adybug/src/main.s):00040         DIR_EAST      equ 1
     0002             (adybug/src/main.s):00041         DIR_SOUTH     equ 2
     0003             (adybug/src/main.s):00042         DIR_WEST      equ 3
     00FF             (adybug/src/main.s):00043         DIR_NONE      equ $FF
                      (adybug/src/main.s):00044         
                      (adybug/src/main.s):00045         ;------------------------------------------------------------------------------
                      (adybug/src/main.s):00046         ; Hardware
                      (adybug/src/main.s):00047         ;------------------------------------------------------------------------------
     FF00             (adybug/src/main.s):00048         PIA1_DA    equ  $FF00
     FF01             (adybug/src/main.s):00049         PIA1_CRA   equ  $FF01
     FF02             (adybug/src/main.s):00050         PIA1_DB    equ  $FF02
     FF03             (adybug/src/main.s):00051         PIA1_CRB   equ  $FF03
     FF20             (adybug/src/main.s):00052         PIA2_DA    equ  $FF20
     FF21             (adybug/src/main.s):00053         PIA2_CRA   equ  $FF21
     FF22             (adybug/src/main.s):00054         PIA2_DB    equ  $FF22
     FF23             (adybug/src/main.s):00055         PIA2_CRB   equ  $FF23
                      (adybug/src/main.s):00056         
     FF90             (adybug/src/main.s):00057         GIME_INIT0 equ  $FF90
     FF92             (adybug/src/main.s):00058         GIME_IRQEN equ  $FF92
     FF98             (adybug/src/main.s):00059         GIME_VMODE equ  $FF98
     FF99             (adybug/src/main.s):00060         GIME_VRES  equ  $FF99
     FF9A             (adybug/src/main.s):00061         GIME_BORDER equ $FF9A
     FF9D             (adybug/src/main.s):00062         GIME_VOFF1 equ  $FF9D           ; addr bits Y18..Y11
     FF9E             (adybug/src/main.s):00063         GIME_VOFF0 equ  $FF9E           ; addr bits Y10..Y3
     FFA0             (adybug/src/main.s):00064         PAR_EXEC   equ  $FFA0           ; PAR0 of executive set ($FFA0..$FFA7)
     FFB0             (adybug/src/main.s):00065         PAL_BASE   equ  $FFB0
                      (adybug/src/main.s):00066         
     FFD9             (adybug/src/main.s):00067         SAM_FAST   equ  $FFD9
     FFDE             (adybug/src/main.s):00068         SAM_ROMRAM equ  $FFDE
                      (adybug/src/main.s):00069         
     FEF7             (adybug/src/main.s):00070         JT_IRQ     equ  $FEF7
                      (adybug/src/main.s):00071         
                      (adybug/src/main.s):00072         ;------------------------------------------------------------------------------
                      (adybug/src/main.s):00073         ; Memory map (post-Phase-2.3 with MMU on)
                      (adybug/src/main.s):00074         ;------------------------------------------------------------------------------
     2000             (adybug/src/main.s):00075         FB_VIRT    equ  $2000           ; virtual base of framebuffer (PAR1)
     9800             (adybug/src/main.s):00076         FB_END     equ  $9800           ; one past last FB byte (192 rows × 160 B)
     0030             (adybug/src/main.s):00077         FB_PHYS    equ  $30             ; physical page 0 of FB
     A000             (adybug/src/main.s):00078         MAZE_STATE equ  $A000           ; writable 576-byte maze-cell copy (PAR5)
     A300             (adybug/src/main.s):00079         PLAYER_BG  equ  $A300           ; 128-byte saved background under player
                      (adybug/src/main.s):00080         
                      (adybug/src/main.s):00081         ;==============================================================================
                      (adybug/src/main.s):00082         ;  Cart ROM
                      (adybug/src/main.s):00083         ;==============================================================================
                      (adybug/src/main.s):00084                 org     $C000
                      (adybug/src/main.s):00085         
C000 444B             (adybug/src/main.s):00086                 fcc     "DK"            ; ROM-pack autostart magic; FIRQ -> $C002
                      (adybug/src/main.s):00087         
                      (adybug/src/main.s):00088         ;==============================================================================
                      (adybug/src/main.s):00089         ; entry
                      (adybug/src/main.s):00090         ;==============================================================================
C002 1A50             (adybug/src/main.s):00091         entry   orcc    #$50            ; mask IRQ + FIRQ
C004 10CE1FFE         (adybug/src/main.s):00092                 lds     #$1FFE          ; stack at top of low RAM page
                      (adybug/src/main.s):00093         
C008 8602             (adybug/src/main.s):00094                 lda     #$02            ; DP = $02
C00A 1F8B             (adybug/src/main.s):00095                 tfr     a,dp
                      (adybug/src/main.s):00096         
                      (adybug/src/main.s):00097                 ; --- Quiet legacy PIA interrupts ---
C00C 4F               (adybug/src/main.s):00098                 clra
C00D B7FF01           (adybug/src/main.s):00099                 sta     PIA1_CRA
C010 B7FF03           (adybug/src/main.s):00100                 sta     PIA1_CRB
C013 B7FF21           (adybug/src/main.s):00101                 sta     PIA2_CRA
C016 B7FF23           (adybug/src/main.s):00102                 sta     PIA2_CRB
C019 B6FF00           (adybug/src/main.s):00103                 lda     PIA1_DA
C01C B6FF02           (adybug/src/main.s):00104                 lda     PIA1_DB
C01F B6FF20           (adybug/src/main.s):00105                 lda     PIA2_DA
C022 B6FF22           (adybug/src/main.s):00106                 lda     PIA2_DB
                      (adybug/src/main.s):00107         
                      (adybug/src/main.s):00108                 ; --- Init0 — legacy mode, ACVC IRQ on, force $FExx, MMU still off ---
C025 86A8             (adybug/src/main.s):00109                 lda     #%10101000
C027 B7FF90           (adybug/src/main.s):00110                 sta     GIME_INIT0
C02A B7FFDE           (adybug/src/main.s):00111                 sta     SAM_ROMRAM       ; cart map is selected before clearing TY
                      (adybug/src/main.s):00112         
                      (adybug/src/main.s):00113                 ; --- Execute directly from cartridge ROM ---
                      (adybug/src/main.s):00114                 ; Keep TY=0. XRoar discards writes to the selected cartridge window,
                      (adybug/src/main.s):00115                 ; so the former same-address self-copy never populated phys $3E-$3F.
                      (adybug/src/main.s):00116                 ; PAR6=$3E keeps $C000-$DFFF cartridge-backed after MMU enable while
                      (adybug/src/main.s):00117                 ; the framebuffer and writable state use ordinary RAM pages below $3C.
                      (adybug/src/main.s):00118         
                      (adybug/src/main.s):00119                 ; --- Force executive PAR set ($FFA0-$FFA7) to be active ---
C02D 7FFF91           (adybug/src/main.s):00120                 clr     $FF91
                      (adybug/src/main.s):00121         
                      (adybug/src/main.s):00122                 ; --- Set up MMU PARs (executive set) ---
                      (adybug/src/main.s):00123                 ; PAR0 ($0000) = phys $38   low RAM (DP, stack)
                      (adybug/src/main.s):00124                 ; PAR1 ($2000) = phys $30   FB page 0
                      (adybug/src/main.s):00125                 ; PAR2 ($4000) = phys $31   FB page 1
                      (adybug/src/main.s):00126                 ; PAR3 ($6000) = phys $32   FB page 2
                      (adybug/src/main.s):00127                 ; PAR4 ($8000) = phys $33   FB page 3
                      (adybug/src/main.s):00128                 ; PAR5 ($A000) = phys $34   game state (Phase 4+)
                      (adybug/src/main.s):00129                 ; PAR6 ($C000) = phys $3E   cartridge code (current 8 K window)
                      (adybug/src/main.s):00130                 ; PAR7 ($E000) = phys $3F   cartridge/ROM window + IO + jump table
C030 308D0300         (adybug/src/main.s):00131                 leax    par_table,pcr
C034 108EFFA0         (adybug/src/main.s):00132                 ldy     #PAR_EXEC
C038 C608             (adybug/src/main.s):00133                 ldb     #8
C03A A680             (adybug/src/main.s):00134         parloop lda     ,x+
C03C A7A0             (adybug/src/main.s):00135                 sta     ,y+
C03E 5A               (adybug/src/main.s):00136                 decb
C03F 26F9             (adybug/src/main.s):00137                 bne     parloop
                      (adybug/src/main.s):00138         
                      (adybug/src/main.s):00139                 ; --- Fast clock 1.78 MHz ---
C041 B7FFD9           (adybug/src/main.s):00140                 sta     SAM_FAST
                      (adybug/src/main.s):00141         
                      (adybug/src/main.s):00142                 ; --- Set up display (still blanked via CRES=11) ---
C044 8680             (adybug/src/main.s):00143                 lda     #%10000000      ; BP=1 (graphics)
C046 B7FF98           (adybug/src/main.s):00144                 sta     GIME_VMODE
                      (adybug/src/main.s):00145         
C049 861F             (adybug/src/main.s):00146                 lda     #$1F            ; VRES=00 HRES=111 CRES=11 (BLANKED)
C04B B7FF99           (adybug/src/main.s):00147                 sta     GIME_VRES
                      (adybug/src/main.s):00148         
C04E 8628             (adybug/src/main.s):00149                 lda     #$28            ; bright border (empirically "pink") so a black
C050 B7FF9A           (adybug/src/main.s):00150                 sta     GIME_BORDER     ;   stripe 0 is visually distinct from the border
                      (adybug/src/main.s):00151         
                      (adybug/src/main.s):00152                 ; FB at phys $30 → physical address $060000.
                      (adybug/src/main.s):00153                 ;   Y18=1, Y17=1, Y16..Y3 = 0
                      (adybug/src/main.s):00154                 ;   V1 ($FF9D) = Y18..Y11 = %11000000 = $C0
                      (adybug/src/main.s):00155                 ;   V0 ($FF9E) = Y10..Y3  = $00
C053 86C0             (adybug/src/main.s):00156                 lda     #$C0
C055 B7FF9D           (adybug/src/main.s):00157                 sta     GIME_VOFF1
C058 7FFF9E           (adybug/src/main.s):00158                 clr     GIME_VOFF0
                      (adybug/src/main.s):00159         
                      (adybug/src/main.s):00160                 ; --- Init0 — turn on MMU + switch to hi-res. Display still blanked. ---
                      (adybug/src/main.s):00161                 ; %01101000 = COCO=0 MMU=1 ACVCIRQ=1 ACVCFIRQ=0 force-$FExx=1 SCS=0 ROMmap=00
C05B 8668             (adybug/src/main.s):00162                 lda     #%01101000
C05D B7FF90           (adybug/src/main.s):00163                 sta     GIME_INIT0
                      (adybug/src/main.s):00164         
                      (adybug/src/main.s):00165                 ; --- Load palette (16 entries) ---
C060 308D02D8         (adybug/src/main.s):00166                 leax    palette_table,pcr
C064 108EFFB0         (adybug/src/main.s):00167                 ldy     #PAL_BASE
C068 C610             (adybug/src/main.s):00168                 ldb     #16
C06A A680             (adybug/src/main.s):00169         palloop lda     ,x+
C06C A7A0             (adybug/src/main.s):00170                 sta     ,y+
C06E 5A               (adybug/src/main.s):00171                 decb
C06F 26F9             (adybug/src/main.s):00172                 bne     palloop
                      (adybug/src/main.s):00173         
                      (adybug/src/main.s):00174                 ; --- Clear FB to palette idx 0 (black) ---
                      (adybug/src/main.s):00175                 ; 30720 bytes = 15360 STDs.
C071 8E2000           (adybug/src/main.s):00176                 ldx     #FB_VIRT
C074 CC0000           (adybug/src/main.s):00177                 ldd     #$0000
C077 ED81             (adybug/src/main.s):00178         clr_fb  std     ,x++
C079 8C9800           (adybug/src/main.s):00179                 cmpx    #FB_END
C07C 25F9             (adybug/src/main.s):00180                 blo     clr_fb
                      (adybug/src/main.s):00181         
                      (adybug/src/main.s):00182                 ; --- Phase 3 authored screen ---
C07E 170257           (adybug/src/main.s):00183                 lbsr    draw_screen
                      (adybug/src/main.s):00184         
                      (adybug/src/main.s):00185                 ; --- Phase 4 state, joystick, and player sprite ---
C081 170040           (adybug/src/main.s):00186                 lbsr    init_maze_state
C084 170050           (adybug/src/main.s):00187                 lbsr    init_joystick
C087 17007E           (adybug/src/main.s):00188                 lbsr    init_player
C08A 1701D0           (adybug/src/main.s):00189                 lbsr    draw_player
                      (adybug/src/main.s):00190         
                      (adybug/src/main.s):00191                 ; --- Un-blank: 320×192×16 (CRES=10 + HRES=111 → 4bpp on this build) ---
C08D 861E             (adybug/src/main.s):00192                 lda     #$1E
C08F B7FF99           (adybug/src/main.s):00193                 sta     GIME_VRES
                      (adybug/src/main.s):00194         
                      (adybug/src/main.s):00195                 ; --- IRQ handler at $FEF7 jump-table slot ---
C092 867E             (adybug/src/main.s):00196                 lda     #$7E            ; JMP extended
C094 B7FEF7           (adybug/src/main.s):00197                 sta     JT_IRQ
C097 CCC32A           (adybug/src/main.s):00198                 ldd     #irq_handler
C09A FDFEF8           (adybug/src/main.s):00199                 std     JT_IRQ+1
                      (adybug/src/main.s):00200         
C09D 0F02             (adybug/src/main.s):00201                 clr     FRAMES
C09F 0F03             (adybug/src/main.s):00202                 clr     FRAMES+1
C0A1 0F00             (adybug/src/main.s):00203                 clr     LAST_FRAME
                      (adybug/src/main.s):00204         
                      (adybug/src/main.s):00205                 ; --- Enable Vbord ---
C0A3 8608             (adybug/src/main.s):00206                 lda     #%00001000
C0A5 B7FF92           (adybug/src/main.s):00207                 sta     GIME_IRQEN
C0A8 B6FF92           (adybug/src/main.s):00208                 lda     GIME_IRQEN
                      (adybug/src/main.s):00209         
C0AB 1CEF             (adybug/src/main.s):00210                 andcc   #%11101111      ; unmask IRQ
                      (adybug/src/main.s):00211         
                      (adybug/src/main.s):00212         ;==============================================================================
                      (adybug/src/main.s):00213         ; mainloop — sample input every Vbord; move two pixels every fourth Vbord.
                      (adybug/src/main.s):00214         ;==============================================================================
C0AD                  (adybug/src/main.s):00215         mainloop
C0AD 13               (adybug/src/main.s):00216                 sync
C0AE 9603             (adybug/src/main.s):00217                 lda     FRAMES+1
C0B0 9100             (adybug/src/main.s):00218                 cmpa    LAST_FRAME
C0B2 27F9             (adybug/src/main.s):00219                 beq     mainloop
C0B4 9700             (adybug/src/main.s):00220                 sta     LAST_FRAME
C0B6 170067           (adybug/src/main.s):00221                 lbsr    read_joystick
C0B9 9600             (adybug/src/main.s):00222                 lda     LAST_FRAME
C0BB 8403             (adybug/src/main.s):00223                 anda    #$03
C0BD 26EE             (adybug/src/main.s):00224                 bne     mainloop
C0BF                  (adybug/src/main.s):00225         phase4_before_tick
C0BF 1700CF           (adybug/src/main.s):00226                 lbsr    player_tick
C0C2 20E9             (adybug/src/main.s):00227                 bra     mainloop
                      (adybug/src/main.s):00228         
                      (adybug/src/main.s):00229         ;==============================================================================
                      (adybug/src/main.s):00230         ; init_maze_state — copy immutable maze cells to writable game-state RAM.
                      (adybug/src/main.s):00231         ;
                      (adybug/src/main.s):00232         ; Inputs:
                      (adybug/src/main.s):00233         ;   None
                      (adybug/src/main.s):00234         ;
                      (adybug/src/main.s):00235         ; Returns:
                      (adybug/src/main.s):00236         ;   X, Y, U, A, CC — undefined
                      (adybug/src/main.s):00237         ;
                      (adybug/src/main.s):00238         ; Side effects:
                      (adybug/src/main.s):00239         ;   Writes 576 bytes at MAZE_STATE.
                      (adybug/src/main.s):00240         ;==============================================================================
C0C4                  (adybug/src/main.s):00241         init_maze_state
C0C4 308D10E4         (adybug/src/main.s):00242                 leax    maze_cells,pcr
C0C8 108EA000         (adybug/src/main.s):00243                 ldy     #MAZE_STATE
C0CC                  (adybug/src/main.s):00244         ims_copy
C0CC A680             (adybug/src/main.s):00245                 lda     ,x+
C0CE A7A0             (adybug/src/main.s):00246                 sta     ,y+
C0D0 108CA240         (adybug/src/main.s):00247                 cmpy    #MAZE_STATE+576
C0D4 25F6             (adybug/src/main.s):00248                 blo     ims_copy
C0D6 39               (adybug/src/main.s):00249                 rts
                      (adybug/src/main.s):00250         
                      (adybug/src/main.s):00251         ;==============================================================================
                      (adybug/src/main.s):00252         ; init_joystick — configure the PIAs for right-joystick DAC conversion.
                      (adybug/src/main.s):00253         ;
                      (adybug/src/main.s):00254         ; Inputs:
                      (adybug/src/main.s):00255         ;   None
                      (adybug/src/main.s):00256         ;
                      (adybug/src/main.s):00257         ; Returns:
                      (adybug/src/main.s):00258         ;   A, CC — undefined
                      (adybug/src/main.s):00259         ;
                      (adybug/src/main.s):00260         ; Side effects:
                      (adybug/src/main.s):00261         ;   Configures PIA1 PA as input, PIA1 PB as output, PIA2 PA7-PA2 as DAC
                      (adybug/src/main.s):00262         ;   output, and selects/enables the right joystick analog multiplexer.
                      (adybug/src/main.s):00263         ;==============================================================================
C0D7                  (adybug/src/main.s):00264         init_joystick
C0D7 7FFF01           (adybug/src/main.s):00265                 clr     PIA1_CRA        ; select PIA1 PA direction register
C0DA 7FFF00           (adybug/src/main.s):00266                 clr     PIA1_DA         ; all PA bits input, including comparator PA7
C0DD 7FFF03           (adybug/src/main.s):00267                 clr     PIA1_CRB        ; select PIA1 PB direction register
C0E0 86FF             (adybug/src/main.s):00268                 lda     #$FF
C0E2 B7FF02           (adybug/src/main.s):00269                 sta     PIA1_DB         ; keyboard columns/output side
C0E5 8624             (adybug/src/main.s):00270                 lda     #$24            ; data register, CA2/CB2 output low
C0E7 B7FF01           (adybug/src/main.s):00271                 sta     PIA1_CRA
C0EA B7FF03           (adybug/src/main.s):00272                 sta     PIA1_CRB        ; selector 0 = right joystick X
                      (adybug/src/main.s):00273         
C0ED 7FFF21           (adybug/src/main.s):00274                 clr     PIA2_CRA        ; select PIA2 PA direction register
C0F0 86FC             (adybug/src/main.s):00275                 lda     #$FC
C0F2 B7FF20           (adybug/src/main.s):00276                 sta     PIA2_DA         ; PA7-PA2 are the six-bit DAC
C0F5 8604             (adybug/src/main.s):00277                 lda     #$04            ; data-register access
C0F7 B7FF21           (adybug/src/main.s):00278                 sta     PIA2_CRA
C0FA 7FFF23           (adybug/src/main.s):00279                 clr     PIA2_CRB
C0FD 8624             (adybug/src/main.s):00280                 lda     #$24            ; CB2 low enables analog multiplexer
C0FF B7FF23           (adybug/src/main.s):00281                 sta     PIA2_CRB
C102 8680             (adybug/src/main.s):00282                 lda     #$80            ; centre DAC while idle
C104 B7FF20           (adybug/src/main.s):00283                 sta     PIA2_DA
C107 39               (adybug/src/main.s):00284                 rts
                      (adybug/src/main.s):00285         
                      (adybug/src/main.s):00286         ;==============================================================================
                      (adybug/src/main.s):00287         ; init_player — initialize the player at maze cell (12,18).
                      (adybug/src/main.s):00288         ;
                      (adybug/src/main.s):00289         ; Inputs:
                      (adybug/src/main.s):00290         ;   None
                      (adybug/src/main.s):00291         ;
                      (adybug/src/main.s):00292         ; Returns:
                      (adybug/src/main.s):00293         ;   A, D, CC — undefined
                      (adybug/src/main.s):00294         ;
                      (adybug/src/main.s):00295         ; Side effects:
                      (adybug/src/main.s):00296         ;   Initializes direct-page player state.
