     032C             (audio_symbols.inc):00002         AUDIO_ENGINE_BYTES equ 812
     130D             (audio_symbols.inc):00003         AUDIO_RUNTIME_BYTES equ 4877
     003D             (audio_symbols.inc):00004         AUDIO_RUNTIME_PAGE equ $3D
     A000             (audio_symbols.inc):00005         AUDIO_RUNTIME_ADDRESS equ $A000
     A32C             (audio_symbols.inc):00006         AUDIO_INSTALL_EXEC equ $A32C
                      (ration/src/main.s):00168         
     0300             (ration/src/main.s):00169         AUDIO_ENGINE_EXEC   equ $0300
     0303             (ration/src/main.s):00170         AUDIO_INIT_EXEC     equ $0303
     0306             (ration/src/main.s):00171         AUDIO_ENQUEUE_EXEC  equ $0306
     00E4             (ration/src/main.s):00172         PRES_NAME_PTR       equ $00E4
                      (ration/src/main.s):00173         
     0000             (ration/src/main.s):00174         LAST_FRAME    equ $0000         ; last processed Vbord counter low byte
     0001             (ration/src/main.s):00175         JOY_X         equ $0001         ; right joystick X, 0..63
     0002             (ration/src/main.s):00176         FRAMES        equ $0002         ; u16 frame counter
     0004             (ration/src/main.s):00177         JOY_Y         equ $0004         ; right joystick Y, 0..63
     0005             (ration/src/main.s):00178         JOY_DIR       equ $0005         ; requested direction or $FF
     0006             (ration/src/main.s):00179         PLAYER_DIR    equ $0006         ; active direction or $FF
     0007             (ration/src/main.s):00180         PLAYER_FACE   equ $0007         ; last active direction, 0..3
     0008             (ration/src/main.s):00181         PLAYER_STEP   equ $0008         ; 2-pixel steps since last cell centre, 0..3
     0009             (ration/src/main.s):00182         PLAYER_CELL_X equ $0009         ; semantic maze column
     000A             (ration/src/main.s):00183         PLAYER_CELL_Y equ $000A         ; semantic maze row
     000B             (ration/src/main.s):00184         PLAYER_FB     equ $000B         ; u16 framebuffer pointer at sprite top-left
     000D             (ration/src/main.s):00185         JOY_DX        equ $000D         ; absolute X displacement from centre
     000E             (ration/src/main.s):00186         JOY_DY        equ $000E         ; absolute Y displacement from centre
     000F             (ration/src/main.s):00187         PLAYER_WANT   equ $000F         ; last non-neutral requested direction
     0010             (ration/src/main.s):00188         TEST_X        equ $0010         ; candidate/draw maze column
     0011             (ration/src/main.s):00189         TEST_Y        equ $0011         ; candidate/draw maze row
     0012             (ration/src/main.s):00190         TEST_DIR      equ $0012         ; direction under collision test
     0013             (ration/src/main.s):00191         GATE_ID       equ $0013         ; active gate index
     0014             (ration/src/main.s):00192         GATE_X        equ $0014         ; active gate pivot column
     0015             (ration/src/main.s):00193         GATE_Y        equ $0015         ; active gate pivot row
     0016             (ration/src/main.s):00194         DRAW_COUNT    equ $0016         ; gate redraw loop counter
     0017             (ration/src/main.s):00195         DRAW_TILE     equ $0017         ; tile ID for draw_cell_tile
     0018             (ration/src/main.s):00196         PLAYER_MANUAL equ $0018         ; nonzero after first directional input
     00A5             (ration/src/main.s):00197         PRES_MODE     equ $00A5         ; presentation dispatcher mode
     0004             (ration/src/main.s):00198         MODE_DEMO     equ 4              ; autonomous demo owns joystick direction
     0019             (ration/src/main.s):00199         GATE_ANIM_ID  equ $0019         ; rotating gate ID+1; zero when idle
     001A             (ration/src/main.s):00200         GATE_ANIM_STYLE equ $001A       ; 0=slash, 1=backslash
     001B             (ration/src/main.s):00201         BLIT_ROWS     equ $001B         ; transparent-blit row counter
     001C             (ration/src/main.s):00202         BLIT_WIDTH    equ $001C         ; transparent-blit bytes per row
     001D             (ration/src/main.s):00203         SCORE_BCD     equ $001D         ; packed BCD score, six digits
     0020             (ration/src/main.s):00204         HIGH_BCD      equ $0020         ; packed BCD session high score
     0023             (ration/src/main.s):00205         LIVES         equ $0023         ; lives remaining
     0024             (ration/src/main.s):00206         STAGE         equ $0024         ; current stage, 1..255
     0025             (ration/src/main.s):00207         DOTS_LEFT     equ $0025         ; remaining flowers in this stage
     0026             (ration/src/main.s):00208         STAGE_PENDING equ $0026         ; nonzero requests a stage transition
     0027             (ration/src/main.s):00209         HUD_X         equ $0027         ; HUD tile column scratch
     0028             (ration/src/main.s):00210         HUD_Y         equ $0028         ; HUD tile row scratch
     0029             (ration/src/main.s):00211         HUD_COLOR     equ $0029         ; palette index for digit rendering
     002A             (ration/src/main.s):00212         HUD_BYTE      equ $002A         ; packed BCD / mask scratch
