                      (adybug/src/main.s):03126         ; blit_tile — copy an 8x8 tile to a framebuffer byte address.
                      (adybug/src/main.s):03127         ;
                      (adybug/src/main.s):03128         ; Inputs:
                      (adybug/src/main.s):03129         ;   X — destination framebuffer byte address
