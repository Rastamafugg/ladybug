                      (adybug/src/main.s):01513         ; init_joystick — configure the PIAs for right-joystick DAC conversion.
                      (adybug/src/main.s):01514         ;
                      (adybug/src/main.s):01515         ; Inputs:
                      (adybug/src/main.s):01516         ;   None
                      (adybug/src/main.s):01517         ;
                      (adybug/src/main.s):01518         ; Returns:
                      (adybug/src/main.s):01519         ;   A, CC — undefined
                      (adybug/src/main.s):01520         ;
                      (adybug/src/main.s):01521         ; Side effects:
                      (adybug/src/main.s):01522         ;   Configures PIA1 PA as input, PIA1 PB as output, PIA2 PA7-PA2 as DAC
                      (adybug/src/main.s):01523         ;   output, and selects/enables the right joystick analog multiplexer.
                      (adybug/src/main.s):01524         ;==============================================================================
C8B3                  (adybug/src/main.s):01525         init_joystick
C8B3 7FFF01           (adybug/src/main.s):01526                 clr     PIA1_CRA        ; select PIA1 PA direction register
C8B6 7FFF00           (adybug/src/main.s):01527                 clr     PIA1_DA         ; all PA bits input, including comparator PA7
C8B9 7FFF03           (adybug/src/main.s):01528                 clr     PIA1_CRB        ; select PIA1 PB direction register
C8BC 86FF             (adybug/src/main.s):01529                 lda     #$FF
C8BE B7FF02           (adybug/src/main.s):01530                 sta     PIA1_DB         ; keyboard columns/output side
C8C1 8634             (adybug/src/main.s):01531                 lda     #$34            ; data register, static CA2/CB2 output low
C8C3 B7FF01           (adybug/src/main.s):01532                 sta     PIA1_CRA
C8C6 B7FF03           (adybug/src/main.s):01533                 sta     PIA1_CRB        ; selector 0 = right joystick X
                      (adybug/src/main.s):01534         
C8C9 7FFF21           (adybug/src/main.s):01535                 clr     PIA2_CRA        ; select PIA2 PA direction register
C8CC 86FC             (adybug/src/main.s):01536                 lda     #$FC
C8CE B7FF20           (adybug/src/main.s):01537                 sta     PIA2_DA         ; PA7-PA2 are the six-bit DAC
C8D1 8604             (adybug/src/main.s):01538                 lda     #$04            ; data-register access
C8D3 B7FF21           (adybug/src/main.s):01539                 sta     PIA2_CRA
C8D6 7FFF23           (adybug/src/main.s):01540                 clr     PIA2_CRB
C8D9 8634             (adybug/src/main.s):01541                 lda     #$34            ; static CB2 low enables analog multiplexer
C8DB B7FF23           (adybug/src/main.s):01542                 sta     PIA2_CRB
C8DE 8680             (adybug/src/main.s):01543                 lda     #$80            ; centre DAC while idle
C8E0 B7FF20           (adybug/src/main.s):01544                 sta     PIA2_DA
C8E3 39               (adybug/src/main.s):01545                 rts
