                      (adybug/src/main.s):03121         ; blit_tile — copy an 8x8 tile to a framebuffer byte address.
                      (adybug/src/main.s):03122         ;
                      (adybug/src/main.s):03123         ; Inputs:
                      (adybug/src/main.s):03124         ;   X — destination framebuffer byte address
                      (adybug/src/main.s):03125         ;   Y — source glyph data, 32 packed 4bpp bytes
                      (adybug/src/main.s):03126         ;
                      (adybug/src/main.s):03127         ; Returns:
                      (adybug/src/main.s):03128         ;   A, B, D, X, Y, U, CC — undefined
                      (adybug/src/main.s):03129         ;
                      (adybug/src/main.s):03130         ; Side effects:
                      (adybug/src/main.s):03131         ;   Writes 8 rows x 4 bytes; advances 156 bytes after each written row.
                      (adybug/src/main.s):03132         ;==============================================================================
D316                  (adybug/src/main.s):03133         blit_tile
                      (adybug/src/main.s):03134                 ; ldd ,y++ clobbers B, so use a Y-vs-sentinel loop instead of decb.
                      (adybug/src/main.s):03135                 ; See wiki/internal/implementation/lessons-learned.html
                      (adybug/src/main.s):03136                 ; §"LDD ,Y++ clobbers B".
