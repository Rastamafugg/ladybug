                      (adybug/src/main.s):00299                 ; --- Enter runtime from direct ROM or GMC-loaded RAM ---
                      (adybug/src/main.s):00300                 ; Direct fallback keeps TY=0. XRoar discards writes to the selected cartridge window,
                      (adybug/src/main.s):00301                 ; so the former same-address self-copy never populated phys $3E-$3F.
                      (adybug/src/main.s):00302                 ; PAR6=$3E keeps $C000-$DFFF cartridge-backed after MMU enable while
