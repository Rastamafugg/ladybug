                      (adybug/src/main.s):00270                 ; --- Enter runtime from direct ROM or GMC-loaded RAM ---
                      (adybug/src/main.s):00271                 ; Direct fallback keeps TY=0. XRoar discards writes to the selected cartridge window,
                      (adybug/src/main.s):00272                 ; so the former same-address self-copy never populated phys $3E-$3F.
                      (adybug/src/main.s):00273                 ; PAR6=$3E keeps $C000-$DFFF cartridge-backed after MMU enable while
                      (adybug/src/main.s):00274                 ; the framebuffer and writable state use ordinary RAM pages below $3C.
                      (adybug/src/main.s):00275         
                      (adybug/src/main.s):00276                 ; --- Force executive PAR set ($FFA0-$FFA7) to be active ---
C033 7FFF91           (adybug/src/main.s):00277                 clr     $FF91
                      (adybug/src/main.s):00278         
                      (adybug/src/main.s):00279                 ; --- Set up MMU PARs (executive set) ---
                      (adybug/src/main.s):00280                 ; PAR0 ($0000) = phys $38   low RAM (DP, stack)
                      (adybug/src/main.s):00281                 ; PAR1 ($2000) = phys $30   FB page 0
                      (adybug/src/main.s):00282                 ; PAR2 ($4000) = phys $31   FB page 1
                      (adybug/src/main.s):00283                 ; PAR3 ($6000) = phys $32   FB page 2
                      (adybug/src/main.s):00284                 ; PAR4 ($8000) = phys $33   FB page 3
                      (adybug/src/main.s):00285                 ; PAR5 ($A000) = phys $34   game state (Phase 4+)
                      (adybug/src/main.s):00286                 ; PAR6 ($C000) = phys $3E   cartridge code (current 8 K window)
                      (adybug/src/main.s):00287                 ; PAR7 ($E000) = phys $3F   cartridge/ROM window + IO + jump table
C036 308D1390         (adybug/src/main.s):00288                 leax    par_table,pcr
