                      (adybug/src/main.s):00001         ;==============================================================================
                      (adybug/src/main.s):00002         ; Ladybug — main.s
                      (adybug/src/main.s):00003         ;==============================================================================
                      (adybug/src/main.s):00004         ; Phase 4: joystick-driven Lady Bug movement over the authored screen.
                      (adybug/src/main.s):00005         ;
                      (adybug/src/main.s):00006         ; Builds on Phase 2.3 (hi-res 320×192×16 + MMU + palette + IRQ tick) by:
                      (adybug/src/main.s):00007         ;   - Compiling tiled/coco-screen.tmx into a one-byte tile map and a
                      (adybug/src/main.s):00008         ;     deduplicated packed 4bpp tile atlas before assembly.
                      (adybug/src/main.s):00009         ;   - Flattening visible Tiled layers and applying horizontal/vertical flips.
                      (adybug/src/main.s):00010         ;   - blit_tile: 8 rows x 4 bytes, stride 160.
                      (adybug/src/main.s):00011         ;   - Polling the right joystick through the PIA DAC/comparator path.
                      (adybug/src/main.s):00012         ;   - Transparent 16x16 player frames with background save/restore.
                      (adybug/src/main.s):00013         ;   - Semantic maze collision and dot removal.
                      (adybug/src/main.s):00014         ;
                      (adybug/src/main.s):00015         ; Visible: the authored screen with a moving, maze-constrained Lady Bug.
                      (adybug/src/main.s):00016         ;==============================================================================
                      (adybug/src/main.s):00017         
                      (adybug/src/main.s):00018                 pragma  nodollarlocal,6809
                      (adybug/src/main.s):00019         
                      (adybug/src/main.s):00020         ;------------------------------------------------------------------------------
                      (adybug/src/main.s):00021         ; DP allocation (page $00)
                      (adybug/src/main.s):00022         ;------------------------------------------------------------------------------
     00               (adybug/src/main.s):00023                 setdp   $00
                      (adybug/src/main.s):00024         
     0000             (adybug/src/main.s):00025         LAST_FRAME    equ $0000         ; last processed Vbord counter low byte
     0001             (adybug/src/main.s):00026         JOY_X         equ $0001         ; right joystick X, 0..63
     0002             (adybug/src/main.s):00027         FRAMES        equ $0002         ; u16 frame counter
     0004             (adybug/src/main.s):00028         JOY_Y         equ $0004         ; right joystick Y, 0..63
     0005             (adybug/src/main.s):00029         JOY_DIR       equ $0005         ; requested direction or $FF
     0006             (adybug/src/main.s):00030         PLAYER_DIR    equ $0006         ; active direction or $FF
     0007             (adybug/src/main.s):00031         PLAYER_FACE   equ $0007         ; last active direction, 0..3
     0008             (adybug/src/main.s):00032         PLAYER_STEP   equ $0008         ; 2-pixel steps since last cell centre, 0..3
     0009             (adybug/src/main.s):00033         PLAYER_CELL_X equ $0009         ; semantic maze column
     000A             (adybug/src/main.s):00034         PLAYER_CELL_Y equ $000A         ; semantic maze row
     000B             (adybug/src/main.s):00035         PLAYER_FB     equ $000B         ; u16 framebuffer pointer at sprite top-left
     000D             (adybug/src/main.s):00036         JOY_DX        equ $000D         ; absolute X displacement from centre
     000E             (adybug/src/main.s):00037         JOY_DY        equ $000E         ; absolute Y displacement from centre
     000F             (adybug/src/main.s):00038         PLAYER_WANT   equ $000F         ; last non-neutral requested direction
     0010             (adybug/src/main.s):00039         TEST_X        equ $0010         ; candidate/draw maze column
     0011             (adybug/src/main.s):00040         TEST_Y        equ $0011         ; candidate/draw maze row
     0012             (adybug/src/main.s):00041         TEST_DIR      equ $0012         ; direction under collision test
     0013             (adybug/src/main.s):00042         GATE_ID       equ $0013         ; active gate index
     0014             (adybug/src/main.s):00043         GATE_X        equ $0014         ; active gate pivot column
     0015             (adybug/src/main.s):00044         GATE_Y        equ $0015         ; active gate pivot row
     0016             (adybug/src/main.s):00045         DRAW_COUNT    equ $0016         ; gate redraw loop counter
