                      (adybug/src/main.s):00251                 org     $C000
                      (adybug/src/main.s):00252         
C000 444B             (adybug/src/main.s):00253                 fcc     "DK"            ; ROM-pack autostart magic; FIRQ -> $C002
                      (adybug/src/main.s):00254         
                      (adybug/src/main.s):00255         ;==============================================================================
                      (adybug/src/main.s):00256         ; entry
                      (adybug/src/main.s):00257         ;==============================================================================
C002 1A50             (adybug/src/main.s):00258         entry   orcc    #$50            ; mask IRQ + FIRQ
C004 10CE1FFE         (adybug/src/main.s):00259                 lds     #$1FFE          ; stack at top of low RAM page
                      (adybug/src/main.s):00260         
C008 4F               (adybug/src/main.s):00261                 clra                    ; DP = $00, shared with bank-3 runtime
C009 1F8B             (adybug/src/main.s):00262                 tfr     a,dp
