                      (adybug/src/main.s):03591         ;   Y — packed 4bpp source data; colour 0 is transparent
                      (adybug/src/main.s):03592         ;
                      (adybug/src/main.s):03593         ; Returns: A, B, X, Y, CC undefined
                      (adybug/src/main.s):03594         ; Side effects: blends the requested rectangle into the framebuffer.
                      (adybug/src/main.s):03595         ;==============================================================================
