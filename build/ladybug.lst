                      (adybug/src/main.s):03305         ; blit_tile — copy an 8x8 tile to a framebuffer byte address.
                      (adybug/src/main.s):03306         ;
                      (adybug/src/main.s):03307         ; Inputs:
                      (adybug/src/main.s):03308         ;   X — destination framebuffer byte address
                      (adybug/src/main.s):03309         ;   Y — source glyph data, 32 packed 4bpp bytes
                      (adybug/src/main.s):03310         ;
                      (adybug/src/main.s):03311         ; Returns:
                      (adybug/src/main.s):03312         ;   A, B, D, X, Y, U, CC — undefined
                      (adybug/src/main.s):03313         ;
                      (adybug/src/main.s):03314         ; Side effects:
                      (adybug/src/main.s):03315         ;   Writes 8 rows x 4 bytes; advances 156 bytes after each written row.
                      (adybug/src/main.s):03316         ;==============================================================================
D377                  (adybug/src/main.s):03317         blit_tile
