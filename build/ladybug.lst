                      (adybug/src/main.s):01609         ; init_joystick — configure the PIAs for right-joystick DAC conversion.
                      (adybug/src/main.s):01610         ;
                      (adybug/src/main.s):01611         ; Inputs:
                      (adybug/src/main.s):01612         ;   None
                      (adybug/src/main.s):01613         ;
                      (adybug/src/main.s):01614         ; Returns:
                      (adybug/src/main.s):01615         ;   A, CC — undefined
                      (adybug/src/main.s):01616         ;
                      (adybug/src/main.s):01617         ; Side effects:
                      (adybug/src/main.s):01618         ;   Configures PIA1 PA as input, PIA1 PB as output, PIA2 PA7-PA2 as DAC
                      (adybug/src/main.s):01619         ;   output, and selects/enables the right joystick analog multiplexer.
                      (adybug/src/main.s):01620         ;==============================================================================
C906                  (adybug/src/main.s):01621         init_joystick
C906 7FFF01           (adybug/src/main.s):01622                 clr     PIA1_CRA        ; select PIA1 PA direction register
C909 7FFF00           (adybug/src/main.s):01623                 clr     PIA1_DA         ; all PA bits input, including comparator PA7
C90C 7FFF03           (adybug/src/main.s):01624                 clr     PIA1_CRB        ; select PIA1 PB direction register
C90F 86FF             (adybug/src/main.s):01625                 lda     #$FF
C911 B7FF02           (adybug/src/main.s):01626                 sta     PIA1_DB         ; keyboard columns/output side
C914 8634             (adybug/src/main.s):01627                 lda     #$34            ; data register, static CA2/CB2 output low
C916 B7FF01           (adybug/src/main.s):01628                 sta     PIA1_CRA
