                      (adybug/src/main.s):00281                 ; --- Enter runtime from direct ROM or GMC-loaded RAM ---
                      (adybug/src/main.s):00282                 ; Direct fallback keeps TY=0. XRoar discards writes to the selected cartridge window,
                      (adybug/src/main.s):00283                 ; so the former same-address self-copy never populated phys $3E-$3F.
                      (adybug/src/main.s):00284                 ; PAR6=$3E keeps $C000-$DFFF cartridge-backed after MMU enable while
                      (adybug/src/main.s):00285                 ; the framebuffer and writable state use ordinary RAM pages below $3C.
                      (adybug/src/main.s):00286         
