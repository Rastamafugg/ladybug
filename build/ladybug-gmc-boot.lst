                      (c/gmc_bootstrap.s):00001         ; Ladybug GMC bank loader. Bank 0 executes here, then this routine runs from
                      (c/gmc_bootstrap.s):00002         ; low RAM while selecting bank 1 and copying the runtime into physical RAM.
                      (c/gmc_bootstrap.s):00003         ; DOC-002 source-contract mirror begins. Canonical definitions:
                      (c/gmc_bootstrap.s):00004         ; wiki/internal/implementation/routine-catalog.html
                      (c/gmc_bootstrap.s):00005         ; DOC-002 source-contract mirror profile boot Inputs: The declared cartridge bank, staged payload, destination identity, and bootstrap mapping state
                      (c/gmc_bootstrap.s):00006         ; DOC-002 source-contract mirror profile boot Outputs: Installed runtime bytes or a non-returning transfer to the next boot phase
                      (c/gmc_bootstrap.s):00007         ; DOC-002 source-contract mirror profile boot Clobbers: All CPU registers and condition codes
                      (c/gmc_bootstrap.s):00008         ; DOC-002 source-contract mirror profile boot Reads: Cartridge-staged payloads, generated size symbols, and bootstrap tables
                      (c/gmc_bootstrap.s):00009         ; DOC-002 source-contract mirror profile boot Writes: Declared RAM destinations, PAR registers, boot scratch, and decompressed surfaces
                      (c/gmc_bootstrap.s):00010         ; DOC-002 source-contract mirror profile boot Side effects: Changes MMU mappings and copies or synthesizes executable/data payloads
                      (c/gmc_bootstrap.s):00011         ; DOC-002 source-contract mirror profile boot Invariants: Authored, staged, and destination byte identities remain distinct and every transfer obeys its generated size bound
                      (c/gmc_bootstrap.s):00012         ; DOC-002 source-contract mirror contract boot_entry profile=boot: Establish bootstrap mappings and transfer control into the low-RAM loader.
                      (c/gmc_bootstrap.s):00013         ; DOC-002 source-contract mirror contract decompress_attract_surfaces profile=boot: Decompress attract surfaces.
                      (c/gmc_bootstrap.s):00014         ; DOC-002 source-contract mirror contract spr_byte_changed profile=boot: Test whether synthesis changed the current perimeter-reset output byte.
                      (c/gmc_bootstrap.s):00015         ; DOC-002 source-contract mirror contract synthesize_perimeter_reset profile=boot: Synthesize perimeter reset.
                      (c/gmc_bootstrap.s):00016         ; DOC-002 source-contract mirror ends.
                      (c/gmc_bootstrap.s):00017         
