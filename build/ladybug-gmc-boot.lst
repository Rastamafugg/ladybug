                      (c/gmc_bootstrap.s):00001         ; Ladybug GMC bank loader. Bank 0 executes here, then this routine runs from
                      (c/gmc_bootstrap.s):00002         ; low RAM while selecting bank 1 and copying the runtime into physical RAM.
                      (c/gmc_bootstrap.s):00003         
